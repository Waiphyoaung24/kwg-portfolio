---
import Layout from '@layouts/Layout.astro';
import { entries } from '../catalog/entries';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const entry = entries.find((e) => e.slug === slug);
if (!entry) throw new Error(`Unknown catalog entry: ${slug}`);

// Every file under src/catalog/<slug>/, read verbatim at build time so the
// page shows exactly what ships. `?raw` bypasses the GLSL plugin on purpose.
const raw = import.meta.glob('/src/catalog/*/**', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const PREVIEW_LINES = 12;
const prefix = `/src/catalog/${slug}/`;
const files = Object.entries(raw)
  .filter(([path]) => path.startsWith(prefix))
  .map(([path, code]) => ({
    path: path.slice(prefix.length),
    code,
    bytes: new TextEncoder().encode(code).length,
    // Only the head of the file is shown; Copy carries the whole thing.
    preview: code.split('\n').slice(0, PREVIEW_LINES).join('\n'),
    lines: code.split('\n').length,
  }))
  .sort((a, b) => a.path.localeCompare(b.path));

const pad = (n: number) => String(n).padStart(2, '0');
const index = pad(entries.indexOf(entry) + 1);

// The two aggregate clipboard payloads behind [ Copy for AI ]. Per-file copy
// lives next to each file, so the menu only carries what spans all of them.
const allSource = files
  .map((file) => `// ${prefix}${file.path}\n\n${file.code}`)
  .join('\n\n');

const prompt = [
  `${entry.title} — ${entry.kind.toLowerCase()} from the KWG catalog.`,
  '',
  entry.description,
  '',
  `Stack: ${entry.stack}`,
  `Credit: ${entry.credit.name} (${entry.credit.url})`,
  `Source: ${entry.source}`,
  `License: ${entry.license}`,
  '',
  `All ${files.length} file(s), verbatim:`,
  '',
  allSource,
].join('\n');
---

<Layout>
  <main>
    <div class="container">
      <!-- Primary layer: what this is. -->
      <header class="masthead">
        <a class="label back" href="/catalog">← Catalog</a>
        <p class="label">{index} · {entry.kind}</p>
        <h1>{entry.title}</h1>
      </header>

      <!-- Secondary layer: how you look at it, and how you take it. -->
      <div class="toolbar">
        <div class="tabs" role="tablist" aria-label="View">
          <button
            type="button"
            class="tab"
            role="tab"
            id="tab-preview"
            aria-controls="panel-preview"
            aria-selected="true"
            data-view-tab="preview"
          >
            Preview
          </button>
          <button
            type="button"
            class="tab"
            role="tab"
            id="tab-code"
            aria-controls="panel-code"
            aria-selected="false"
            data-view-tab="code"
          >
            Code
          </button>
        </div>

        <details class="menu">
          <summary class="pill-btn">Copy for AI</summary>
          <div class="menu-list">
            <button type="button" class="menu-item" data-copy={prompt}>
              Copy prompt
            </button>
            <button type="button" class="menu-item" data-copy={allSource}>
              Copy all source
            </button>
          </div>
        </details>
      </div>

      <!-- The demo and the source share one frame, so switching never jumps.
           The demo stays mounted: unmounting would drop its WebGL context. -->
      <div class="panel" data-view="preview">
        <section
          class="stage"
          id="panel-preview"
          role="tabpanel"
          aria-labelledby="tab-preview"
        >
          <slot />
        </section>

        <section
          class="files"
          id="panel-code"
          role="tabpanel"
          aria-labelledby="tab-code"
        >
          <p class="label files-head">
            {pad(files.length)} files · src/catalog/{slug}/
          </p>
          {
            files.map((file) => (
              <article class="file">
                <header>
                  <span class="path">{file.path}</span>
                  <span class="label">
                    {file.lines} lines · {file.bytes} B
                  </span>
                  <button
                    type="button"
                    class="pill-btn copy-file"
                    data-copy={file.code}
                  >
                    Copy
                  </button>
                </header>
                <pre>
                  <code>{file.preview}</code>
                </pre>
                {file.lines > PREVIEW_LINES && (
                  <p class="label more">
                    … {file.lines - PREVIEW_LINES} more lines in the copy
                  </p>
                )}
              </article>
            ))
          }
        </section>
      </div>

      <!-- Tertiary layer: provenance. -->
      <section class="meta">
        <p class="lede">{entry.description}</p>
        <dl>
          <dt class="label">Stack</dt>
          <dd>{entry.stack}</dd>
          <dt class="label">Credit</dt>
          <dd>
            <a href={entry.credit.url} target="_blank" rel="noopener">
              {entry.credit.name}
            </a>
          </dd>
          <dt class="label">Source</dt>
          <dd>
            <a href={entry.source} target="_blank" rel="noopener">
              {entry.source.startsWith('/') ? 'Live page' : 'Article'}
            </a>
          </dd>
          <dt class="label">License</dt>
          <dd>{entry.license}</dd>
        </dl>
      </section>
    </div>
  </main>
</Layout>

<script>
  const panel = document.querySelector<HTMLElement>('.panel');
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-view-tab]'),
  );

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const view = tab.dataset.viewTab ?? 'preview';
      if (panel) panel.dataset.view = view;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    });
  });

  // <details> handles open/close and Escape; it just doesn't close on an
  // outside click.
  document.addEventListener('click', (event) => {
    document
      .querySelectorAll<HTMLDetailsElement>('details.menu[open]')
      .forEach((menu) => {
        if (!menu.contains(event.target as Node)) menu.open = false;
      });
  });

  document
    .querySelectorAll<HTMLButtonElement>('[data-copy]')
    .forEach((button) => {
      const label = button.textContent;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Error';
        }
        button.closest('details')?.removeAttribute('open');
        setTimeout(() => (button.textContent = label), 1500);
      });
    });
</script>

<style lang="scss">
  main {
    padding-block: var(--sp-4xl) var(--sp-band);
  }

  .masthead {
    display: grid;
    gap: var(--sp-lg);
    max-width: 64ch;
    margin-bottom: var(--sp-3xl);
  }

  .back {
    justify-self: start;
    color: var(--c-mute);
    text-decoration: none;
    transition: color 0.25s var(--ease-smooth);

    @include has-hover {
      &:hover {
        color: var(--c-ink);
      }
    }
  }

  h1 {
    font-size: var(--fs-3);
  }

  // -- Toolbar ---------------------------------------------------------------

  .toolbar {
    display: flex;
    align-items: flex-end;
    gap: var(--sp-xl);
    margin-bottom: -1px; // the active rule sits on the panel border
  }

  .tabs {
    display: flex;
    gap: var(--sp-xl);
  }

  .tab {
    min-height: to-rem(44);
    padding: var(--sp-md) 0;
    border-bottom: 1px solid transparent;
    font-family: var(--ff-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--c-mute);
    transition:
      color 0.25s var(--ease-smooth),
      border-color 0.25s var(--ease-smooth);

    @include has-hover {
      &:hover {
        color: var(--c-body);
      }
    }

    // The selected tab is marked by the white rule and full-strength ink,
    // never by colour alone.
    &[aria-selected='true'] {
      color: var(--c-ink);
      border-bottom-color: var(--c-ink);
    }
  }

  .menu {
    position: relative;
    margin-left: auto;

    summary {
      list-style: none;
      cursor: pointer;

      &::-webkit-details-marker {
        display: none;
      }
    }
  }

  .menu-list {
    position: absolute;
    top: calc(100% + var(--sp-sm));
    right: 0;
    z-index: 2;
    display: grid;
    min-width: to-rem(240);
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-sm);
    background: var(--c-canvas-card);
    overflow: hidden;
  }

  .menu-item {
    min-height: to-rem(44);
    padding: var(--sp-md) var(--sp-lg);
    font-size: var(--fs-body-sm);
    text-align: left;
    color: var(--c-body);
    transition:
      color 0.25s var(--ease-smooth),
      background-color 0.25s var(--ease-smooth);

    & + & {
      border-top: 1px solid var(--c-hairline);
    }

    @include has-hover {
      &:hover {
        color: var(--c-ink);
        background-color: rgba(255, 255, 255, 0.06);
      }
    }
  }

  // -- Panel -----------------------------------------------------------------

  .panel {
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-sm);
  }

  .stage {
    display: grid;
    place-items: center;
    min-height: 70svh;
    padding: var(--sp-xl);
  }

  .files {
    display: grid;
    gap: var(--sp-3xl);
    max-height: 80svh;
    padding: var(--sp-xl);
    overflow-y: auto;
  }

  .panel[data-view='preview'] .files,
  .panel[data-view='code'] .stage {
    display: none;
  }

  .files-head {
    padding-bottom: var(--sp-md);
    border-bottom: 1px solid var(--c-hairline);
    color: var(--c-mute);
  }

  .file header {
    display: flex;
    align-items: center;
    gap: var(--sp-lg);
    padding-bottom: var(--sp-sm);
  }

  .path {
    font-family: var(--ff-mono);
    font-size: var(--fs-body-sm);
    color: var(--c-body);
  }

  .file .label {
    color: var(--c-mute);
  }

  .copy-file {
    margin-left: auto;
    // Tighter than the page-level pill: it sits inside a file row.
    padding: var(--sp-xs) var(--sp-md);
    font-size: var(--fs-micro);
  }

  pre {
    padding: var(--sp-lg) 0;
    border-top: 1px solid var(--c-hairline);
    font-family: var(--ff-mono);
    font-size: var(--fs-micro);
    line-height: 1.6;
    color: var(--c-body);
    overflow-x: auto;
    tab-size: 2;
  }

  .more {
    padding-top: var(--sp-sm);
    color: var(--c-mute);
  }

  // -- Meta ------------------------------------------------------------------

  .meta {
    max-width: 64ch;
    margin-top: var(--sp-3xl);
  }

  .lede {
    color: var(--c-body);
  }

  dl {
    display: grid;
    grid-template-columns: 10ch 1fr;
    gap: var(--sp-sm) var(--sp-xl);
    margin-top: var(--sp-xl);
    font-size: var(--fs-body-sm);
  }

  dt {
    color: var(--c-mute);
  }

  dd a {
    color: var(--c-body);
    text-underline-offset: 0.25em;
    text-decoration-color: var(--c-canvas-mid);
    transition:
      color 0.25s var(--ease-smooth),
      text-decoration-color 0.25s var(--ease-smooth);

    @include has-hover {
      &:hover {
        color: var(--c-ink);
        text-decoration-color: currentColor;
      }
    }
  }
</style>
