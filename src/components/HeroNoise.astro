---
// HERO NOISE — a granular dot field under the hero type. Static dots joined
// by hairlines where they sit close; the pointer brightens the dots and lines
// it passes over. 2D canvas, no WebGL, no framework: this replaced the
// ShaderGradient sphere and took the React runtime out with it.
---

<canvas class="heronoise" data-heronoise aria-hidden="true"></canvas>

<script>
  // tune: lower the divisor to add more dots
  const DENSITY = 1 / 120;
  // tune: raise to permit more dots on large canvases
  const MAX_DOTS = 6000;
  // tune: raise to widen pointer influence
  const RADIUS = 200;
  // tune: raise to connect dots across larger gaps
  const NEIGHBOUR_D = 35;
  const BASE_A = 0.4;
  const PEAK_A = 0.9;

  type Dot = { x: number; y: number; b: number };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-heronoise]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    // Ink token, not a hex: alpha goes through globalAlpha so the token stays
    // the single source of the dot colour.
    const ink = getComputedStyle(canvas).getPropertyValue('--c-ink').trim();
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let dots: Dot[] = [];
    let pairs: [Dot, Dot][] = [];
    let mouse: { x: number; y: number } | null = null;
    let cw = 0;
    let ch = 0;
    let animId = 0;

    function build() {
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas!.getBoundingClientRect();
      cw = rect.width;
      ch = rect.height;
      if (!cw || !ch) return;
      canvas!.width = Math.round(cw * dpr);
      canvas!.height = Math.round(ch * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(Math.round(cw * ch * DENSITY), MAX_DOTS);
      dots = Array.from({ length: count }, () => ({
        x: Math.random() * cw,
        y: Math.random() * ch,
        b: 0,
      }));

      // ponytail: O(n²) pair scan, runs once per resize on ≤6000 dots (~18M
      // checks). Grid-bucket it if MAX_DOTS climbs.
      const nd2 = NEIGHBOUR_D * NEIGHBOUR_D;
      pairs = [];
      for (let i = 0; i < dots.length; i++) {
        for (let j = i + 1; j < dots.length; j++) {
          const dx = dots[i].x - dots[j].x;
          const dy = dots[i].y - dots[j].y;
          if (dx * dx + dy * dy < nd2) pairs.push([dots[i], dots[j]]);
        }
      }
      draw();
    }

    // Returns whether anything is still settling, so the loop can stop when
    // the pointer has left and every dot has faded back.
    function draw() {
      ctx!.clearRect(0, 0, cw, ch);
      const mx = mouse?.x ?? -99999;
      const my = mouse?.y ?? -99999;
      const r2 = RADIUS * RADIUS;
      let live = false;

      ctx!.fillStyle = ink;
      for (const d of dots) {
        const dx = d.x - mx;
        const dy = d.y - my;
        const dist2 = dx * dx + dy * dy;
        const tgt = dist2 < r2 ? Math.exp(-dist2 / (r2 * 0.25)) : 0;

        d.b += (tgt > d.b ? 0.16 : 0.07) * (tgt - d.b);
        if (d.b < 0.004) d.b = 0;
        if (d.b) live = true;

        const sz = 1.2 + d.b * 0.8;
        ctx!.globalAlpha = BASE_A + (PEAK_A - BASE_A) * d.b;
        ctx!.fillRect(d.x - sz / 2, d.y - sz / 2, sz, sz);
      }

      ctx!.strokeStyle = ink;
      ctx!.lineWidth = 0.5;
      for (const [a, b] of pairs) {
        if (a.b < 0.05 || b.b < 0.05) continue;
        ctx!.globalAlpha = Math.min(a.b, b.b) * 0.35;
        ctx!.beginPath();
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
        ctx!.stroke();
      }
      ctx!.globalAlpha = 1;
      return live;
    }

    function frame() {
      animId = draw() || mouse ? requestAnimationFrame(frame) : 0;
    }

    function wake() {
      if (!animId) animId = requestAnimationFrame(frame);
    }

    new ResizeObserver(build).observe(canvas.parentElement!);

    // The canvas sits behind the hero copy, so the pointer is read off the
    // window and mapped into canvas space; a canvas listener would never fire.
    // Reduced motion keeps the field and drops the pointer response.
    if (!still) {
      window.addEventListener('pointermove', (e) => {
        const rect = canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        mouse = x >= 0 && y >= 0 && x <= rect.width && y <= rect.height ? { x, y } : null;
        wake();
      });
      window.addEventListener('pointerleave', () => (mouse = null));
    }
  }
</script>

<style lang="scss">
  .heronoise {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
