<section class="replay" aria-labelledby="replay-title">
  <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
    <h2 class="card-title mb-0" id="replay-title">Watch a paper trade</h2>
    <span class="badge bg-green-lt text-uppercase">Synthetic replay, no orders</span>
  </div>
  <p class="text-secondary mt-2 mb-3">Play saved artificial candles to see a signal, entry and exit in about 25 seconds.</p>
  <div class="row g-4 py-3 border-top border-bottom">
    <figure class="col-lg-7 m-0">
      <div class="subheader">Simulated gold price</div>
      <output class="h2 d-block font-monospace mb-2" id="replay-price">—</output>
      <p class="visually-hidden" id="replay-chart-title">Saved synthetic closing prices</p>
      <div id="replay-chart" aria-hidden="true"></div>
      <figcaption class="text-secondary small"><span id="replay-progress">Candle 1 of 26</span>. Each candle represents 15 minutes.</figcaption>
    </figure>
    <div class="col-lg-5">
      <h3 class="h3" id="replay-state" role="status">Waiting for a signal</h3>
      <ol class="text-secondary ps-3" id="replay-events"><li>Watching completed M15 candles.</li></ol>
      <div class="subheader mt-3">Simulated net result</div>
      <output class="h2 d-block font-monospace" id="replay-result">—</output>
    </div>
  </div>
  <div class="btn-list mt-3">
    <button type="button" class="btn btn-primary" id="replay-play">Play replay</button>
    <button type="button" class="btn desk-btn" id="replay-step">Next candle</button>
    <button type="button" class="btn desk-btn" id="replay-reset">Reset replay</button>
  </div>
  <p class="text-secondary small mt-3 mb-0">Illustrative target exit from the saved baseline simulation, with assumed costs. This is not your account, a live signal or evidence of profitability.</p>
</section>

<script>
  import fixture from '../data/trading-replay.json';
  import ApexCharts from 'apexcharts/core';
  import 'apexcharts/line';
  import 'apexcharts/features/annotations';
  import { replayFrame } from '../scripts/trading-replay.mjs';
  const el = (id: string) => document.getElementById(id)!;
  const play = el('replay-play') as HTMLButtonElement;
  const step = el('replay-step') as HTMLButtonElement;
  let index = 0;
  const closes = fixture.bars.map((bar: { close: number }) => bar.close);
  const xaxis = { type: 'numeric' as const, min: 1, max: fixture.bars.length, tickAmount: 5, labels: { formatter: (v: string) => `${Math.round(Number(v))}` } };
  const chart = new ApexCharts(el('replay-chart'), {
    chart: { type: 'line', height: 220, background: 'transparent', fontFamily: 'inherit', toolbar: { show: false }, zoom: { enabled: false }, animations: { enabled: false }, parentHeightOffset: 0 },
    theme: { mode: 'light' }, colors: ['#0f7a45'], stroke: { width: 2, curve: 'straight' },
    grid: { strokeDashArray: 4, borderColor: '#d5eadc' }, dataLabels: { enabled: false }, legend: { show: false },
    markers: { size: 0 }, tooltip: { enabled: false },
    xaxis,
    // Fixed range across the whole replay so the line does not rescale each candle.
    yaxis: { min: Math.min(...closes) - 1, max: Math.max(...closes) + 1, labels: { formatter: (v: number) => v.toFixed(0) } },
    series: [{ name: 'Close', data: [] }],
  });
  void chart.render();
  let timer: ReturnType<typeof setInterval> | undefined;
  function pause() {
    clearInterval(timer);
    timer = undefined;
    play.textContent = index === fixture.bars.length - 1 ? 'Replay again' : 'Play replay';
    step.disabled = index === fixture.bars.length - 1;
  }
  function render() {
    const frame = replayFrame(fixture, index);
    el('replay-price').textContent = frame.price;
    el('replay-progress').textContent = frame.progress;
    el('replay-result').textContent = frame.result;
    el('replay-state').textContent = frame.state;
    el('replay-events').replaceChildren(...frame.events.map((text: string) => {
      const item = document.createElement('li'); item.textContent = text; return item;
    }));
    const prices: number[] = frame.bars.map((bar: { close: number }) => bar.close);
    const data = prices.map((price, i) => [i + 1, price]);
    // Re-send the fixed x range: a series update otherwise shrinks the axis to the visible candles.
    void chart.updateOptions({ series: [{ name: 'Close', data }], xaxis, annotations: { points: [{ x: data.length, y: prices.at(-1), marker: { size: 5, fillColor: '#0f7a45', strokeColor: '#ffffff' } }] } }, false, false);
    el('replay-chart-title').textContent = `${frame.progress}. Synthetic closing price ${frame.price}. ${frame.state}.`;
  }
  function advance() {
    index = Math.min(index + 1, fixture.bars.length - 1);
    render();
    if (index === fixture.bars.length - 1) pause();
  }
  play.addEventListener('click', () => {
    if (timer) { pause(); return; }
    if (index === fixture.bars.length - 1) { index = 0; render(); }
    play.textContent = 'Pause replay';
    step.disabled = true;
    timer = setInterval(advance, 1000);
  });
  step.addEventListener('click', () => { pause(); advance(); });
  el('replay-reset').addEventListener('click', () => { index = 0; pause(); render(); });
  document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); });
  render();
</script>
