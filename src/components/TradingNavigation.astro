---
// Shared header for the trading desk pages; styles live in src/styles/desk.scss.
interface Props { current: 'overview' | 'demo' }
const { current } = Astro.props;
const logo = '<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M26.2636 20.4752L29.7034 6.2832H22.8238L26.2636 20.4752ZM12.2636 6.2832L17.0473 26.0199H23.9568L19.1731 6.2832H12.2636ZM8.61287 6.28336L1.70337 6.28373L6.48706 26.0203L13.3966 26.02L8.61287 6.28336Z" /></svg>';
---
<a class="visually-hidden-focusable btn btn-primary desk-skip" href="#trading-content">Skip to content</a>
<header class="desk-nav">
  <div class="container-xl d-flex align-items-center justify-content-between gap-3">
    <a class="desk-brand" href="/vault"><span class="desk-logo" set:html={logo} />Vault</a>
    <nav class="desk-nav__links" aria-label="Demo operations navigation">
      <a href="/vault/trading-bot" aria-current={current === 'overview' ? 'page' : undefined}>Overview</a>
      <a href="/vault/trading" aria-current={current === 'demo' ? 'page' : undefined}>Supervised demo</a>
    </nav>
  </div>
</header>
