<script>
  import type { PlaneParams } from 'curtainsjs';

  import { Curtains, Plane } from 'curtainsjs';

  import { lenis } from '../scripts/scroll';
  import vertexShader from '../shader/vertex.glsl';
  import fragmentShader from '../shader/fragment.glsl';

  window.addEventListener('load', () => {
    const planes = [];

    const curtains = new Curtains({
      container: document.querySelector('[data-js="canvas"]') || undefined,
      pixelRatio: Math.min(2, window.devicePixelRatio),
      watchScroll: false,
    });

    curtains
      .onError(() => {
        document.body.classList.add('no-curtains');
        // onError fires asynchronously, after window.__curtains below has
        // already published a live-looking instance. Null it back out so
        // every consumer's `if (!window.__curtains) return` guard is real
        // rather than dead code against an object whose gl context is null.
        window.__curtains = null;
      })
      .onContextLost(() => {
        // Between loss and a successful restore — permanently, if restore
        // fails — nothing is drawing. Drop the published context and hand
        // every planed slide back its <img>, the same fallback a visitor
        // gets from onError or reduced motion.
        window.__curtains = null;
        document
          .querySelectorAll<HTMLElement>('[data-carousel-plane]')
          .forEach((el) => el.classList.remove('is-planed'));
        curtains.restoreContext();
      });

    // Published so the carousel plane layer can attach to the same context
    // rather than standing up a second WebGL canvas. Stays null if the
    // context never came up, which is the same signal as .no-curtains.
    window.__curtains = curtains;
    // The plane layer (works.astro) needs this context but Astro does not
    // guarantee whether this component's `load` handler or works.astro's
    // runs first — component scripts are hoisted and bundled, so registration
    // order is not registration order. An explicit signal replaces that
    // assumption: works.astro checks window.__curtains directly and falls
    // back to listening for this event, so either order is handled.
    window.dispatchEvent(new Event('curtains:ready'));

    const planeElements = document.querySelectorAll('[data-canvas]');

    const params: PlaneParams = {
      vertexShader,
      fragmentShader,
      widthSegments: 100,
      heightSegments: 100,
      transparent: true,
      uniforms: {
        time: {
          name: 'uTime',
          type: '1f',
          value: 0.0,
        },
      },
    };

    planeElements.forEach((planeElement) => {
      const plane = new Plane(curtains, planeElement, params);
      planes.push(plane);

      plane.onRender(() => {
        plane.uniforms.time.value = (plane.uniforms.time.value as number) + 1;
      });
    });

    // TODO: pause rendering when not scrolling?
    // TODO: don't update planes when not in view?

    lenis.on('scroll', () => {
      curtains.updateScrollValues(window.scrollX, window.scrollY);
    });
  });
</script>

<div class="canvas" data-js="canvas"></div>

<style lang="scss">
  .canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
</style>
