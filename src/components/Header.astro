---
// Nav bar in the x.ai language: near-black canvas, hairline-outlined pill
// rail, and the one filled white pill marking the current page. The previous
// gold sweep-circle animation (and the gsap it needed) is gone — the system
// puts its emphasis in shape and contrast, not in motion.
import { nav } from '../data/nav';

// The mark already links home, so the rail drops Home. The Footer keeps it.
const items = nav.filter((item) => item.href !== '/');

// /catalog/kage lights up Catalog, so a section stays marked from its children.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

// Same address as the Footer and hero: the one door on every public page.
const email = 'nexuslab.dev.mm@gmail.com';
---

<!-- Displacement map for the glass backdrop; referenced by filter: url(#nav-glass). -->
<svg width="0" height="0" aria-hidden="true" style="position:absolute">
  <filter id="nav-glass" x="0" y="0" width="100%" height="100%">
    <feTurbulence type="fractalNoise" baseFrequency="0.004 0.012" numOctaves="1" seed="3" result="n"></feTurbulence>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="18" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
  </filter>
</svg>

<header>
  <div class="container">
    <a class="wordmark" href="/" aria-label="KWG, home">
      <svg class="wordmark__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M26.2636 20.4752L29.7034 6.2832H22.8238L26.2636 20.4752Z"></path>
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12.2636 6.2832L17.0473 26.0199H23.9568L19.1731 6.2832H12.2636Z"></path>
        <path fill-rule="evenodd" clip-rule="evenodd" d="M8.61287 6.28336L1.70337 6.28373L6.48706 26.0203L13.3966 26.02L8.61287 6.28336Z"></path>
      </svg>
    </a>

    <nav class="pill-nav" aria-label="Primary">
      <div class="pill-nav-items">
        <ul class="pill-list">
          {
            items.map((item) => (
              <li>
                <a
                  class:list={['pill', { 'is-active': isActive(item.href) }]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <button
        type="button"
        class="menu-button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <div class="mobile-menu" id="mobile-menu">
        <ul>
          {
            items.map((item) => (
              <li>
                <a
                  class:list={[
                    'mobile-link',
                    { 'is-active': isActive(item.href) },
                  ]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <a
      class="header-cta pill-btn"
      href={`mailto:${email}?subject=New%20project`}
    >
      Contact
    </a>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.pill-nav');
  const button = document.querySelector<HTMLButtonElement>('.menu-button');

  function setMenu(open: boolean) {
    nav?.classList.toggle('is-open', open);
    button?.setAttribute('aria-expanded', String(open));
  }

  button?.addEventListener('click', () =>
    setMenu(button.getAttribute('aria-expanded') !== 'true'),
  );

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  // A click outside the open menu closes it; without this the panel can only
  // be dismissed from the button itself.
  document.addEventListener('click', (event) => {
    if (!nav?.classList.contains('is-open')) return;
    if (!nav.contains(event.target as Node)) setMenu(false);
  });
</script>

<style lang="scss">
  header {
    // Shared by the pill rail and the hamburger.
    --nav-h: #{to-rem(44)};
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: var(--sp-md);
  }

  // Liquid glass after ui-layouts' LiquidGlassCard at its "sm" presets: a
  // 4px blurred, faintly displaced backdrop; a 2px inner highlight for the
  // lit rim; and a soft outer glow. Owner's explicit reference — the glow is
  // a drop shadow and the frosted look a frosted card, both deliberate
  // exceptions to DESIGN.md / PRODUCT.md anti-reference 1. The hairline and a
  // light canvas tint stay so labels keep their contrast over imagery.
  @mixin glass {
    position: relative;
    isolation: isolate;
    border: 1px solid var(--c-hairline-bright);
    background: color-mix(in srgb, var(--c-canvas) 25%, transparent);
    box-shadow:
      inset 2px 2px 2px 0 rgba(255, 255, 255, 0.35),
      inset -2px -2px 2px 0 rgba(255, 255, 255, 0.35),
      0 4px 4px rgba(0, 0, 0, 0.15),
      0 0 12px rgba(0, 0, 0, 0.08),
      0 0 24px rgba(255, 255, 255, 0.1);

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      backdrop-filter: blur(4px);
      filter: url('#nav-glass');
    }
  }

  // Three columns so the rail centres on the page, not between its siblings.
  .container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-lg);
  }

  .header-cta {
    @include glass;
    justify-self: end;
    min-height: var(--nav-h);
    padding-block: 0;
  }

  // The mark sits bare: no glass, no pill.
  .wordmark {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--nav-h);
    height: var(--nav-h);
    border-radius: var(--r-pill);
    color: var(--c-ink);
  }

  // The mark (public/favicon.svg is the same paths) in the ink colour.
  .wordmark__mark {
    width: to-rem(36);
    height: to-rem(36);
    fill: currentColor;
  }

  .pill-nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-self: center;
  }

  // The rail is a hairline outline, not a filled surface: the canvas stays
  // uninterrupted and only the active page gets a fill. Translucent white, the
  // same edge as every outline pill (DESIGN.md Do's).
  .pill-nav-items {
    @include glass;
    height: var(--nav-h);
    border-radius: var(--r-pill);
  }

  .pill-list {
    display: flex;
    align-items: stretch;
    gap: var(--sp-xxs);
    height: 100%;
    padding: var(--sp-xs);
    list-style: none;

    > li {
      display: flex;
    }
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding-inline: var(--sp-lg);
    border-radius: var(--r-pill);
    color: var(--c-body);
    font-size: var(--fs-body-sm);
    line-height: 1.43;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.25s var(--ease-smooth),
      color 0.25s var(--ease-smooth);

    @include has-hover {
      &:hover {
        background-color: rgba(255, 255, 255, 0.06);
        color: var(--c-ink);
      }
    }

    // The rare filled pill, spent on the one thing that earns it.
    &.is-active {
      background: var(--c-ink);
      color: var(--c-canvas);
    }
  }

  // -- Mobile ----------------------------------------------------------------

  .menu-button {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-xs);
    @include glass;
    width: var(--nav-h);
    height: var(--nav-h);
    border-radius: var(--r-pill);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-smooth);

    @include has-hover {
      &:hover {
        border-color: var(--c-hairline-bright);
      }
    }
  }

  .hamburger-line {
    width: to-rem(16);
    height: 1px;
    background: var(--c-ink);
    transition: transform 0.3s var(--ease-out-expo);
  }

  .is-open .hamburger-line:first-child {
    transform: translateY(to-rem(2.5)) rotate(45deg);
  }

  .is-open .hamburger-line:last-child {
    transform: translateY(to-rem(-2.5)) rotate(-45deg);
  }

  .mobile-menu {
    position: absolute;
    top: calc(100% + var(--sp-sm));
    right: 0;
    z-index: 998;
    display: none;
    min-width: to-rem(200);
    @include glass;
    // The mixin's relative positioning must not win over the dropdown's.
    position: absolute;
    padding: var(--sp-sm);
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--c-canvas) 70%, transparent);
    opacity: 0;
    visibility: hidden;
    transform: translateY(to-rem(-8));
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease-out-expo),
      transform 0.25s var(--ease-out-expo),
      visibility 0.25s;

    ul {
      display: grid;
      gap: var(--sp-xxs);
      list-style: none;
    }
  }

  .is-open .mobile-menu {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  .mobile-link {
    display: block;
    padding: var(--sp-md) var(--sp-lg);
    border-radius: var(--r-sm);
    color: var(--c-body);
    font-size: var(--fs-body-sm);
    text-decoration: none;
    transition:
      background-color 0.25s var(--ease-smooth),
      color 0.25s var(--ease-smooth);

    @include has-hover {
      &:hover {
        background-color: rgba(255, 255, 255, 0.06);
        color: var(--c-ink);
      }
    }

    &.is-active {
      background: var(--c-ink);
      color: var(--c-canvas);
    }
  }

  @media (max-width: 768px) {
    // Wordmark left; Email and the hamburger together on the right.
    .container {
      grid-template-columns: 1fr auto auto;
    }

    .header-cta {
      order: 2;
    }

    .pill-nav {
      order: 3;
    }

    .pill-nav-items {
      display: none;
    }

    .menu-button {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>
