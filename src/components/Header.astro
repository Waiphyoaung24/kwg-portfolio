---
// Nav bar in the x.ai language: near-black canvas, hairline-outlined pill
// rail, and the one filled white pill marking the current page. The previous
// gold sweep-circle animation (and the gsap it needed) is gone — the system
// puts its emphasis in shape and contrast, not in motion.
import { nav as items } from '../data/nav';

// /catalog/kage lights up Catalog, so a section stays marked from its children.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header>
  <div class="container">
    <a class="wordmark" href="/" aria-label="KWG, home">KWG</a>

    <nav class="pill-nav" aria-label="Primary">
      <div class="pill-nav-items">
        <ul class="pill-list">
          {
            items.map((item) => (
              <li>
                <a
                  class:list={['pill', { 'is-active': isActive(item.href) }]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <button
        type="button"
        class="menu-button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <div class="mobile-menu" id="mobile-menu">
        <ul>
          {
            items.map((item) => (
              <li>
                <a
                  class:list={[
                    'mobile-link',
                    { 'is-active': isActive(item.href) },
                  ]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.pill-nav');
  const button = document.querySelector<HTMLButtonElement>('.menu-button');

  function setMenu(open: boolean) {
    nav?.classList.toggle('is-open', open);
    button?.setAttribute('aria-expanded', String(open));
  }

  button?.addEventListener('click', () =>
    setMenu(button.getAttribute('aria-expanded') !== 'true'),
  );

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  // A click outside the open menu closes it; without this the panel can only
  // be dismissed from the button itself.
  document.addEventListener('click', (event) => {
    if (!nav?.classList.contains('is-open')) return;
    if (!nav.contains(event.target as Node)) setMenu(false);
  });
</script>

<style lang="scss">
  header {
    // Shared by the pill rail and the hamburger.
    --nav-h: #{to-rem(44)};
    position: relative;
    z-index: 10;
    padding-block: var(--sp-md);
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-lg);
  }

  .wordmark {
    font-size: var(--fs-6);
    letter-spacing: var(--ls-4);
    text-decoration: none;
    color: var(--c-ink);
  }

  .pill-nav {
    position: relative;
    display: flex;
    align-items: center;
  }

  // The rail is a hairline outline, not a filled surface: the canvas stays
  // uninterrupted and only the active page gets a fill.
  .pill-nav-items {
    height: var(--nav-h);
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-pill);
  }

  .pill-list {
    display: flex;
    align-items: stretch;
    gap: var(--sp-xxs);
    height: 100%;
    padding: var(--sp-xs);
    list-style: none;

    > li {
      display: flex;
    }
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding-inline: var(--sp-lg);
    border-radius: var(--r-pill);
    color: var(--c-body);
    font-size: var(--fs-body-sm);
    line-height: 1.43;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.25s var(--ease-smooth),
      color 0.25s var(--ease-smooth);

    @include has-hover {
      &:hover {
        background-color: rgba(255, 255, 255, 0.06);
        color: var(--c-ink);
      }
    }

    // The rare filled pill, spent on the one thing that earns it.
    &.is-active {
      background: var(--c-ink);
      color: var(--c-canvas);
    }
  }

  // -- Mobile ----------------------------------------------------------------

  .menu-button {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-xs);
    width: var(--nav-h);
    height: var(--nav-h);
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-pill);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-smooth);

    @include has-hover {
      &:hover {
        border-color: var(--c-hairline-bright);
      }
    }
  }

  .hamburger-line {
    width: to-rem(16);
    height: 1px;
    background: var(--c-ink);
    transition: transform 0.3s var(--ease-out-expo);
  }

  .is-open .hamburger-line:first-child {
    transform: translateY(to-rem(2.5)) rotate(45deg);
  }

  .is-open .hamburger-line:last-child {
    transform: translateY(to-rem(-2.5)) rotate(-45deg);
  }

  .mobile-menu {
    position: absolute;
    top: calc(100% + var(--sp-sm));
    right: 0;
    z-index: 998;
    display: none;
    min-width: to-rem(200);
    padding: var(--sp-sm);
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-sm);
    background: var(--c-canvas-card);
    opacity: 0;
    visibility: hidden;
    transform: translateY(to-rem(-8));
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease-out-expo),
      transform 0.25s var(--ease-out-expo),
      visibility 0.25s;

    ul {
      display: grid;
      gap: var(--sp-xxs);
      list-style: none;
    }
  }

  .is-open .mobile-menu {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  .mobile-link {
    display: block;
    padding: var(--sp-md) var(--sp-lg);
    border-radius: var(--r-sm);
    color: var(--c-body);
    font-size: var(--fs-body-sm);
    text-decoration: none;
    transition:
      background-color 0.25s var(--ease-smooth),
      color 0.25s var(--ease-smooth);

    @include has-hover {
      &:hover {
        background-color: rgba(255, 255, 255, 0.06);
        color: var(--c-ink);
      }
    }

    &.is-active {
      background: var(--c-ink);
      color: var(--c-canvas);
    }
  }

  @media (max-width: 768px) {
    .pill-nav-items {
      display: none;
    }

    .menu-button {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>
