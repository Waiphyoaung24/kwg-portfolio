---
// A hairline deploy pipeline for the Craft face of the hero cube — companion
// to BangkokSkyline on Where and InitialsKWG on Intro, same vocabulary:
// strokes only, hairline weight, one dot on a path.
//
// It draws the clause the copy ends on. "Every piece comes with its
// decisions, its stack, and where it runs" — the stack is the chips below,
// and this is where it runs: repo, build, image, server, in that order.
//
// No labels under the nodes. At 52 units tall there is no room for legible
// mono, and four boxes on a wire with a dot moving along it already reads as
// a pipeline; a caption at 5px would only be noise.
//
// The 300 x 52 viewBox is a measurement, not a taste. With nine chips the
// stack takes three rows and leaves a band of about 70px on a 360px face;
// a taller drawing would only shrink into the middle of it.
//
// `#wire` is load-bearing beyond the drawing: the cube script in index.astro
// runs the dot along it as a motion path. It spans the full frame, so the
// loop seam falls off the edge where nobody sees it.
---

<svg
  class="pipeline"
  viewBox="0 0 300 52"
  fill="none"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- The wire stops at each node rather than running through it. The nodes
       used to do that by being filled with the canvas colour, but an opaque
       box is the one thing on a transparent face that still reads as a panel.
       A mask gets the same gaps with nothing painted: the wire stays one
       unbroken path, so #wire is still a motion path and DrawSVG still owns
       its stroke-dasharray. maskUnits is explicit because the default region
       is a share of the object's bounding box, and a horizontal line's box is
       zero-height. -->
  <defs>
    <mask id="wire-gaps" maskUnits="userSpaceOnUse" x="0" y="0" width="300" height="52">
      <rect x="0" y="0" width="300" height="52" fill="#fff" />
      <rect x="14" y="10" width="46" height="32" fill="#000" />
      <rect x="92" y="10" width="46" height="32" fill="#000" />
      <rect x="170" y="10" width="46" height="32" fill="#000" />
      <rect x="248" y="10" width="46" height="32" fill="#000" />
    </mask>
  </defs>

  <!-- The wire first, so the four nodes sit over it rather than under. -->
  <path
    id="wire"
    class="pipeline__line pipeline__wire"
    data-draw
    mask="url(#wire-gaps)"
    d="M0 26 H300"
  />

  <!-- Repo — a branch: trunk, and one commit off it. -->
  <path class="pipeline__line pipeline__node" data-draw d="M14 10 H60 V42 H14 Z" />
  <path class="pipeline__line" data-draw d="M26 18 V34" />
  <path class="pipeline__line" data-draw d="M26 26 H40 V18" />
  <circle class="pipeline__line" data-draw cx="26" cy="36" r="2.4" />
  <circle class="pipeline__line" data-draw cx="40" cy="16" r="2.4" />

  <!-- Build — the play triangle. -->
  <path class="pipeline__line pipeline__node" data-draw d="M92 10 H138 V42 H92 Z" />
  <path class="pipeline__line" data-draw d="M110 18 L124 26 L110 34 Z" />

  <!-- Image — stacked layers, the way a container is drawn. -->
  <path class="pipeline__line pipeline__node" data-draw d="M170 10 H216 V42 H170 Z" />
  <path class="pipeline__line" data-draw d="M182 18 H204" />
  <path class="pipeline__line" data-draw d="M182 26 H204" />
  <path class="pipeline__line" data-draw d="M182 34 H204" />

  <!-- Server — a disc, running. -->
  <path class="pipeline__line pipeline__node" data-draw d="M248 10 H294 V42 H248 Z" />
  <circle class="pipeline__line" data-draw cx="271" cy="26" r="8" />
  <circle class="pipeline__line" data-draw cx="271" cy="26" r="2.4" />

  <!-- Parked at the origin and hidden until the script places it on the wire:
       with no JS there is no stray dot in the corner. -->
  <circle class="pipeline__dot" data-mover="wire" cx="0" cy="0" r="1.8" />
</svg>

<style lang="scss">
  // Fills the positioned box the face gives it and scales to fit. Absolute
  // rather than a percentage height, which does not resolve against a flex
  // item's box — and sized explicitly, because an SVG is a replaced element
  // whose auto height falls back to its intrinsic one and drops the bottom
  // offset.
  .pipeline {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    color: var(--c-hairline-bright);
  }

  .pipeline__line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    // The face scales with the viewport; the stroke must not. A hairline is a
    // hairline at every size or it stops being one.
    vector-effect: non-scaling-stroke;
  }

  // .pipeline__node carries no fill of its own — it inherits `fill: none` from
  // .pipeline__line, and #wire-gaps above is what keeps the wire out of it.
  // The class stays because it marks which four paths those gaps line up with.

  // The wire sits back from the nodes so the stages stay the subject.
  .pipeline__wire {
    opacity: 0.55;
  }

  .pipeline__dot {
    fill: #fff;
    visibility: hidden;
  }
</style>
