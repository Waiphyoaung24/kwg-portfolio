---
import Layout from '@layouts/Layout.astro';
import HeroGradient from '@components/HeroGradient.tsx';
import BangkokSkyline from '@components/BangkokSkyline.astro';
import InitialsKWG from '@components/InitialsKWG.astro';
import DeployPipeline from '@components/DeployPipeline.astro';
import ContactEnvelope from '@components/ContactEnvelope.astro';
import DeviceMock from '@components/DeviceMock.astro';
import { Image } from 'astro:assets';
import { works, type Work } from '../data/works';

// Same address as the Footer; the hero is the front door for freelance work.
const email = 'waiphyoag.cs34@gmail.com';

// Hero cube — four faces on the Y axis; the pills beside it turn the block.
// Order is the rotation order, not a ranking: the script steps between
// indices to work out the short way round. Copy comes from what the page
// already states; nothing here is invented (PRODUCT.md).
const cubeFaces = [
  { side: 'front', label: 'Intro' },
  { side: 'right', label: 'Where' },
  { side: 'back', label: 'Craft' },
  { side: 'left', label: 'Contact' },
];

// The Craft face. The working stack, given by Wai Phyo Aung rather than read
// off this repo — the earlier list described what this site is built with,
// which is a narrower claim than the face makes. Web and backend entries are
// still traceable to src/data/works.ts (Astro and React on Red Horse, Three.js
// and GSAP on Kage, FastAPI on CastraNova); the two native languages are not
// recorded anywhere here, so they stand on his word. Nothing aspirational
// goes in this list.
//
// Nine is the ceiling, not a preference: a tenth chip wraps to a fourth row
// and a fourth row is exactly the band the pipeline drawing above needs.
const stack = [
  'Astro',
  'React',
  'GSAP',
  'Three.js',
  'Node',
  'FastAPI',
  'Postgres',
  'Kotlin',
  'Swift',
];

type FeaturedWork = Work & {
  media: NonNullable<Work['media']>;
  featured: string;
};

// Selected Work is a view of the same verified project data as /works.
const gallery = works.filter(
  (work): work is FeaturedWork => Boolean(work.featured && work.media),
);

// Capabilities — two stands. They share a heading, a sub, and the same
// scroll reveal (see the scroll-stand script), and they deliberately present
// differently below that: a site is judged as one of a set, so Websites fans
// four of them; a product is examined one at a time, so Product & UI puts a
// single one at hero size and lets the rest sit quiet underneath.
//
// Heading words are pre-split server-side (no runtime SplitText) so the
// inline script can simply select `.word`s and animate their color.
//
// Websites & Landing Pages carries REAL work: the live hero of each shipped
// site, so the stand is evidence rather than decoration (PRODUCT.md,
// "Evidence on Hand"). Captured with Playwright at a 480x621 viewport — the
// 17vw x 22vw card ratio, and under the 768px breakpoint, so each site
// serves its own mobile hero and fills the portrait card with no crop. A
// desktop capture would have lost ~60% of its width to `object-fit: cover`.
const stands = [
  {
    heading: 'Websites & Landing Pages',
    sub: 'High-end sites built to perform and convert.',
    cards: [
      {
        src: '/works/site-mcm-hero.webp',
        alt: 'Miracle Cutting Machine — landing page hero',
      },
      {
        src: '/works/site-parallel-hero.webp',
        alt: 'Parallel Solution — studio site hero',
      },
      {
        src: '/works/site-redhorse-hero.webp',
        alt: 'Red Horse Group — corporate site hero',
      },
      {
        src: '/works/site-nexapex-hero.webp',
        alt: 'NexApex — landing page hero',
      },
    ],
  },
];

// Product & UI — one product examined, not five glimpsed. Mr Spinel takes the
// hero because it is the only client here with a real desktop AND a real iOS
// capture, so the drawing states the section's claim instead of asserting it:
// the same product, both sizes, side by side.
//
// The three underneath are the rest of the evidence at a size that supports
// rather than competes. GaiGai is deliberately absent — it is a consumer
// storefront whose saturated packshots fought the near-black canvas, and as a
// native app it has no desktop surface to put in a laptop at all. Its assets
// stay in public/works/product/ unreferenced.
//
// Every capture is normalised to 1280x800 (16:10), which is the laptop screen
// cut-out in DeviceMock exactly. The HRM frame is the top 16:10 slice of the
// only screenshot that exists for it: its right-hand card runs off the edge,
// which is what a narrow window does anyway.
// Two heroes, each a product shown on the two devices it actually ships on.
// Mr Spinel is desktop-and-phone, GaiGai is tablet-and-phone — which is not a
// composition choice: works.ts records Mr Spinel as an Electron desktop app
// plus an iOS staff app on one Postgres, and GaiGai as one Flutter codebase
// serving "both the phone layout and the wider tablet grid".
//
// Titles and subs come straight off those entries rather than being retyped,
// so the home page can never caption the same project two different ways.
// Each caption then reads exactly like a Selected Work card.
const mrSpinel = works.find((w) => w.id === 'mrspinel-staff');
const gaiGai = works.find((w) => w.id === 'gaigai');

// Every image carries its own alt: both devices in a pair stay on screen at
// every breakpoint, so neither can lean on the other's description
// (WCAG 2.2 AA, SC 1.1.1).
const productHeroes = [
  {
    title: mrSpinel?.title ?? 'Mr Spinel',
    sub: mrSpinel?.featured ?? '',
    primary: {
      device: 'laptop' as const,
      src: '/works/product/mrspinel-desktop.webp',
      width: 1280,
      height: 800,
      alt: 'Mr Spinel — gemstone inventory overview on desktop',
    },
    phone: {
      src: '/works/product/mrspinel-phone.webp',
      width: 480,
      height: 1041,
      alt: 'Mr Spinel — the same inventory overview on iOS',
    },
  },
  {
    title: gaiGai?.title ?? 'GaiGai',
    sub: gaiGai?.featured ?? '',
    primary: {
      device: 'tablet' as const,
      src: '/works/product/gaigai-tablet.webp',
      width: 640,
      height: 806,
      alt: 'GaiGai — grocery storefront on the tablet grid',
    },
    phone: {
      src: '/works/product/gaigai-phone.webp',
      width: 480,
      height: 1008,
      alt: 'GaiGai — the same storefront on the phone layout',
    },
  },
];

// Same title-then-sub shape as the hero and as a Selected Work card. These
// are screens rather than whole products, so the sub names the screen — which
// is also what keeps the two CastraNova entries apart.
const productScreens = [
  {
    src: '/works/product/castranova-dashboard.webp',
    title: 'CastraNova POS',
    sub: 'Dashboard',
    alt: 'CastraNova POS — dashboard',
  },
  {
    src: '/works/product/nexapex-hrm.webp',
    title: 'NexApex HRM',
    sub: 'People',
    alt: 'NexApex HRM — people dashboard',
  },
];

// Background — the places behind the work, split into the two things a
// client asks about: where you worked and where you studied. `kind` drives
// both the filter and which pins the globe carries. `id` is the CSS anchor
// name COBE exposes as --cobe-{id}, which the floating labels hang off.
// `coords: null` renders the row but pins nothing, the way `media: null` in
// src/data/works.ts renders a labelled empty panel rather than a stock photo.
//
// Work and education are supplied by the owner, newest first in each group.
// Coordinates mark cities; unspecified locations do not add a globe pin.
const background = [
  {
    id: 'parallel-solution',
    kind: 'work',
    place: 'Bangkok, Thailand',
    coords: [13.7563, 100.5018],
    org: 'Parallel Solution',
    website: 'https://parallelsolution.co/',
    role: 'AI and Lead Engineer',
    years: '2025–Current',
  },
  {
    id: 'nexapex',
    kind: 'work',
    place: 'Bangkok, Thailand',
    coords: [13.7563, 100.5018],
    org: 'NexApex',
    website: 'https://www.nexapex.ai/',
    role: 'AI and Lead Engineer',
    years: '2024–2025',
  },
  {
    id: 'an-xing',
    kind: 'work',
    place: 'Singapore',
    coords: [1.3521, 103.8198],
    org: 'An Xing Technology Pte. Ltd.',
    role: 'Software Developer · Full-time',
    years: '2021–2023',
  },
  {
    id: 'mmsoftware',
    kind: 'work',
    place: 'Yangon, Myanmar',
    coords: [16.8409, 96.1735],
    org: 'PADC (Myanmar)',
    role: 'Mobile Developer Intern',
    years: '2018–2019',
  },
  {
    id: 'coventry',
    kind: 'study',
    place: 'Coventry, England',
    coords: [52.4068, -1.5197],
    org: 'Coventry University',
    role: 'MSc. Computer Science',
    years: '2024–2025',
  },
  {
    id: 'singapore',
    kind: 'study',
    place: 'Singapore',
    coords: [1.3521, 103.8198],
    org: 'National University of Singapore',
    role: 'Graduate Diploma in Systems Analysis · G.Dip(SA)',
    years: '2021–2022',
  },
  {
    id: 'yangon',
    kind: 'study',
    place: 'Yangon, Myanmar',
    coords: [16.8409, 96.1735],
    org: 'Yangon University',
    role: 'BSc. Computer Science',
    years: '2015–2019',
  },
];

const backgroundFilters = [
  { kind: 'work', label: 'Worked' },
  { kind: 'study', label: 'Studied' },
];

// How I work — the process a stranger will live through. Four steps, no
// pricing (PRODUCT.md: no fabricated numbers). Edit the specifics here.
const steps = [
  {
    title: 'Discovery call',
    body: 'A short call. You describe the problem and what it costs you today. I ask questions. No pitch.',
  },
  {
    title: 'Scope and fixed quote',
    body: 'A written scope: what is in, what is out, one price, one timeline. You sign off before anything is built.',
  },
  {
    title: 'Build with weekly updates',
    body: 'Working software from the first weeks, not a reveal at the end. A written update every week.',
  },
  {
    title: 'Handover and support',
    body: 'Source, documentation, and deployment handed over. A support period after launch, agreed in the scope.',
  },
];

// Testimonials — verbatim excerpts from LinkedIn recommendations, trimmed to
// the load-bearing sentences. Nothing paraphrased (PRODUCT.md: no invented
// claims). Avatars are the recommenders' own LinkedIn photos.
const testimonials = [
  {
    quote:
      'He was the team’s go-to person for the toughest bugs and integration issues. He single-handedly built a web app for our Inventory and Logistics teams in one week, saving the company hundreds of hours.',
    name: 'Stephan Koch',
    role: 'Agile Project Manager · Scrum Master',
    photo: '/testimonials/stephan-koch.webp',
  },
  {
    quote:
      'I was impressed by how little time he took to complete many UI pages despite constant changes to the design. His ability to adapt to new technologies and frameworks still astonishes me to this day.',
    name: 'Jazsley Zainal',
    role: 'Software Engineer · PALO IT',
    photo: '/testimonials/jazsley-zainal.webp',
  },
];
---

<Layout>
  <main>
    <section class="hero" aria-labelledby="hero-headline">
      <div class="hero__gradient" aria-hidden="true">
        <HeroGradient client:only="react" />
      </div>
      <p class="hero__index label" data-inview-manual>
        01 &mdash; Wai Phyo Aung
      </p>

      <div class="hero__center">
        <div class="hero__copy">
          <h1 id="hero-headline" class="hero__headline h2" data-inview-manual>
            I build websites and the internal systems behind them.
          </h1>
          <div class="hero__actions" data-inview-manual>
            <a
              class="pill-btn pill-btn--filled"
              href={`mailto:${email}?subject=New%20project`}
            >
              Email me <span aria-hidden="true">&#8599;&#65038;</span>
            </a>
            <a class="pill-btn" href="#work">See selected work</a>
          </div>
        </div>

        <div class="cubeblock" data-inview-manual>
          <nav class="cubeblock__nav" aria-label="Turn the cube">
            {
              cubeFaces.map(({ side, label }, i) => (
                <button
                  class="pill-btn cubeblock__btn"
                  type="button"
                  data-side={side}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-controls={`cube-${side}`}
                >
                  {label}
                </button>
              ))
            }
          </nav>

          <div class="cubeblock__scene">
            <div class="cube" data-side="front">
              <div class="card cube__face cube__face--front" id="cube-front">
                <div class="cube__head">
                  <p class="label cube__label">Intro</p>
                  <span class="cube__mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32">
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M26.2636 20.4752L29.7034 6.2832H22.8238L26.2636 20.4752Z"
                      ></path>
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M12.2636 6.2832L17.0473 26.0199H23.9568L19.1731 6.2832H12.2636Z"
                      ></path>
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M8.61287 6.28336L1.70337 6.28373L6.48706 26.0203L13.3966 26.02L8.61287 6.28336Z"
                      ></path>
                    </svg>
                  </span>
                </div>
                <div class="cube__body">
                  <div class="cube__art">
                    <InitialsKWG />
                  </div>
                  <div class="cube__prose">
                    <p class="cube__lede">
                      I'm <em>Wai Phyo Aung</em>, an AI and software engineer
                      in Bangkok.
                    </p>
                    <p class="cube__para cube__para--more">
                      I build websites, the systems a business runs on,
                      custom web and mobile apps, and AI integration.
                    </p>
                  </div>
                </div>
              </div>

              <div class="card cube__face cube__face--right" id="cube-right">
                <p class="label cube__label">Where</p>
                <div class="cube__body">
                  <div class="cube__art">
                    <BangkokSkyline />
                  </div>
                  <p class="cube__lede">Bangkok, Thailand. UTC+7.</p>
                  <p class="cube__para">
                    A written update every week, whatever the time zone.
                  </p>
                  <time class="micro cube__time" data-clock></time>
                </div>
              </div>

              <div class="card cube__face cube__face--back" id="cube-back">
                <p class="label cube__label">Craft</p>
                <div class="cube__body">
                  <div class="cube__art">
                    <DeployPipeline />
                  </div>
                  <p class="cube__lede">
                    Every piece comes with its decisions, its stack, and where
                    it runs.
                  </p>
                  <ul class="cube__stack" role="list">
                    {stack.map((s) => <li class="micro">{s}</li>)}
                  </ul>
                </div>
              </div>

              <div class="card cube__face cube__face--left" id="cube-left">
                <p class="label cube__label">Contact</p>
                <div class="cube__body">
                  <div class="cube__art">
                    <ContactEnvelope />
                  </div>
                  <p class="cube__lede">
                    One door: email. No forms, no booking funnel.
                  </p>
                  <p class="micro cube__addr">{email}</p>
                  <a class="pill-btn" href={`mailto:${email}?subject=New%20project`}>
                    Email me <span aria-hidden="true">&#8599;&#65038;</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="hero__cue label" data-inview-manual>
        Scroll <span aria-hidden="true">&darr;</span>
      </p>
    </section>

    <section id="work" class="container work" aria-labelledby="work-heading">
      <header class="work__header">
        <p class="label">02 &mdash; Selected Work</p>
        <h2 id="work-heading" class="work__title-block">
          Selected Work<br />
          <span class="work__years">2024 &mdash; 2026</span>
        </h2>
      </header>

      <ul class="gallery" role="list">
        {
          gallery.map(({ media, title, featured }) => (
            <li class="gallery__item">
              <figure class="gallery__figure">
                <Image
                  class="gallery__img"
                  src={media.poster}
                  width={media.posterWidth}
                  height={media.posterHeight}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 768px) calc(100vw - 40px), 46vw"
                  alt={media.alt}
                  loading="lazy"
                  decoding="async"
                  quality="high"
                  data-cursor-media="image"
                />
                <figcaption class="gallery__caption">
                  <p class="gallery__title">{title}</p>
                  <span class="gallery__sub">{featured}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      id="background"
      class="container background"
      aria-labelledby="background-heading"
    >
      <header class="background__header">
        <p class="label" data-inview>03 &mdash; Background</p>
        <h2 id="background-heading" class="visually-hidden">Background</h2>

        <div
          class="background__filter"
          role="group"
          aria-label="Show where I worked or where I studied"
          data-inview
        >
          {
            backgroundFilters.map(({ kind, label }, i) => (
              <button
                class="pill-btn background__btn"
                type="button"
                data-kind={kind}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {label}
              </button>
            ))
          }
        </div>
      </header>

      <div class="background__body">
        <div class="background__globe" data-inview>
          <canvas
            class="globe"
            data-globe
            data-markers={JSON.stringify(
              background
                .filter((b) => b.coords)
                .map(({ id, kind, coords }) => ({ id, kind, location: coords })),
            )}
            aria-hidden="true"></canvas>

          {
            background
              .filter((b) => b.coords)
              .map(({ id, kind, place }) => (
                <span
                  class="micro globe__label"
                  data-kind={kind}
                  aria-hidden="true"
                  style={`position-anchor: --cobe-${id}; --v: var(--cobe-visible-${id}, 0)`}
                >
                  {place}
                </span>
              ))
          }
        </div>

        <ol class="background__list" role="list" data-inview>
          {
            background.map(({ kind, place, org, role, years, website }) => (
              <li
                class="background__row"
                data-kind={kind}
                hidden={kind !== 'work'}
              >
                {place && <p class="label background__place">{place}</p>}
                <div class="background__org-line">
                  <p class="background__org">{org}</p>
                  {website && (
                    <a
                      class="background__website"
                      href={website}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Visit ${org} website`}
                      title={`Visit ${org} website`}
                    >
                      <span
                        class="background__website-icon"
                        aria-hidden="true"
                      />
                    </a>
                  )}
                </div>
                <p class="background__role">{role}</p>
                <p class="micro background__years">{years}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="capabilities" aria-labelledby="capabilities-heading">
      <header class="container capabilities__header">
        <p class="label" data-inview>04 &mdash; Capabilities</p>
        <h2 id="capabilities-heading" class="visually-hidden">Capabilities</h2>
      </header>

      {
        stands.map(({ heading, sub, cards }) => {
          const words = heading.split(/\s+/);
          return (
            <article class="stand">
              <div class="stand__inner">
                <div class="stand__copy">
                  <h3 class="stand__heading">
                    {words.map((w, i) => (
                      <>
                        <span class="word">{w}</span>
                        {i < words.length - 1 ? ' ' : ''}
                      </>
                    ))}
                  </h3>
                  <p class="stand__sub">{sub}</p>
                </div>

                <div class="stand__cards">
                  <div class="stand__stage">
                    {cards.map(({ src, alt }) => (
                      <article class="stand__card">
                        <img
                          src={src}
                          alt={alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </article>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }

      {/* Same `.stand`, `.stand__copy` and `.stand__heading .word` hooks as
          above, so the scroll-stand script gives this stand the identical
          copy rise and word-colour stagger with no changes to it. What it
          does not carry is `.stand__card`, so the script's fan skips it —
          `cards.length` is 0 and the timeline just drops that tween. */}
      <article class="stand stand--product">
        <div class="stand__inner">
          <div class="stand__copy">
            <h3 class="stand__heading">
              <span class="word">Product</span> <span class="word">&amp;</span>{' '}
              <span class="word">UI</span>
            </h3>
            {/* Replaces "Interfaces crafted with clarity — every screen
                considered, every interaction refined", which was the hollow
                capability copy PRODUCT.md anti-reference 4 rules out and the
                claimed-not-shown confidence the voice section forbids.
                Every noun below is a product on this stand.

                It no longer opens on "internal systems built for people who
                live in them all day" — PRODUCT.md's own positioning line, but
                a false frame once GaiGai is here: a consumer grocery
                storefront is not an internal system. */}
            <p class="stand__sub">
              Inventory, point of sale, HR, and grocery commerce — the same
              system rendered for desktop, tablet, and phone.
            </p>
          </div>

          <div class="product__heroes">
            {productHeroes.map(({ title, sub, primary, phone }, i) => (
              <figure class="product" data-inview style={`--delay:${i * 0.1}s`}>
                <div class="product__stage">
                  <div class:list={['product__primary', `product__primary--${primary.device}`]}>
                    <DeviceMock
                      device={primary.device}
                      src={primary.src}
                      alt={primary.alt}
                      width={primary.width}
                      height={primary.height}
                    />
                  </div>
                  <div class="product__phone">
                    <DeviceMock
                      device="phone"
                      src={phone.src}
                      alt={phone.alt}
                      width={phone.width}
                      height={phone.height}
                    />
                  </div>
                </div>

                {/* A real <figcaption>, since the devices are already a
                    <figure>. Each hero names itself the way a Selected Work
                    card does. */}
                <figcaption class="product__caption">
                  <p class="product__title">{title}</p>
                  <span class="product__sub">{sub}</span>
                </figcaption>
              </figure>
            ))}
          </div>

          <ul class="product__more">
            {productScreens.map(({ src, title, sub, alt }, i) => (
              <li class="product__screen" data-inview style={`--delay:${i * 0.08}s`}>
                <img
                  src={src}
                  alt={alt}
                  width="1280"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
                {/* A plain div, not a <figcaption>: that element is only valid
                    inside a <figure>, and the hero above is the figure here. */}
                <div class="product__caption">
                  <p class="product__title">{title}</p>
                  <span class="product__sub">{sub}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </article>
    </section>

    <section
      id="process"
      class="container process"
      aria-labelledby="process-heading"
    >
      <header class="process__header">
        <p class="label" data-inview>05 &mdash; How I work</p>
        <h2 id="process-heading" data-inview>
          What the next few months look like
        </h2>
      </header>

      <ol class="process__list" role="list">
        {
          steps.map(({ title, body }, i) => (
            <li
              class="process__step"
              data-inview
              style={`--delay: ${i * 0.08}s`}
            >
              <span class="process__index label">0{i + 1}</span>
              <h3 class="process__title">{title}</h3>
              <p class="process__body">{body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      id="testimonials"
      class="container testimonials"
      aria-labelledby="testimonials-heading"
    >
      <header class="testimonials__header">
        <p class="label" data-inview>06 &mdash; Testimonials</p>
        <h2 id="testimonials-heading" data-inview>
          What the people I worked with say
        </h2>
      </header>

      <div class="testimonials__grid">
        {
          testimonials.map(({ quote, name, role, photo }, i) => (
            <figure
              class="testimonial card"
              data-inview
              style={`--delay: ${i * 0.08}s`}
            >
              <span class="testimonial__mark" aria-hidden="true">
                &ldquo;
              </span>
              <blockquote class="testimonial__quote">{quote}</blockquote>
              <figcaption class="testimonial__person">
                <img
                  class="testimonial__avatar"
                  src={photo}
                  alt=""
                  width="128"
                  height="128"
                  loading="lazy"
                  decoding="async"
                />
                <span class="testimonial__id">
                  <span class="testimonial__name">{name}</span>
                  <span class="testimonial__role micro">{role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!--
      Work detail: the overlay a Selected Work card expands into
      (src/scripts/workTransition.ts). Sits outside the hero, which scales on
      exit and would otherwise trap the fixed overlay. data-lenis-prevent lets
      the column scroll natively on short viewports while Lenis is frozen.
    -->
    <div
      class="work-detail"
      role="dialog"
      aria-modal="true"
      aria-label="Selected work"
      data-lenis-prevent
    >
      <div class="work-detail__backdrop" aria-hidden="true"></div>
      <figure class="work-detail__preview">
        <img alt="" />
      </figure>
      <div class="work-detail__column">
        <button class="work-detail__back pill-btn" type="button">
          <span aria-hidden="true">&larr;</span> Back
          <span class="micro" aria-hidden="true">Esc</span>
        </button>
        {
          gallery.map(({ id, title, featured, summary, homeOnly, url }, i) => {
            // Home-only work has no /works panel to deep-link into, so its CTA
            // points at the live site instead. Work with neither — an internal
            // tool with nothing public — gets no CTA rather than a dead one.
            const href = homeOnly ? url : `/works#panel-${id}`;
            return (
              <div class="work-detail__group" data-index={i}>
                <p class="work-detail__eyebrow label">
                  0{i + 1} &mdash; {featured}
                </p>
                <h3 class="work-detail__title h2">{title}</h3>
                <p class="work-detail__body">{summary}</p>
                {href && (
                  <a
                    class="pill-btn"
                    href={href}
                    {...(homeOnly
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {homeOnly ? 'Visit site' : 'View project'}{' '}
                    <span aria-hidden="true">&#8599;&#65038;</span>
                  </a>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  // Importing scroll.ts ensures the Lenis ↔ ScrollTrigger bridge is wired
  // before our triggers are created.
  import '../scripts/scroll';

  const imgs = gsap.utils.toArray<HTMLImageElement>('.gallery__img');

  // matchMedia rather than a `window.innerWidth > 768` read: that read
  // happened once at load and was never re-checked, so rotating the phone or
  // resizing the window left the tiles running the other side's numbers. The
  // context reverts whatever gsap.set wrote when its queries stop matching,
  // so crossing the breakpoint never strands a tile mid-transform.
  //
  // isPhone is not redundant with isDesktop. .add() runs the callback only if
  // at least one query matches, so a set that leaves a gap — isDesktop plus
  // reduceMotion alone — never fires at all on a phone with reduced motion
  // off, and every mobile branch inside becomes dead code. The two width
  // queries have to cover every width between them.
  //
  // Reduced motion is a condition too, so the tiles simply appear, and start
  // appearing the moment the OS setting flips (PRODUCT.md a11y floor).
  gsap.matchMedia().add(
    {
      isDesktop: '(min-width: 769px)',
      isPhone: '(max-width: 768px)',
      reduceMotion: '(prefers-reduced-motion: reduce)',
    },
    (ctx) => {
      const { isDesktop, reduceMotion } = ctx.conditions as Record<
        string,
        boolean
      >;
      if (reduceMotion) return;

      imgs.forEach((img, i) => {
        gsap.set(img, {
          // Phones skip the spin entirely. A 320px tile held at 50° sweeps a
          // 451px box — ~45px past each edge of the column — and holds it
          // from load until that tile scrolls in, which is most of the page.
          // The rise alone reads the same at phone size.
          rotation: isDesktop ? (i % 2 === 0 ? -50 : 50) : 0,
          transformOrigin: 'center center',
          y: isDesktop ? 500 : 350,
          opacity: 0,
        });

        ScrollTrigger.create({
          trigger: img,
          start: isDesktop ? 'top 100%' : 'top 120%',
          once: true,
          onEnter: () => {
            gsap.to(img, {
              rotation: 0,
              y: 0,
              opacity: 1,
              duration: 0.8,
              // Entrances ease out (the --ease-out-expo token); an in-out
              // start reads as a stall on arrival.
              ease: 'expo.out',
              delay: isDesktop ? (i % 2 === 0 ? 0 : 0.25) : 0,
            });
          },
        });
      });
    },
  );
</script>

<script>
  // Selected Work cards expand into the work-detail overlay: the image
  // Flip-morphs into the preview, the copy reveals, Back/Esc reverse it.
  import { WorkTransition } from '../scripts/workTransition';

  const overlay = document.querySelector<HTMLElement>('.work-detail');
  if (overlay) {
    new WorkTransition({
      items: Array.from(
        document.querySelectorAll<HTMLElement>('.gallery__figure'),
      ),
      img: '.gallery__img',
      overlay,
    });
  }
</script>

<script>
  // Background globe — COBE (5kB, vanilla, no deps). The light globe from the
  // library's own homepage: dark: 0, a pale base, white markers, and the glow
  // pulled right down so it does not halo against the near-black canvas. A
  // globe is illustration, which is the one place DESIGN.md allows this
  // system light and glow at all.
  //
  // v2 has no onRender and runs no loop of its own — you drive it by calling
  // update(). That is the better shape here anyway: the globe is built on
  // first intersection so WebGL init stays off the critical path, and it only
  // spins while the section is actually on screen.
  import createGlobe from 'cobe';

  const globeCanvas = document.querySelector<HTMLCanvasElement>('[data-globe]');
  if (globeCanvas) {
    type Pin = { id: string; kind: string; location: [number, number] };
    const pins: Pin[] = JSON.parse(globeCanvas.dataset.markers || '[]');
    // id becomes COBE's --cobe-{id} anchor name, which the labels hang off.
    const markersFor = (kind: string) =>
      pins
        .filter((pin) => pin.kind === kind)
        .map(({ id, location }) => ({ id, location, size: 0.06 }));
    let kind = 'work';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // devicePixelRatio below multiplies this, so pass CSS pixels — doubling
    // here too would render a 4x buffer for a 2x screen.
    const px = () => globeCanvas.offsetWidth;

    let globe: ReturnType<typeof createGlobe> | null = null;
    let phi = 0;
    let raf = 0;

    const tick = () => {
      phi += 0.0025;
      globe?.update({ phi });
      raf = requestAnimationFrame(tick);
    };

    const build = () => {
      globe = createGlobe(globeCanvas, {
        devicePixelRatio: 2,
        width: px(),
        height: px(),
        phi: 0,
        // Tilted so the northern hemisphere reads rather than the equator.
        theta: 0.25,
        dark: 0,
        diffuse: 1.2,
        scale: 1,
        mapSamples: 16000,
        mapBrightness: 6,
        baseColor: [0.72, 0.73, 0.75],
        // Near-black markers, not white: on a pale globe a white dot is
        // invisible. This is the canvas colour punched back through the
        // illustration, so the pins read as the page marking the sphere.
        markerColor: [0.04, 0.04, 0.04],
        glowColor: [0.14, 0.15, 0.16],
        markers: markersFor(kind),
      });
      new ResizeObserver(() =>
        globe?.update({ width: px(), height: px() }),
      ).observe(globeCanvas);
    };

    new IntersectionObserver(
      ([entry]) => {
        if (!globe && entry.isIntersecting) build();
        cancelAnimationFrame(raf);
        // Reduced motion holds the globe still; the markers still read.
        if (entry.isIntersecting && !reduce) raf = requestAnimationFrame(tick);
      },
      { rootMargin: '200px' },
    ).observe(globeCanvas);

    // Worked / Studied. One switch drives all three views of the same data:
    // the rows, the floating labels, and the pins on the globe. No animation
    // on the swap — a filter's job is to show the answer, not to travel.
    const filters =
      document.querySelectorAll<HTMLButtonElement>('.background__btn');
    const rows = document.querySelectorAll<HTMLElement>('.background__row');
    const labels = document.querySelectorAll<HTMLElement>('.globe__label');

    const show = (next: string) => {
      kind = next;
      rows.forEach((el) => (el.hidden = el.dataset.kind !== next));
      labels.forEach((el) => (el.hidden = el.dataset.kind !== next));
      filters.forEach((el) =>
        el.setAttribute('aria-pressed', String(el.dataset.kind === next)),
      );
      globe?.update({ markers: markersFor(next) });
    };

    filters.forEach((btn) =>
      btn.addEventListener('click', () => show(btn.dataset.kind!)),
    );
  }
</script>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  gsap.registerPlugin(DrawSVGPlugin, MotionPathPlugin);

  // Three faces carry a drawing — Intro its initials, Where its city, Craft
  // its pipeline — and all work the same way: every [data-draw] stroke draws
  // itself in the first time that wall is seen, then the [data-mover] dot, if
  // the drawing has one, runs the path it names. Ornament in every case, which
  // is what lets reduced motion simply not run them.
  //
  // The boat's and the pipeline dot's routes span the full frame, so a loop
  // seam falls off the edge where nobody sees it. The initials carry no dot.
  const drawing = (selector: string, seconds: number) => {
    const svg = document.querySelector<SVGSVGElement>(selector);
    let drawn = false;
    return () => {
      if (drawn || !svg) return;
      drawn = true;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // Delayed past the turn: the wall is edge-on for the first half of it,
      // and a stroke drawn side-on is a stroke nobody sees.
      gsap.from(svg.querySelectorAll('[data-draw]'), {
        drawSVG: 0,
        duration: 0.9,
        stagger: 0.06,
        delay: 0.35,
        ease: 'power2.out',
      });

      const mover = svg.querySelector<SVGElement>('[data-mover]');
      const route =
        mover && svg.querySelector<SVGPathElement>(`#${mover.dataset.mover}`);
      if (!mover || !route) return;

      gsap.set(mover, { visibility: 'visible' });
      gsap.to(mover, {
        motionPath: { path: route, align: route, alignOrigin: [0.5, 0.5] },
        duration: seconds,
        delay: 0.35,
        repeat: -1,
        ease: 'none',
      });
    };
  };

  const drawWork = drawing('.initials', 12);
  const drawCity = drawing('.skyline', 14);
  const drawCraft = drawing('.pipeline', 11);
  // A 300-unit straight traverse, so the number sits between the river's 14s
  // (~22 units/s) and the wire's 11s (~27). Those two do not agree with each
  // other, so there is no speed to match exactly — this splits them.
  const drawDoor = drawing('.envelope', 12);

  // Intro is the face the cube opens on, so its drawing waits on the splash
  // rather than a turn. The event fires either way — Splash dispatches it
  // immediately when it has already played this session.
  window.addEventListener('splash:done', drawWork, { once: true });

  // Hero cube: the pills beside it turn the block to a face. Rotation is
  // cumulative rather than a fixed angle per face, so every turn takes the
  // short way round — Contact back to Status is a quarter turn, not three.
  const cube = document.querySelector<HTMLElement>('.cube');
  const btns = document.querySelectorAll<HTMLButtonElement>('.cubeblock__btn');
  if (cube && btns.length) {
    const order = ['front', 'right', 'back', 'left'];
    let angle = 0;
    btns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const side = btn.dataset.side!;
        const step =
          (order.indexOf(side) - order.indexOf(cube.dataset.side!) + 4) % 4;
        // A step of 3 is a quarter turn the other way.
        angle -= (step > 2 ? step - 4 : step) * 90;
        cube.style.setProperty('--rot', `${angle}deg`);
        cube.dataset.side = side;
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (side === 'front') drawWork();
        if (side === 'right') drawCity();
        if (side === 'back') drawCraft();
        if (side === 'left') drawDoor();
      }),
    );
  }

  // Bangkok clock on the Where face. Rendered empty rather than at build
  // time, so a stale hour never ships with the page.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Bangkok',
      hour: '2-digit',
      minute: '2-digit',
    });
    const tick = () => (clock.textContent = `${fmt.format(new Date())} ICT`);
    tick();
    setInterval(tick, 30_000);
  }
</script>

<script>
  // Zoom handoff, after Giana's "zoom scroll" (codepen.io/giana/pen/BabdgjB)
  // minus the scroll-snap, which Lenis fights. The hero scales up, blurs and
  // fades as it leaves; the Selected Work header zooms in from small behind
  // it. Scrubbed to scroll through the Lenis-driven ticker in scroll.ts.
  // Targets are wrappers, not the [data-inview*] children: those carry a CSS
  // transition on filter/opacity/transform that would lag a scrubbed tween.
  import { gsap } from 'gsap';
  import '../scripts/scroll';

  // isPhone pairs with isDesktop so one of the two always matches — see the
  // gallery script above for why a gap here silences the whole callback.
  gsap.matchMedia().add(
    {
      isDesktop: '(min-width: 769px)',
      isPhone: '(max-width: 768px)',
      reduceMotion: '(prefers-reduced-motion: reduce)',
    },
    (ctx) => {
      const { isDesktop, reduceMotion } = ctx.conditions as Record<
        string,
        boolean
      >;
      if (reduceMotion) return;

      gsap
        .timeline({
          scrollTrigger: {
            trigger: '.hero',
            start: 'bottom bottom',
            end: 'bottom top',
            scrub: 1,
          },
        })
        .to(
          '.hero',
          {
            // The hero is capped at 1200px and centred, so on desktop the
            // zoom grows into its own gutters. On a phone it already spans
            // the viewport, and 1.5 would put 90px past each edge for the
            // whole length of the handoff — the fade carries it there.
            scale: isDesktop ? 1.5 : 1,
            opacity: 0,
            ease: 'power1.in',
          },
          0,
        )
        // Blur only the type; blurring the WebGL canvas every frame is costly.
        .to('.hero__center', { filter: 'blur(16px)', ease: 'power1.in' }, 0);

      // Scales up to 1 from a left origin, so it never reaches past the edge.
      gsap.from('.work__header', {
        scale: 0.6,
        opacity: 0,
        filter: 'blur(16px)',
        transformOrigin: '0% 50%',
        ease: 'power1.out',
        scrollTrigger: {
          trigger: '.work__header',
          start: 'top bottom',
          end: 'top 40%',
          scrub: 1,
        },
      });
    },
  );
</script>

<script>
  // Scroll-stand: each stand's cards start fanned in 3D and flatten into a
  // row as the section enters the viewport. Heading words stagger color
  // from white → muted. Scrubbed to scroll position via the Lenis-driven
  // GSAP ticker wired in src/scripts/scroll.ts.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import '../scripts/scroll';

  // Read live design tokens so palette tweaks in _vars.scss flow through.
  const css = getComputedStyle(document.documentElement);
  const cLight = css.getPropertyValue('--c-ink').trim() || '#ffffff';
  const cMuted = css.getPropertyValue('--c-mute').trim() || '#7d8187';

  // Per-card initial 3D state — centre card is most vertical, edges fan out.
  // Derived from position rather than a fixed table: the stands no longer hold
  // the same number of cards, and indexing a five-entry table with four cards
  // fanned them lopsided. For five this reproduces the original values
  // (rotateX 58/74/90/74/58, rotateY +18/+5/0/-5/-18, y 48/32/18/32/48).
  const cardStart = (i: number, n: number) => {
    const t = n < 2 ? 0 : (i / (n - 1)) * 2 - 1; // -1 left edge … 1 right edge
    const a = Math.abs(t);
    return {
      rotateX: 90 - 32 * a,
      rotateY: -18 * Math.sign(t) * a ** 1.85,
      y: 18 + 30 * a,
    };
  };

  gsap
    .matchMedia()
    .add(
      { isDesktop: '(min-width: 769px)', isPhone: '(max-width: 768px)' },
      (ctx) => {
        const { isDesktop } = ctx.conditions as Record<string, boolean>;

        document.querySelectorAll<HTMLElement>('.stand').forEach((section) => {
          // Phones lay the cards out as a flat 2-up grid with no perspective, so
          // there is no fan to flatten — the copy and the heading still move.
          // On desktop, narrow viewports hide the outer cards, and a hidden card
          // must not take a slot in the fan or the visible ones sit lopsided.
          // offsetParent is null for `display: none`, which is what CSS dropped.
          const cards = isDesktop
            ? [...section.querySelectorAll<HTMLElement>('.stand__card')].filter(
                (card) => card.offsetParent !== null,
              )
            : [];
          const copy = section.querySelector<HTMLElement>('.stand__copy');
          const words = section.querySelectorAll<HTMLElement>(
            '.stand__heading .word',
          );

          cards.forEach((card, i) => {
            gsap.set(card, {
              ...cardStart(i, cards.length),
              transformOrigin: '50% 100%',
              transformPerspective: 1560,
            });
          });

          if (copy) gsap.set(copy, { y: -10 });
          gsap.set(words, { color: cLight });

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: section,
              start: 'top 40%',
              end: 'top 0%',
              scrub: 1,
            },
          });

          if (cards.length) {
            tl.to(
              cards,
              {
                rotateX: 0,
                rotateY: 0,
                y: 0,
                ease: 'power1.inOut',
                duration: 1,
              },
              0,
            );
          }

          tl.to(copy, { y: 0 }, 0).to(
            words,
            { color: cMuted, stagger: 0.2 },
            0.1,
          );
        });
      },
    );
</script>

<style lang="scss">
  // HERO — the front door: who, what, where, one way to reach out.
  // Three rows: top label, centered headline + proof + pills, bottom cue.
  // No imagery; a mesh gradient in the canvas greys (HeroGradient) behind the type.
  // 4rem subtracts the Header's vertical footprint (padding-block 1.25rem × 2
  // + ~1rem label content ≈ 3.5rem, rounded to 4rem) so the cue sits inside
  // the viewport instead of below the fold.
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100svh - 4rem);
    // Matches .container so the hero lines up with the header above it.
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: to-rem(24) var(--grid-margin) to-rem(40);
  }

  // Full-bleed: the hero is container-width, but the backdrop runs edge to
  // edge, under the type. It also reaches up behind the (transparent) Header:
  // 68px = its 44px rail + 12px padding either side.
  .hero__gradient {
    --header-h: #{to-rem(68)};
    position: absolute;
    inset: 0 auto;
    top: calc(-1 * var(--header-h));
    left: 50%;
    width: 100vw;
    height: calc(100% + var(--header-h));
    transform: translateX(-50%);
    z-index: -1;

    // Dark washes over the left half, where the copy sits, and the top strip,
    // where the header sits, so the white in the sphere blooms lower right and
    // the type keeps its contrast. A bottom wash dissolves the canvas into the
    // page so the hero has no hard edge against the next section.
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(0deg, var(--c-canvas) 0%, transparent 28%),
        linear-gradient(
          180deg,
          var(--c-canvas) 0%,
          color-mix(in srgb, var(--c-canvas) 60%, transparent) 12%,
          transparent 30%
        ),
        linear-gradient(
          90deg,
          var(--c-canvas) 0%,
          color-mix(in srgb, var(--c-canvas) 70%, transparent) 40%,
          transparent 75%
        );
    }
  }

  // Body, not mute: the gradient lifts the backdrop past what mute can sit on.
  .hero__index {
    color: var(--c-body);
  }

  // Copy left, illumine card right; the card drops under the pills on mobile.
  // Copy left, cube right; the block drops under the pills below $cube-aside.
  // That threshold is 1060px, not the 769px used elsewhere on this page: the
  // block and its pills claim ~546px, so at 960px the headline is left a
  // 306px column and stacks seven lines deep. The three queries that switch
  // this layout share the number. It tracks --face: grow the cube and this
  // grows with it, or the headline loses its column.
  $cube-aside: 1060px;

  .hero__center {
    display: grid;
    align-items: center;
    gap: clamp-fluid(40, 80);

    @media (min-width: $cube-aside) {
      grid-template-columns: 1fr auto;
    }
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: clamp-fluid(20, 40);
  }

  // HERO CUBE — after l-ignatova's "Cube CV" (codepen.io/l-ignatova/pen/qByExmV).
  // The pen's mechanics, nothing else: one --face size drives the scene depth
  // and every face's translateZ, so the block stays a true cube at any width.
  // Four faces on the Y axis only — top and bottom are never turned to, so
  // they are not drawn. Faces are the .card primitive, so hairlines carry the
  // elevation and nothing casts a shadow. The inline script sets --rot.
  .cubeblock {
    // One expression at every width, no breakpoint. The cap is the budget the
    // faces' copy is written against; the column term is what a phone can
    // show. $cube-aside above moves with the cap.
    //
    // 420, not the 360 this started at: at 360 the Craft face — the fullest,
    // with a drawing, a three-line lede and nine chips — ran its last chip
    // row into the bottom padding and starved the drawing. The face is the
    // budget, so the fix was the budget, not the copy.
    //
    // 0.90 of the column, not the 0.78 a max-width: 768px rule used to carry.
    // A turning cube is wider than its face: the near corners project past
    // the scene box and the bracket frame's -10px inset adds to that. 0.78
    // was set when that bleed drove page scroll; html and body now carry
    // overflow-x: clip, so the failure mode is a clipped corner and the
    // budget is the wider one. Measured by sweeping the turn in 5° steps over
    // the union of the four faces' projected boxes: nothing clips from 320px
    // up, with ~18px to spare at 390.
    //
    // Folding the cap into the same min() retires that breakpoint: uncapped,
    // the phone rule grew the face to 653px by 768px and then snapped back to
    // 420 at 769px. Capped, the column term stops winning near 510px and the
    // ramp is continuous. No viewport-height term — a face capped by a short
    // window shrinks below what its words need. Both terms are lengths;
    // --face feeds translateZ, which rejects percentages.
    --face: min(#{to-rem(420)}, calc((100vw - 2 * var(--grid-margin)) * 0.9));
    --turn: 0.7s var(--ease-out-expo);
    display: grid;
    gap: var(--sp-xl);

    // Pills to the right of the block. The nav stays first in the DOM, so
    // tab order still reaches the controls before the face they turn to;
    // `order` moves it visually without touching that.
    @media (min-width: $cube-aside) {
      grid-template-columns: var(--face) auto;
      align-items: center;

      .cubeblock__nav {
        order: 2;
      }
    }
  }

  .cubeblock__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-sm);

    // Four labels come to 158px of ink between them; the pill primitive's own
    // 24px of horizontal padding comes to 192px — more than the words. That
    // is what pushes Contact onto a second row, so below ~421px the padding
    // is what gives, not the row. Wrap stays as the floor under 320px.
    @media (max-width: 27.5rem) {
      .cubeblock__btn {
        padding-inline: var(--sp-sm);
      }
    }

    @media (min-width: $cube-aside) {
      flex-direction: column;
      // Stretch so the four pills share one width and read as a column.
      align-items: stretch;
    }
  }

  // The face on show. Outline pills throughout: the hero's one filled pill is
  // already spent on Email me.
  .cubeblock__btn[aria-pressed='true'] {
    border-color: var(--c-ink);
    background-color: color-mix(in srgb, var(--c-ink) 6%, transparent);
  }

  .cubeblock__scene {
    position: relative;
    width: var(--face);
    height: var(--face);
    // The face is 0.78 of the column below 769px, so the block does not fill
    // the row the pills above it do. Left-aligned, that shortfall all landed
    // on the right as ~67px of dead column; centred, it reads as a gutter the
    // rotation turns into and splits the corner bleed evenly between the two
    // sides. Above $cube-aside the scene's grid column IS --face, so this is
    // a no-op there and the two-column layout is untouched.
    justify-self: center;
    // The faces query this, not the viewport: what fits on a face depends
    // on the face.
    container: cube / inline-size;
    // Short enough that the far wall foreshortens visibly — that inner
    // rectangle, and the four side walls raking back to meet it, are what
    // make the block read as a box you are looking into.
    perspective: to-rem(800);
  }

  // Corner brackets, as the illumine card wore before it: a hairline frame
  // just outside the block, clipped back to its corners so it marks the
  // volume without a second closed rectangle competing with the box.
  .cubeblock__scene::after {
    --ax: #{to-rem(44)};
    content: '';
    position: absolute;
    inset: to-rem(-10);
    border: 1px solid var(--c-hairline-bright);
    border-radius: var(--r-sm);
    pointer-events: none;
    clip-path: polygon(
      var(--ax) 0,
      0 0,
      0 var(--ax),
      var(--ax) var(--ax),
      var(--ax) calc(100% - var(--ax)),
      0 calc(100% - var(--ax)),
      0 100%,
      var(--ax) 100%,
      var(--ax) calc(100% - var(--ax)),
      calc(100% - var(--ax)) calc(100% - var(--ax)),
      calc(100% - var(--ax)) 100%,
      100% 100%,
      100% calc(100% - var(--ax)),
      calc(100% - var(--ax)) calc(100% - var(--ax)),
      calc(100% - var(--ax)) var(--ax),
      100% var(--ax),
      100% 0,
      calc(100% - var(--ax)) 0,
      calc(100% - var(--ax)) var(--ax),
      var(--ax) var(--ax)
    );
  }

  // One orchestrated arrival. The page's own reveal fades and lifts every
  // [data-inview] element; the block adds a quarter-turn to the front on top
  // of it, so its first act shows what it is rather than that it faded in.
  // Gated the way the reveal itself is, in _base.scss.
  @media (prefers-reduced-motion: no-preference) {
    .cubeblock:not(.inview) .cube {
      --rot: -28deg;
    }
  }

  .cube {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    // Half a face back, so the face on show sits on the scene plane instead
    // of floating toward the viewer.
    transform: translateZ(calc(var(--face) / -2)) rotateY(var(--rot, 0deg));
    transition: transform var(--turn);
  }

  // Faces are transparent, as the pen's are: you look through the front wall
  // at the far one, and the side walls rake back to meet it. That read is the
  // whole point of a cube — opaque faces are just the flat card again, which
  // is why the .card primitive's fill is dropped here and its hairline
  // brightened. backface-visibility stays visible so the far faces draw.
  .cube__face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    // Gap and padding scale with the face so a 325px one on a phone holds
    // the same copy a 460px one does on a laptop.
    gap: clamp-fluid(10, 16);
    padding: clamp-fluid(18, 24);
    // No fill at all: the hairlines and the ::after highlight carry the
    // volume, and the hero gradient reads straight through the walls. `none`
    // rather than a removed declaration, because .card's liquid-glass frost
    // would otherwise take the slot back.
    background: none;
    // Every face keeps its edge at full strength whichever way the block is
    // turned: the eight hairlines are what describe the volume, and dimming
    // them with the face dissolves it back into a panel.
    border-color: var(--c-hairline-bright);

    // Accessibility floor (PRODUCT.md: WCAG 2.2 AA), matching the fallback in
    // the liquid-glass mixin. Readers who ask for less transparency get the
    // flat card fill instead — see-through walls are the effect they opted
    // out of, and their contrast should not depend on the gradient behind.
    @media (prefers-reduced-transparency: reduce) {
      background: var(--c-canvas-card);
    }
  }

  // Both decorative layers sit at -1: above the wall's own fill, under its
  // type. .cube__face is transformed, so the negative index cannot escape
  // the face's own stacking context.
  .cube__face::before,
  .cube__face::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  // An inner frame, square against the face's rounded outer edge. Four of
  // them at four depths nest into each other and give the box its interior.
  .cube__face::before {
    inset: clamp-fluid(8, 12);
    border: 1px solid var(--c-hairline);
    // The face takes .card for its rim and hairline but opts out of the glass
    // backdrop: this pseudo-element is already the inner frame, and a
    // backdrop-filter inside preserve-3d flattens the cube in several engines.
    // The face's own translucent gradient above is what glazes it.
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    filter: none;
    z-index: auto;
  }

  // The wall facing you catches the light; the rest stay flat. Opacity, not
  // a second fill, so it crossfades through the turn.
  .cube__face::after {
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      ellipse 80% 60% at 50% 0%,
      color-mix(in srgb, var(--c-canvas-mid) 50%, transparent),
      transparent 70%
    );
    opacity: 0.25;
    transition: opacity var(--turn);
  }

  // The type is the part that ghosts back instead. Four sets of copy over the
  // same pixels is noise; four sets of edges is a box.
  .cube__label,
  .cube__body {
    opacity: 0.1;
    transition: opacity var(--turn);
  }

  .cube[data-side='front'] .cube__face--front,
  .cube[data-side='right'] .cube__face--right,
  .cube[data-side='back'] .cube__face--back,
  .cube[data-side='left'] .cube__face--left {
    &::after {
      opacity: 1;
    }

    .cube__label,
    .cube__body {
      opacity: 1;
    }
  }

  .cube__face--front {
    transform: rotateY(0deg) translateZ(calc(var(--face) / 2));
  }

  .cube__face--right {
    transform: rotateY(90deg) translateZ(calc(var(--face) / 2));
  }

  .cube__face--back {
    transform: rotateY(180deg) translateZ(calc(var(--face) / 2));
  }

  .cube__face--left {
    transform: rotateY(-90deg) translateZ(calc(var(--face) / 2));
  }

  .cube__label {
    margin: 0;
    color: var(--c-mute);
  }

  // Content sits on the floor of the face; the label holds the ceiling.
  .cube__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: var(--sp-lg);
  }

  // Three faces carry a drawing above their copy. It is the flexible item in a
  // body of fixed ones, so it takes exactly the room the copy leaves and gives
  // it all back when there is none — at a fixed aspect it pushed the last line
  // of prose out through the bottom of the face instead. The drawing is
  // ornament; ornament is what yields.
  .cube__art {
    position: relative;
    align-self: stretch;
    flex: 1 1 0;
    min-height: 0;
    pointer-events: none;
  }

  // Intro is the one face with a companion element: the mark takes the slot
  // the pen gives a portrait. It rides the label row rather than sitting
  // beside the prose — at this face size a side-by-side split leaves the
  // copy in a column too narrow to read.
  .cube__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-lg);
  }

  .cube__prose {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
    // The column is narrow enough that the global hyphens: auto breaks
    // words mid-syllable ("commis-sioned"). Wrap on spaces instead.
    hyphens: manual;
  }

  .cube__lede {
    margin: 0;
    font-size: clamp-fluid(17, 20);
    letter-spacing: var(--ls-5);
    line-height: 1.35;
    color: var(--c-ink);
    text-wrap: balance;
  }

  // Intro alone splits its lede: the sentence in body grey, the name stepping
  // up to ink. The pen holds its key phrase in cyan and accent colour is
  // illustration only here, so the emphasis inverts — brighter, never
  // coloured. Once, on the name. Doing it to every face would be the
  // one-accented-phrase-per-headline tell rather than a signature.
  .cube__face--front .cube__lede {
    color: var(--c-body);

    em {
      font-style: normal;
      color: var(--c-ink);
    }
  }

  .cube__para {
    margin: 0;
    font-size: clamp-fluid(13, 14);
    line-height: 1.5;
    color: var(--c-body);
  }

  // The Intro face carries the most copy. Under 19rem the middle paragraph
  // goes, leaving the lede. Type keeps its size and floors throughout — what
  // changes is how much is said, not how small it is said. Threshold from
  // measurement: at 280px the full copy overruns the face.
  @container cube (width < 19rem) {
    .cube__para--more,
    // Below this the band between label and copy is shorter than the drawing,
    // which would push the prose off the face. Drop it, the way the copy drops.
    .cube__art {
      display: none;
    }

    // Dropping the drawing is not enough on the two fullest faces. On a 273px
    // face (a 390px phone) Intro ran 4px past the bottom padding and Craft 5px,
    // because what is left is measured against a budget written for a 420px
    // face. Padding and gaps are what give next, before any more words do —
    // type keeps its size and floors throughout. clamp-fluid is keyed to the
    // viewport, not the container, so both are already at their floor here and
    // have to be set outright. 14px still clears the ::before inner frame at
    // its own 8px inset, so no copy crosses that hairline.
    .cube__face {
      padding: #{to-rem(14)};
    }

    .cube__body {
      gap: var(--sp-sm);
    }

    // ponytail: this band — a face under 304px, so a viewport under ~378px —
    // is the one place the fit is exact rather than roomy. Above it the
    // drawing is the flexible item and soaks up whatever the copy leaves, so
    // there is visible slack; here the drawing is gone, every remaining item
    // is fixed, and Craft's nine chips land within a couple of pixels of the
    // floor (four rows at a 320px viewport, three at 375px). Nothing clips at
    // any width from 320 up, measured, but a device font that renders the
    // chips wider would wrap one more row and overrun. If that shows up, the
    // upgrade is to drop the trailing chips here the way .cube__para--more
    // drops — the established move on this component is to say less, not to
    // set it smaller.
  }

  // Stack entries as a wrapped row of hairline chips, not a bulleted list:
  // every interactive-looking thing in this system is a pill, and these read
  // as the same family without pretending to be buttons.
  .cube__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-sm);
    margin: 0;
    padding: 0;
    list-style: none;

    // Craft alone carries nine chips, and a narrow face wraps them to four
    // rows — five at the 320px floor, where they ran 13px past the padding.
    // The chips' own horizontal padding is what puts them there, as it is on
    // the nav pills above: 8px instead of 12px. The rows then close up to 4px
    // between them, which is the last 16px, while the 8px between chips in a
    // row stays — a dense block of chips still reads as rows, and this is the
    // floor case, not the common one. Nothing here drops a word or a type
    // size; all nine chips survive to 320px.
    //
    // Nested here rather than in the @container block above, which is where
    // the rest of the small-face rules live: that block sits earlier in the
    // file than this one, and at equal specificity the later rule wins — a
    // `row-gap` there loses to this `gap` shorthand, silently. Nesting makes
    // the override order-proof.
    @container cube (width < 19rem) {
      row-gap: var(--sp-xs);
    }

    li {
      padding: var(--sp-xs) var(--sp-md);
      border: 1px solid var(--c-hairline-bright);
      border-radius: var(--r-pill);
      color: var(--c-body);

      @container cube (width < 19rem) {
        padding-inline: var(--sp-sm);
      }
    }
  }

  .cube__time,
  .cube__addr {
    margin: 0;
    color: var(--c-body);
  }

  // .micro uppercases; an address is not a label and should read as typed.
  .cube__addr {
    text-transform: none;
  }

  // The W mark, bare, in the slot the reference gives a portrait. It keeps
  // the disc's footprint so the label row's height does not change.
  .cube__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp-fluid(52, 72);
    height: clamp-fluid(52, 72);
    color: var(--c-ink);

    svg {
      width: to-rem(28);
      height: to-rem(28);
      fill: currentColor;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    // Fewer and gentler, not none. The 3D turn goes; the crossfade stays, so
    // a face swap reads as a change rather than a teleport.
    .cube {
      transition: none;
    }

    .cube__face::after,
    .cube__label,
    .cube__body {
      transition: opacity 0.2s var(--ease-out-expo);
    }
  }

  // BACKGROUND — a globe and the places behind the work. Two columns on wide
  // screens, globe first on narrow ones so the section still opens on the
  // thing that makes it worth stopping for.
  .background {
    margin-block: var(--sp-band);
  }

  .background__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-lg);
    margin-bottom: clamp-fluid(32, 56);
  }

  .background__filter {
    display: flex;
    gap: var(--sp-sm);
  }

  // Outline pills throughout — the page's one filled pill is spent on the
  // hero's Email me. Same pressed treatment as the cube's face nav.
  .background__btn[aria-pressed='true'] {
    border-color: var(--c-ink);
    background-color: color-mix(in srgb, var(--c-ink) 6%, transparent);
  }

  .background__body {
    display: grid;
    gap: clamp-fluid(40, 80);
    align-items: center;

    @media (min-width: 769px) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .background__globe {
    position: relative;
    // Square, and capped so it never outgrows the copy beside it.
    width: min(100%, #{to-rem(480)});
    aspect-ratio: 1;
    justify-self: center;
  }

  // Place labels pinned to their marker. COBE exposes an anchor name and a
  // 0–1 visibility value per marker id; --v carries that value in from the
  // inline style so opacity and blur can both read it. A pin rotating behind
  // the globe fades and blurs out rather than clipping.
  //
  // Anchor positioning is Chromium-only for now. Elsewhere the whole block
  // is skipped and the labels stay hidden — no loss, since every place is
  // already named in the list beside the globe.
  .globe__label {
    display: none;
  }

  @supports (position-anchor: --a) {
    .globe__label {
      position: absolute;
      bottom: anchor(top);
      left: anchor(center);
      display: block;
      translate: -50% #{to-rem(-8)};
      padding: var(--sp-xxs) var(--sp-sm);
      border: 1px solid var(--c-hairline-bright);
      border-radius: var(--r-pill);
      background: var(--c-canvas-card);
      color: var(--c-body);
      white-space: nowrap;
      pointer-events: none;
      opacity: var(--v);
      filter: blur(calc((1 - var(--v)) * #{to-rem(8)}));
      transition:
        opacity 0.3s var(--ease-out-expo),
        filter 0.3s var(--ease-out-expo);
    }

    @media (prefers-reduced-motion: reduce) {
      .globe__label {
        filter: none;
        transition: opacity 0.2s var(--ease-out-expo);
      }
    }

    // Phones fall back to the same no-label state as non-Chromium. A label is
    // centred on its marker and never wraps, so one pinned near the globe's
    // edge hangs half its width past it — up to 60px. On desktop the globe is
    // one of two columns and that lands in the gutter; on a phone the globe
    // spans the column, so the pill is cut off by the viewport instead. Every
    // place is already named in the list below, which is why this is no loss.
    @media (max-width: 768px) {
      .globe__label {
        display: none;
      }
    }
  }

  // COBE v2 inserts its own unclassed wrapper around the canvas. Scoped to
  // the div, not `> *` — the label spans are siblings and must stay
  // shrink-to-fit.
  .background__globe > div {
    display: block;
    width: 100%;
    height: 100%;
  }

  .globe {
    display: block;
    width: 100%;
    height: 100%;
    // Until WebGL initialises the canvas is transparent; nothing to hide.
    contain: layout paint;
  }

  .background__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  // Hairline between rows, none above the first: the rule separates, it does
  // not frame.
  // [hidden] must be restated: the UA rule loses to the author display below.
  .background__row[hidden],
  .globe__label[hidden] {
    display: none;
  }

  .background__row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'place years'
      'org org'
      'role role';
    gap: var(--sp-xs) var(--sp-lg);
    padding-block: var(--sp-xl);

    // Adjacency has to skip filtered-out rows, or the first visible row
    // draws a rule above itself with nothing on the other side of it.
    &:not([hidden]) + &:not([hidden]) {
      border-top: 1px solid var(--c-hairline);
    }
  }

  .background__place {
    grid-area: place;
    margin: 0;
    color: var(--c-mute);
  }

  .background__years {
    grid-area: years;
    margin: 0;
    color: var(--c-mute);
    white-space: nowrap;
  }

  .background__org-line {
    grid-area: org;
    display: flex;
    align-items: center;
    gap: var(--sp-sm);
  }

  .background__org {
    margin: 0;
    font-size: var(--fs-5);
    letter-spacing: var(--ls-5);
    line-height: 1.3;
    color: var(--c-ink);
  }

  .background__role {
    grid-area: role;
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--c-body);
  }

  .background__website {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: var(--sp-xl);
    height: var(--sp-xl);
    color: var(--c-body);
    text-decoration: none;

    &::after {
      position: absolute;
      inset: calc(var(--sp-sm) * -1) calc(var(--sp-md) * -1);
      content: '';
    }

    @include has-hover {
      &:hover {
        color: var(--c-ink);
      }
    }
  }

  .background__website-icon {
    width: var(--sp-lg);
    height: var(--sp-lg);
    background-color: currentColor;
    mask: url('/external-link.png') center / contain no-repeat;
  }

  .hero__headline {
    margin: 0;
    max-width: 16ch;
    color: var(--c-ink);
    // The cube column is wider than the card it replaced, and the global
    // hyphens: auto starts breaking words mid-headline at display sizes.
    // Display type in this system never hyphenates; it wraps on spaces.
    hyphens: manual;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-md);
    margin-top: var(--sp-sm);
  }

  .hero__cue {
    justify-self: end;
    align-self: end;
    color: var(--c-body);
    display: inline-flex;
    align-items: center;
    gap: to-rem(8);
  }

  // On a phone the cue sits under a full-width cube, and hard right put it
  // in the cube's bottom corner with nothing to balance it. Centred, it reads
  // as what it is: the instruction for the whole column, not a corner note.
  @media (max-width: 768px) {
    .hero__cue {
      justify-self: center;
    }
  }

  // SELECTED WORK — title block only. Cards intentionally absent (curtainsjs
  // alignment bug, see Canvas.astro). Holds the page section anchor for
  // future content.
  .work {
    // The hero is positioned and scales to 1.5x on exit (see zoom handoff
    // script); without a stacking order it would paint over this section.
    position: relative;
    z-index: 1;
    margin-block: clamp-fluid(80, 160) clamp-fluid(80, 160);
    display: flex;
    flex-direction: column;
    gap: clamp-fluid(40, 80);
  }

  .work__header {
    display: flex;
    flex-direction: column;
    gap: to-rem(16);
  }

  .work__header .label {
    color: var(--c-mute);
  }

  .work__title-block {
    color: var(--c-ink);
  }

  .work__years {
    color: var(--c-mute);
  }

  // GALLERY — 2-col on desktop, 1-col on mobile. Each tile is animated in
  // via the inline <script> at the bottom of this file (GSAP ScrollTrigger).
  // Initial state (rotated, translated, hidden) is applied in JS to avoid
  // a flash of un-animated content before GSAP's first set() runs; ensure
  // gsap.set fires before paint by importing in a module script.
  .gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp-fluid(32, 64);
  }

  .gallery__item {
    width: 100%;

    @media (min-width: 769px) {
      // calc(50% - half-gap) so two items fit per row with the flex gap.
      width: calc(50% - clamp-fluid(16, 32));
    }

    // Off-row offset reinforces the staggered, editorial feel from the
    // ScrollTrigger entrance.
    @media (min-width: 769px) {
      &:nth-child(even) {
        margin-top: clamp-fluid(40, 80);
      }
    }
  }

  // The figure is the click target (role=button from workTransition.ts), not
  // the <li>, so the list keeps its semantics.
  .gallery__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: to-rem(12);
    cursor: pointer;

    &:focus-visible {
      outline: 1px solid var(--c-ink);
      outline-offset: to-rem(4);
    }
  }

  .gallery__img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background-color: var(--c-canvas-card);
    display: block;
    // GSAP-driven entrance, no CSS transition.
    will-change: transform, opacity;
  }

  .gallery__caption {
    display: flex;
    flex-direction: column;
    gap: to-rem(4);
  }

  .gallery__title {
    color: var(--c-ink);
    letter-spacing: 0;
    font-size: clamp-fluid(14, 16);
    font-weight: var(--fw-regular);
    margin: 0;
  }

  .gallery__sub {
    color: var(--c-body);
