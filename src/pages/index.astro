<script>
  // Background globe — COBE (5kB, vanilla, no deps). The light globe from the
  // library's own homepage: dark: 0, a pale base, white markers, and the glow
  // pulled right down so it does not halo against the near-black canvas. A
  // globe is illustration, which is the one place DESIGN.md allows this
  // system light and glow at all.
  //
  // v2 has no onRender and runs no loop of its own — you drive it by calling
  // update(). That is the better shape here anyway: the globe is built on
  // first intersection so WebGL init stays off the critical path, and it only
  // spins while the section is actually on screen.
  import createGlobe from 'cobe';

  const globeCanvas = document.querySelector<HTMLCanvasElement>('[data-globe]');
  if (globeCanvas) {
    type Pin = { id: string; kind: string; location: [number, number] };
    const pins: Pin[] = JSON.parse(globeCanvas.dataset.markers || '[]');
    // id becomes COBE's --cobe-{id} anchor name, which the labels hang off.
    const markersFor = (kind: string) =>
      pins
        .filter((pin) => pin.kind === kind)
        .map(({ id, location }) => ({ id, location, size: 0.06 }));
    let kind = 'work';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // devicePixelRatio below multiplies this, so pass CSS pixels — doubling
    // here too would render a 4x buffer for a 2x screen.
    const px = () => globeCanvas.offsetWidth;

    let globe: ReturnType<typeof createGlobe> | null = null;
    let phi = 0;
    let raf = 0;

    const tick = () => {
      phi += 0.0025;
      globe?.update({ phi });
      raf = requestAnimationFrame(tick);
    };

    const build = () => {
      globe = createGlobe(globeCanvas, {
        devicePixelRatio: 2,
        width: px(),
        height: px(),
        phi: 0,
        // Tilted so the northern hemisphere reads rather than the equator.
        theta: 0.25,
        dark: 0,
        diffuse: 1.2,
        scale: 1,
        mapSamples: 16000,
        mapBrightness: 6,
        baseColor: [0.72, 0.73, 0.75],
        // Near-black markers, not white: on a pale globe a white dot is
        // invisible. This is the canvas colour punched back through the
        // illustration, so the pins read as the page marking the sphere.
        markerColor: [0.04, 0.04, 0.04],
        glowColor: [0.14, 0.15, 0.16],
        markers: markersFor(kind),
      });
      new ResizeObserver(() =>
        globe?.update({ width: px(), height: px() }),
      ).observe(globeCanvas);
    };

    new IntersectionObserver(
      ([entry]) => {
        if (!globe && entry.isIntersecting) build();
        cancelAnimationFrame(raf);
        // Reduced motion holds the globe still; the markers still read.
        if (entry.isIntersecting && !reduce) raf = requestAnimationFrame(tick);
      },
      { rootMargin: '200px' },
    ).observe(globeCanvas);

    // Worked / Studied. One switch drives all three views of the same data:
    // the rows, the floating labels, and the pins on the globe. No animation
    // on the swap — a filter's job is to show the answer, not to travel.
    const filters =
      document.querySelectorAll<HTMLButtonElement>('.background__btn');
    const rows = document.querySelectorAll<HTMLElement>('.background__row');
    const labels = document.querySelectorAll<HTMLElement>('.globe__label');

    const show = (next: string) => {
      kind = next;
      rows.forEach((el) => (el.hidden = el.dataset.kind !== next));
      labels.forEach((el) => (el.hidden = el.dataset.kind !== next));
      filters.forEach((el) =>
        el.setAttribute('aria-pressed', String(el.dataset.kind === next)),
      );
      globe?.update({ markers: markersFor(next) });
    };

    filters.forEach((btn) =>
      btn.addEventListener('click', () => show(btn.dataset.kind!)),
    );
  }
</script>


<script>
  // Zoom handoff, after Giana's "zoom scroll" (codepen.io/giana/pen/BabdgjB)
  // minus the scroll-snap, which Lenis fights. The hero scales up, blurs and
  // fades as it leaves; the Selected Work header zooms in from small behind
  // it. Scrubbed to scroll through the Lenis-driven ticker in scroll.ts.
  // Targets are wrappers, not the [data-inview*] children: those carry a CSS
  // transition on filter/opacity/transform that would lag a scrubbed tween.
  import { gsap } from 'gsap';
  import '../scripts/scroll';

  // isPhone pairs with isDesktop so one of the two always matches — see the
  // gallery script above for why a gap here silences the whole callback.
  gsap.matchMedia().add(
    {
      isDesktop: '(min-width: 769px)',
      isPhone: '(max-width: 768px)',
      reduceMotion: '(prefers-reduced-motion: reduce)',
    },
    (ctx) => {
      const { isDesktop, reduceMotion } = ctx.conditions as Record<
        string,
        boolean
      >;
      if (reduceMotion) return;

      gsap
        .timeline({
          scrollTrigger: {
            trigger: '.hero',
            start: 'bottom bottom',
            end: 'bottom top',
            scrub: 1,
          },
        })
        .to(
          '.hero',
          {
            // The hero is capped at 1200px and centred, so on desktop the
            // zoom grows into its own gutters. On a phone it already spans
            // the viewport, and 1.5 would put 90px past each edge for the
            // whole length of the handoff — the fade carries it there.
            scale: isDesktop ? 1.5 : 1,
            opacity: 0,
            ease: 'power1.in',
          },
          0,
        )
        // Blur only the type; blurring the WebGL canvas every frame is costly.
        .to('.hero__center', { filter: 'blur(16px)', ease: 'power1.in' }, 0);

      // Scales up to 1 from a left origin, so it never reaches past the edge.
      gsap.from('.work__header', {
        scale: 0.6,
        opacity: 0,
        filter: 'blur(16px)',
        transformOrigin: '0% 50%',
        ease: 'power1.out',
        scrollTrigger: {
          trigger: '.work__header',
          start: 'top bottom',
          end: 'top 40%',
          scrub: 1,
        },
      });
    },
  );
</script>

<script>
  // Scroll-stand: each stand's cards start fanned in 3D and flatten into a
  // row as the section enters the viewport. Heading words stagger color
  // from white → muted. Scrubbed to scroll position via the Lenis-driven
  // GSAP ticker wired in src/scripts/scroll.ts.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import '../scripts/scroll';

  // Read live design tokens so palette tweaks in _vars.scss flow through.
  const css = getComputedStyle(document.documentElement);
  const cLight = css.getPropertyValue('--c-ink').trim() || '#ffffff';
  const cMuted = css.getPropertyValue('--c-mute').trim() || '#7d8187';

  // Per-card initial 3D state — centre card is most vertical, edges fan out.
  // Derived from position rather than a fixed table: the stands no longer hold
  // the same number of cards, and indexing a five-entry table with four cards
  // fanned them lopsided. For five this reproduces the original values
  // (rotateX 58/74/90/74/58, rotateY +18/+5/0/-5/-18, y 48/32/18/32/48).
  const cardStart = (i: number, n: number) => {
    const t = n < 2 ? 0 : (i / (n - 1)) * 2 - 1; // -1 left edge … 1 right edge
    const a = Math.abs(t);
    return {
      rotateX: 90 - 32 * a,
      rotateY: -18 * Math.sign(t) * a ** 1.85,
      y: 18 + 30 * a,
    };
  };

  gsap
    .matchMedia()
    .add(
      { isDesktop: '(min-width: 769px)', isPhone: '(max-width: 768px)' },
      (ctx) => {
        const { isDesktop } = ctx.conditions as Record<string, boolean>;

        document.querySelectorAll<HTMLElement>('.stand').forEach((section) => {
          // Phones lay the cards out as a flat 2-up grid with no perspective, so
          // there is no fan to flatten — the copy and the heading still move.
          // On desktop, narrow viewports hide the outer cards, and a hidden card
          // must not take a slot in the fan or the visible ones sit lopsided.
          // offsetParent is null for `display: none`, which is what CSS dropped.
          const cards = isDesktop
            ? [...section.querySelectorAll<HTMLElement>('.stand__card')].filter(
                (card) => card.offsetParent !== null,
              )
            : [];
          const copy = section.querySelector<HTMLElement>('.stand__copy');
          const words = section.querySelectorAll<HTMLElement>(
            '.stand__heading .word',
          );

          cards.forEach((card, i) => {
            gsap.set(card, {
              ...cardStart(i, cards.length),
              transformOrigin: '50% 100%',
              transformPerspective: 1560,
            });
          });

          if (copy) gsap.set(copy, { y: -10 });
          gsap.set(words, { color: cLight });

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: section,
              start: 'top 40%',
              end: 'top 0%',
              scrub: 1,
            },
          });

          if (cards.length) {
            tl.to(
              cards,
              {
                rotateX: 0,
                rotateY: 0,
                y: 0,
                ease: 'power1.inOut',
                duration: 1,
              },
              0,
            );
          }

          tl.to(copy, { y: 0 }, 0).to(
            words,
            { color: cMuted, stagger: 0.2 },
            0.1,
          );
        });
      },
    );
</script>

<script>
  // Section 02's two figures roll up as the section arrives.
  //
  // The mechanic is Splash.astro's, not a second opinion: tween a plain
  // { value } proxy and write the number in onUpdate, 1.4s on power4.out —
  // "quick off the mark, then a settle you can read the last few digits
  // through", as the comment there puts it. Matching it means the page has
  // one counter behaviour rather than two that nearly agree.
  //
  // Math.round, not toFixed: the tween's final frame lands on 7.999… as often
  // as on 8, and a portfolio that reads "7" for one frame is worse than no
  // animation. The tween is also set to its end value on complete, so the
  // displayed figure is the authored one and not whatever the last frame was.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import '../scripts/scroll';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.intro__stat').forEach((stat, i) => {
    const out = stat.querySelector<HTMLElement>('[data-stat-value]');
    const text = stat.querySelector<HTMLElement>('[data-stat-text]');
    const label = stat.querySelector<HTMLElement>('.intro__statlabel');
    const end = Number(stat.dataset.stat ?? 0);
    const suffix = stat.dataset.suffix ?? '';

    // A status has nothing to count up to: it rises with its label, on the
    // same trigger and the same stagger slot as the figures either side.
    if (text) {
      if (reduced) return;
      gsap
        .timeline({
          scrollTrigger: { trigger: stat, start: 'top 85%', once: true },
        })
        .from(
          [text, label],
          { y: 14, opacity: 0, duration: 0.6, ease: 'power3.out', stagger: 0.1 },
          i * 0.12,
        );
      return;
    }
    if (!out) return;

    const write = (v: number) => (out.textContent = `${Math.round(v)}${suffix}`);

    // Fewer and gentler, not none: the figure is simply there and the label
    // fades, the same fallback Splash uses.
    if (reduced) {
      write(end);
      return;
    }

    const proxy = { value: 0 };
    gsap
      .timeline({
        scrollTrigger: { trigger: stat, start: 'top 85%', once: true },
      })
      .to(
        proxy,
        {
          value: end,
          duration: 1.4,
          ease: 'power4.out',
          onUpdate: () => write(proxy.value),
          // Belt and braces against a last frame that never quite arrives.
          onComplete: () => write(end),
        },
        i * 0.12,
      )
      .from(
        label,
        { y: 14, opacity: 0, duration: 0.6, ease: 'power3.out' },
        i * 0.12 + 0.1,
      );
  });
</script>

<style lang="scss">
  // HERO — the front door: who, what, where, one way to reach out.
  // Three rows: top label, centered headline + proof + pills, bottom cue.
  // No imagery; a mesh gradient in the canvas greys (HeroGradient) behind the type.
  // 4rem subtracts the Header's vertical footprint (padding-block 1.25rem × 2
  // + ~1rem label content ≈ 3.5rem, rounded to 4rem) so the cue sits inside
  // the viewport instead of below the fold.
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100svh - 4rem);
    // Matches .container so the hero lines up with the header above it.
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: to-rem(24) var(--grid-margin) to-rem(40);
  }

  // Full-bleed: the hero is container-width, but the backdrop runs edge to
  // edge, under the type. It also reaches up behind the (transparent) Header:
  // 68px = its 44px rail + 12px padding either side.
  .hero__gradient {
    --header-h: #{to-rem(68)};
    position: absolute;
    inset: 0 auto;
    top: calc(-1 * var(--header-h));
    left: 50%;
    width: 100vw;
    height: calc(100% + var(--header-h));
    transform: translateX(-50%);
    z-index: -1;

    // Dark washes over the left half, where the copy sits, and the top strip,
    // where the header sits, so the white in the sphere blooms lower right and
    // the type keeps its contrast. A bottom wash dissolves the canvas into the
    // page so the hero has no hard edge against the next section.
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(0deg, var(--c-canvas) 0%, transparent 28%),
        linear-gradient(
          180deg,
          var(--c-canvas) 0%,
          color-mix(in srgb, var(--c-canvas) 60%, transparent) 12%,
          transparent 30%
        ),
        linear-gradient(
          90deg,
          var(--c-canvas) 0%,
          color-mix(in srgb, var(--c-canvas) 70%, transparent) 40%,
          transparent 75%
        );
    }
  }

  // Body, not mute: the gradient lifts the backdrop past what mute can sit on.
  .hero__index {
    color: var(--c-body);
  }

  // One column. This was a two-column grid with the cube in the right-hand
  // track and a $cube-aside: 1060px breakpoint to collapse it; the cube now
  // has its own section, so the track, the breakpoint and the variable are all
  // gone and the hero is a headline over two pills.
  .hero__center {
    display: grid;
    align-items: center;
    gap: clamp-fluid(40, 80);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: clamp-fluid(20, 40);
  }

  // BACKGROUND — a globe and the places behind the work. Two columns on wide
  // screens, globe first on narrow ones so the section still opens on the
  // thing that makes it worth stopping for.
  .background {
    margin-block: var(--sp-band);
  }

  .background__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-lg);
    margin-bottom: clamp-fluid(32, 56);
  }

  .background__filter {
    display: flex;
    gap: var(--sp-sm);
  }

  // Outline pills throughout — the page's one filled pill is spent on the
  // hero's Email me. Same pressed treatment as the cube's face nav.
  .background__btn[aria-pressed='true'] {
    border-color: var(--c-ink);
    background-color: color-mix(in srgb, var(--c-ink) 6%, transparent);
  }

  .background__body {
    display: grid;
    gap: clamp-fluid(40, 80);
    align-items: center;

    @media (min-width: 769px) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .background__globe {
    position: relative;
    // Square, and capped so it never outgrows the copy beside it.
    width: min(100%, #{to-rem(480)});
    aspect-ratio: 1;
    justify-self: center;
  }

  // Place labels pinned to their marker. COBE exposes an anchor name and a
  // 0–1 visibility value per marker id; --v carries that value in from the
  // inline style so opacity and blur can both read it. A pin rotating behind
  // the globe fades and blurs out rather than clipping.
  //
  // Anchor positioning is Chromium-only for now. Elsewhere the whole block
  // is skipped and the labels stay hidden — no loss, since every place is
  // already named in the list beside the globe.
  .globe__label {
    display: none;
  }

  @supports (position-anchor: --a) {
    .globe__label {
      position: absolute;
      bottom: anchor(top);
      left: anchor(center);
      display: block;
      translate: -50% #{to-rem(-8)};
      padding: var(--sp-xxs) var(--sp-sm);
      border: 1px solid var(--c-hairline-bright);
      border-radius: var(--r-pill);
      background: var(--c-canvas-card);
      color: var(--c-body);
      white-space: nowrap;
      pointer-events: none;
      opacity: var(--v);
      filter: blur(calc((1 - var(--v)) * #{to-rem(8)}));
      transition:
        opacity 0.3s var(--ease-out-expo),
        filter 0.3s var(--ease-out-expo);
    }

    @media (prefers-reduced-motion: reduce) {
      .globe__label {
        filter: none;
        transition: opacity 0.2s var(--ease-out-expo);
      }
    }

    // Phones fall back to the same no-label state as non-Chromium. A label is
    // centred on its marker and never wraps, so one pinned near the globe's
    // edge hangs half its width past it — up to 60px. On desktop the globe is
    // one of two columns and that lands in the gutter; on a phone the globe
    // spans the column, so the pill is cut off by the viewport instead. Every
    // place is already named in the list below, which is why this is no loss.
    @media (max-width: 768px) {
      .globe__label {
        display: none;
      }
    }
  }

  // COBE v2 inserts its own unclassed wrapper around the canvas. Scoped to
  // the div, not `> *` — the label spans are siblings and must stay
  // shrink-to-fit.
  .background__globe > div {
    display: block;
    width: 100%;
    height: 100%;
  }

  .globe {
    display: block;
    width: 100%;
    height: 100%;
    // Until WebGL initialises the canvas is transparent; nothing to hide.
    contain: layout paint;
  }

  .background__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  // Hairline between rows, none above the first: the rule separates, it does
  // not frame.
  // [hidden] must be restated: the UA rule loses to the author display below.
  .background__row[hidden],
  .globe__label[hidden] {
    display: none;
  }

  .background__row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'place years'
      'org org'
      'role role';
    gap: var(--sp-xs) var(--sp-lg);
    padding-block: var(--sp-xl);

    // Adjacency has to skip filtered-out rows, or the first visible row
    // draws a rule above itself with nothing on the other side of it.
    &:not([hidden]) + &:not([hidden]) {
      border-top: 1px solid var(--c-hairline);
    }
  }

  .background__place {
    grid-area: place;
    margin: 0;
    color: var(--c-mute);
  }

  .background__years {
    grid-area: years;
    margin: 0;
    color: var(--c-mute);
    white-space: nowrap;
  }

  .background__org-line {
    grid-area: org;
    display: flex;
    align-items: center;
    gap: var(--sp-sm);
  }

  .background__org {
    margin: 0;
    font-size: var(--fs-5);
    letter-spacing: var(--ls-5);
    line-height: 1.3;
    color: var(--c-ink);
  }

  .background__role {
    grid-area: role;
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--c-body);
  }

  .background__website {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: var(--sp-xl);
    height: var(--sp-xl);
    color: var(--c-body);
    text-decoration: none;

    &::after {
      position: absolute;
      inset: calc(var(--sp-sm) * -1) calc(var(--sp-md) * -1);
      content: '';
    }

    @include has-hover {
      &:hover {
        color: var(--c-ink);
      }
    }
  }

  .background__website-icon {
    width: var(--sp-lg);
    height: var(--sp-lg);
    background-color: currentColor;
    mask: url('/external-link.png') center / contain no-repeat;
  }

  .hero__headline {
    margin: 0;
    max-width: 16ch;
    color: var(--c-ink);
    // The cube column is wider than the card it replaced, and the global
    // hyphens: auto starts breaking words mid-headline at display sizes.
    // Display type in this system never hyphenates; it wraps on spaces.
    hyphens: manual;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-md);
    margin-top: var(--sp-sm);
  }

  // Centred at every width. Hard right parked it in the cube's bottom corner
  // with nothing to balance it; centred, it reads as what it is — the
  // instruction for the whole column, not a corner note.
  .hero__cue {
    justify-self: center;
    align-self: end;
    color: var(--c-body);
    display: inline-flex;
    align-items: center;
    gap: to-rem(8);
  }

  // Stretched to the row and spread: the card pins to the top, level with
  // the pill row, and the figures drop to the bottom, level with the cube's
  // bottom edge. Whatever height the cube lands at, the gap between the two
  // absorbs it — no number to keep in step with --face. Below the two-column
  // breakpoint the column is a plain stack and the spread is inert.
  .intro__aside {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-self: stretch;
    gap: clamp-fluid(28, 44);
    // Figures size themselves to this column (see .intro__figure), so it has
    // to be a container.
    container-type: inline-size;

    // Row 2 only above the two-column threshold. Below it the grid is one
    // column and the cube block already spans rows 1-2, so this auto-places
    // into row 3 underneath it — pinning it to 2 there would collide.
    @media (min-width: 1024px) {
      grid-column: 2;
      grid-row: 2;
    }

    // Stacked under the cube, the figures come first and the wiring last:
    // the numbers are the quicker read, and the diagram is a better thing to
    // end the section on than to interrupt it with. `order` moves the
    // figures visually only — neither block is interactive, so there is no
    // tab order to put out of step with the DOM.
    @media (max-width: 1023px) {
      .intro__stats {
        order: -1;
      }
    }
  }

  .intro__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp-fluid(32, 72);
    margin: 0;

    // One line beside the cube, always. The figures scale to the column
    // (below), so three of them fit at any column width the two-column
    // layout can produce; spread rather than packed, so the row reads as
    // the width of the column and not as three things huddled left.
    @media (min-width: 1024px) {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: var(--sp-lg);
    }

    // Stacked under a centred cube and above a centred wiring diagram, the
    // figures centre too — and so does the text inside each, or a centred
    // row of left-aligned pairs reads as slightly off.
    @media (max-width: 1023px) {
      justify-content: center;
    }
  }

  .intro__stat {
    display: flex;
    flex-direction: column;
    gap: to-rem(4);

    @media (max-width: 1023px) {
      align-items: center;
      text-align: center;
    }
  }

  // Display scale, weight 400 — DESIGN.md never bolds, and the size plus the
  // negative tracking is what carries the emphasis instead.
  .intro__figure {
    margin: 0;
    // Sized to the column, not the viewport. "TH · MM" is ~3.5 characters
    // wider than "8", and three figures have to share whatever width the
    // right column has — 9cqi lands at ~72px on a wide column and shrinks
    // with it, so the row never wraps above the two-column threshold. The
    // floor is what a phone's single column gets.
    font-size: clamp(#{to-rem(40)}, 9cqi, #{to-rem(72)});
    font-weight: var(--fw-regular);
    line-height: 1;
    letter-spacing: var(--ls-2);
    color: var(--c-ink);
    // The number changes width as it rolls (0 → 8, 0+ → 20+) and a
    // proportional face would shuffle the label under it on every frame.
    font-variant-numeric: tabular-nums;
  }

  .intro__statlabel {
    color: var(--c-body);
  }

  // INTRODUCTION — section 02. Two panels side by side: the cube, and the
  // stack wired into the mark. The cube used to sit in the hero's right
  // column; it has a section of its own now so the hero can be a headline
  // over two pills.
  .intro {
    // The hero scales to 1.5x and fades on exit (see the zoom handoff script)
    // and overflows its own box while it does; without a stacking order it
    // paints over this section and the scroll cue ghosts through the cube.
    // .work carries the same pair for the same reason.
    position: relative;
    z-index: 1;
    margin-block: var(--sp-band);
    display: flex;
    flex-direction: column;
    gap: clamp-fluid(32, 56);
  }

  .intro__header .label {
    color: var(--c-mute);
  }

  // `auto 1fr`, not two equal halves: the cube's width is set by its --face
  // expression and will not compress, so giving it a share of the row would
  // either overflow the column or starve the beams. The card takes what is
  // left, which is the track that can actually flex.
  // Two rows, not one. The cube block subgrids its rows (see IntroCube), so
  // its pill nav lands in row 1 and the cube itself in row 2 — which lets
  // the right column be placed in row 2 and start level with the cube's top
  // edge rather than with the pills. That is the only way to align to a
  // child of another component without measuring it.
  //
  // The row gap is the nav-to-cube gap the block used to own; a subgrid
  // takes its gutters from here.
  .intro__grid {
    display: grid;
    column-gap: clamp-fluid(32, 56);
    row-gap: var(--sp-xl);
    align-items: start;

    @media (min-width: 1024px) {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }
  }

  // SELECTED WORK — title block only. Cards intentionally absent (curtainsjs
  // alignment bug, see Canvas.astro). Holds the page section anchor for
  // future content.
  .work {
    // The hero is positioned and scales to 1.5x on exit (see zoom handoff
    // script); without a stacking order it would paint over this section.
    position: relative;
    z-index: 1;
    margin-block: clamp-fluid(80, 160) clamp-fluid(80, 160);
    display: flex;
    flex-direction: column;
    gap: clamp-fluid(40, 80);
  }

  .work__header {
    display: flex;
    flex-direction: column;
    gap: to-rem(16);
  }

  .work__header .label {
    color: var(--c-mute);
  }

  .work__title-block {
    color: var(--c-ink);
  }

  .work__years {
    color: var(--c-mute);
  }

  // GALLERY — 2-col on desktop, 1-col on mobile. Each tile is animated in
  // via the inline <script> at the bottom of this file (GSAP ScrollTrigger).
  // Initial state (rotated, translated, hidden) is applied in JS to avoid
  // a flash of un-animated content before GSAP's first set() runs; ensure
  // gsap.set fires before paint by importing in a module script.
  .gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp-fluid(32, 64);
  }

  .gallery__item {
    width: 100%;

    @media (min-width: 769px) {
      // calc(50% - half-gap) so two items fit per row with the flex gap.
      width: calc(50% - clamp-fluid(16, 32));
    }

    // Off-row offset reinforces the staggered, editorial feel from the
    // ScrollTrigger entrance.
    @media (min-width: 769px) {
      &:nth-child(even) {
        margin-top: clamp-fluid(40, 80);
      }
    }
  }

  // The figure is the click target (role=button from workTransition.ts), not
  // the <li>, so the list keeps its semantics.
  .gallery__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: to-rem(12);
    cursor: pointer;

    &:focus-visible {
      outline: 1px solid var(--c-ink);
      outline-offset: to-rem(4);
    }
  }

  .gallery__img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background-color: var(--c-canvas-card);
    display: block;
    // GSAP-driven entrance, no CSS transition.
    will-change: transform, opacity;
  }

  .gallery__caption {
    display: flex;
    flex-direction: column;
    gap: to-rem(4);
  }

  .gallery__title {
    color: var(--c-ink);
    letter-spacing: 0;
    font-size: clamp-fluid(14, 16);
    font-weight: var(--fw-regular);
    margin: 0;
  }

  .gallery__sub {
    color: var(--c-body);
    font-size: clamp-fluid(12, 14);
  }

  // WORK DETAIL — the overlay a gallery card expands into, after Codrops'
  // image-to-content transition (see src/scripts/workTransition.ts). Hidden
  // until opened. The backdrop is the canvas fading over the page; the
  // preview is where the clicked image lands, full height on the left and
  // square like the tiles, capped at half the viewport so the copy keeps a
  // column. Stacks under the sticky header (10): the script fades the header
  // with the backdrop, and keeping it on top means it never pops in front of
  // the image on the last frame of the close.
  .work-detail {
    --preview-w: min(100vh, 50vw);
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9;
    overflow-y: auto;
    overscroll-behavior: contain;

    @media (max-width: 768px) {
      --preview-w: 100vw;
    }
  }

  .work-detail__backdrop {
    position: fixed;
    inset: 0;
    background: var(--c-canvas);
  }

  .work-detail__preview {
    position: fixed;
    top: 0;
    left: 0;
    margin: 0;
    width: var(--preview-w);
    height: 100vh;
    overflow: hidden;
    background: var(--c-canvas-card);

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @media (max-width: 768px) {
      height: 50vh;
    }
  }

  .work-detail__column {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2xl);
    padding: var(--sp-xl) var(--grid-margin) var(--sp-xl)
      calc(var(--preview-w) + var(--sp-4xl));

    @media (max-width: 768px) {
      padding: calc(50vh + var(--sp-xl)) var(--grid-margin) var(--sp-xl);
    }
  }

  .work-detail__back .micro {
    color: var(--c-mute);
  }

  // One group per card; the script marks the open one active.
  .work-detail__group {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-lg);
    margin-block: auto;
    padding-block: var(--sp-2xl);

    &.is-active {
      display: flex;
    }
  }

  .work-detail__eyebrow {
    margin: 0;
    color: var(--c-mute);
  }

  .work-detail__title {
    margin: 0;
    color: var(--c-ink);
  }

  .work-detail__body {
    margin: 0;
    max-width: 40ch;
    color: var(--c-body);
    font-size: var(--fs-body-lg);
    line-height: 1.56;
  }

  .work-detail__group .pill-btn {
    margin-top: var(--sp-sm);
  }

  // CAPABILITIES — 2 "stand" sections whose cards are fanned in 3D
  // perspective and flatten into a row as you scroll. Word color staggers
  // from white → muted gray across each heading reveal.
  .capabilities {
    margin-block: clamp-fluid(120, 200);
  }

  .capabilities__header {
    margin-bottom: clamp-fluid(40, 80);

    .label {
      color: var(--c-mute);
    }
  }

  .stand {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: clamp-fluid(80, 160) clamp-fluid(20, 64);
  }

  .stand__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .stand__copy {
    z-index: 2;
    width: 100%;
    max-width: 36rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: to-rem(20);
    text-align: center;
  }

  .stand__heading {
    font-size: clamp-fluid(40, 80);
    font-weight: var(--fw-regular);
    line-height: 1;
    letter-spacing: var(--ls-2);
    text-align: center;
    margin: 0;
  }

  .stand__heading .word {
    display: inline-block;
    // GSAP animates this from --c-ink → --c-mute with stagger
    // as the stand scrolls into view. Static fallback if JS is disabled.
    color: var(--c-mute);
  }

  .stand__sub {
    font-size: clamp-fluid(14, 16);
    color: var(--c-body);
    max-width: 36ch;
  }

  .stand__cards {
    width: 100%;
    margin-top: clamp-fluid(24, 48);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .stand__stage {
    perspective: 1560px;
    perspective-origin: 50% 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.5vw;
    transform-style: preserve-3d;
    width: 100%;
  }

  .stand__card {
    --card-w: 17vw;
    --card-h: 22vw;

    width: var(--card-w);
    height: var(--card-h);
    flex-shrink: 0;
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
    border-radius: var(--r-sm); // sharp corners per DESIGN.md §7
    overflow: hidden;
    background-color: var(--c-canvas-card);
    will-change: transform;

    // The plain portrait image of the Websites stand. Direct child, so the
    // images inside a Product & UI mock take their own treatment below.
    > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      // Real site heroes carry their clients' brand colour, and a light one
      // would punch a hole in the near-black canvas. Mono plus a darken
      // sinks every card to the same value, so the stand reads as one set
      // rather than four unrelated screenshots.
      filter: grayscale(1) brightness(0.62);
    }
  }

  // PRODUCT & UI — no fan. A site is judged as one of a set, so the stand
  // above fans four of them; a product is examined one at a time, so this one
  // puts a single product at a size where the interface is actually readable
  // and lets the rest of the evidence sit quiet underneath. The two stands
  // still share the heading, the sub, and the scroll reveal, which is what
  // keeps them one system rather than two designs.
  // Two products, side by side. Each is a product shown on the two devices it
  // ships on, so the pair of pairs is the section's whole argument: the work
  // is the same system rendered for whatever the person is holding.
  // Columns are 1.55:1, not equal. Matching the two groups on HEIGHT is what
  // makes the row read as one row, and a portrait tablet the same height as a
  // landscape laptop is necessarily much narrower — so equal columns left
  // GaiGai filling barely half of its own, and the pair looked lopsided with
  // a hole in the middle. Weighting the columns to the shapes they hold puts
  // similar slack either side of both.
  .product__heroes {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: clamp-fluid(24, 48);
    align-items: end;
    width: 100%;
    max-width: to-rem(1240);
    margin: clamp-fluid(40, 72) auto 0;
  }

  // The figure stacks: devices, then the caption naming them.
  .product {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin: 0;
  }

  // Devices are bottom-aligned so each pair stands on one surface.
  //
  // Sized as percentages of the COLUMN, not in vw, so the pair holds its
  // proportions at every width with no breakpoint restating them.
  //
  // The two numbers below are tied to the 1.55:1 column ratio above and to
  // each device's own aspect. Height of the laptop group is 84% x 1.55 x
  // (238/400) = 0.775 units; height of the tablet group is 63% x 1 x
  // (292/236) = 0.780. That near-match is the whole point — change a column
  // ratio or a device width and the other numbers have to move with it.
  .product__stage {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
  }

  .product__primary--laptop {
    width: 84%;
    flex: none;
  }

  .product__primary--tablet {
    width: 63%;
    flex: none;
  }

  // Captions on this stand read exactly like a Selected Work card, because a
  // visitor scrolling past has already learned that pattern two sections up:
  // the project name, then one short line under it. The values below mirror
  // .gallery__title / .gallery__sub deliberately — if those change, these
  // should follow.
  //
  // This replaced a mono uppercase .micro label plus a three-clause sentence.
  // The sentence was accurate but it made the hero argue its case in prose,
  // which is the one thing this section does not need to do: the two screens
  // above it are the argument.
  .product__caption {
    display: flex;
    flex-direction: column;
    gap: to-rem(4);
  }

  // The hero's caption is a direct child of the figure and sits under a
  // centred composition; the thumbnails' captions sit left under their own
  // left-aligned frames.
  .product > .product__caption {
    margin-top: clamp-fluid(20, 28);
    text-align: center;
  }

  .product__title {
    color: var(--c-ink);
    font-size: clamp-fluid(14, 16);
    font-weight: var(--fw-regular);
    letter-spacing: 0;
    margin: 0;
  }

  .product__sub {
    color: var(--c-body);
    font-size: clamp-fluid(12, 14);
  }

  // The phone tucks close to its partner so the two read as one object on one
  // surface — but it must never cover the screenshot beside it, which is the
  // evidence the section exists to show.
  //
  // The pull is NOT the same number for both, because the two viewBoxes carry
  // different amounts of dead canvas around their chassis:
  //
  //   laptop  viewBox 400 wide, lid x=34..366  → 8.5% empty each side
  //   tablet  viewBox 236 wide, body x=0..236  → none, the body is the box
  //
  // So -5% on the laptop still leaves the phone ~2% clear of the lid, while
  // the same pull on the tablet lands it directly on the storefront. The
  // tablet's phone therefore sits just off the body instead, which puts the
  // same visible gap beside both products.
  .product__phone {
    width: 17%;
    margin-left: -5%;
    flex: none;
    // Own stacking context, so the phone is unambiguously the nearer object.
    position: relative;
    z-index: 1;
  }

  .product__primary--tablet + .product__phone {
    width: 26%;
    margin-left: 1%;
  }

  // The rest of the evidence: three screens at a size that supports the hero
  // instead of competing with it.
  // Two columns for two screens. A three-column grid holding two items leaves
  // a hole on the right that reads as a missing card.
  .product__more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gutter);
    width: 100%;
    max-width: to-rem(760);
    margin: clamp-fluid(48, 88) auto 0;
    padding: 0;
    list-style: none;
  }

  .product__screen {
    display: flex;
    flex-direction: column;
    gap: to-rem(12);

    img {
      display: block;
      width: 100%;
      height: auto;
      // Matches the source captures and the laptop's screen cut-out, so a
      // thumbnail is the same frame at a smaller size, never a re-crop.
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border: 1px solid var(--c-hairline-bright);
      border-radius: var(--r-sm);
      // Same treatment as DeviceMock's screen: value kept, saturation eased.
      filter: saturate(0.85);
    }

    // Both caption colours clear the 4.5:1 AA floor. --c-mute stays unused on
    // this stand: PRODUCT.md scopes it to non-essential metadata because it
    // measures ~3.5:1 on the canvas, and a client's name under its own screen
    // is the evidence, not metadata.
  }

  @media (max-width: 991px) {
    .stand__card {
      --card-w: 28vw;
      --card-h: 36vw;
    }

    // Five cards at 28vw plus four 0.5vw gaps is 142vw: the row was always
    // 42vw wider than the viewport, so ~21vw was clipped off each side and
    // the outer two cards showed as slivers. Shrinking them to fit instead
    // would need ~17vw each — 64px on a 375px screen, too small to read as
    // an image. Three cards fan and stay legible; the fan script measures
    // the laid-out cards, so it stays symmetric over three.
    .stand__card:nth-child(n + 4) {
      display: none;
    }

  }

  // Phones drop the fan. Three cards at 28vw is 105px each on a 375px screen
  // — an image too small to read, and the perspective that makes the fan work
  // also throws the outer cards past the column. A flat 2-up grid gives each
  // card ~46vw, and a fourth card fills the second row so it has no widow.
  // The fan script sits out this breakpoint, so nothing re-applies a rotate.
  @media (max-width: 768px) {
    .stand__stage {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--grid-gutter);
      perspective: none;
      transform-style: flat;
    }

    .stand__card {
      width: auto;
      height: auto;
      // The 17/22 of the desktop card, kept so the crop does not shift.
      aspect-ratio: 17 / 22;
    }

    // Matches the n+4 rule above on specificity, and wins on source order —
    // a bare `.stand__card { display: block }` does not, so the fourth card
    // stayed hidden and left a widow in the second row.
    .stand__card:nth-child(4) {
      display: block;
    }

    .stand__card:nth-child(n + 5) {
      display: none;
    }

    // Two heroes side by side would give each a ~170px column at 390px, which
    // is not a readable dashboard. Stacked, each gets the full column and the
    // devices inside keep their proportions untouched — the percentages above
    // are column-relative, so nothing about the pair needs restating here.
    .product__heroes {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp-fluid(40, 64);
    }
  }

  // HOW I WORK — four steps on hairline rules. Text only; the process is the
  // proof for a nervous stranger (PRODUCT.md: trust from prospective clients).
  .process {
    margin-block: clamp-fluid(80, 160);
    display: flex;
    flex-direction: column;
    gap: clamp-fluid(40, 80);
  }

  .process__header {
    display: flex;
    flex-direction: column;
    gap: to-rem(16);

    .label {
      color: var(--c-mute);
    }

    h2 {
      max-width: 18ch;
      color: var(--c-ink);
    }
  }

  .process__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--c-hairline);
  }

  .process__step {
    display: grid;
    grid-template-columns: to-rem(64) 1fr;
    grid-template-areas:
      'index title'
      'index body';
    column-gap: var(--grid-gutter);
    row-gap: var(--sp-sm);
    padding-block: var(--sp-xl);
    border-bottom: 1px solid var(--c-hairline);

    @media (min-width: 769px) {
      grid-template-columns: to-rem(64) 1fr 1fr;
      grid-template-areas: 'index title body';
      align-items: baseline;
    }
  }

  .process__index {
    grid-area: index;
    color: var(--c-mute);
  }

  .process__title {
    grid-area: title;
    margin: 0;
    font-size: var(--fs-5);
    letter-spacing: var(--ls-5);
    color: var(--c-ink);
  }

  .process__body {
    grid-area: body;
    margin: 0;
    max-width: 44ch;
    color: var(--c-body);
    font-size: clamp-fluid(14, 16);
    line-height: 1.56;
  }

  // TESTIMONIALS — two recommendations on the .card primitive. Hairline
  // chrome, no shadow; the quote is the only thing at body size.
  .testimonials {
