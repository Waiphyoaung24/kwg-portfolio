---
import '@tabler/core/dist/css/tabler.min.css';
import '../../styles/desk.scss';
import TradingNavigation from '../../components/TradingNavigation.astro';
import iconRefresh from '@tabler/icons/outline/refresh.svg?raw';
import iconPlug from '@tabler/icons/outline/plug-connected.svg?raw';
import iconCoin from '@tabler/icons/outline/coin.svg?raw';
import iconPulse from '@tabler/icons/outline/activity.svg?raw';
import iconHistory from '@tabler/icons/outline/history.svg?raw';
import iconChevron from '@tabler/icons/outline/chevron-down.svg?raw';
import iconExternal from '@tabler/icons/outline/external-link.svg?raw';
import iconLogin from '@tabler/icons/outline/login.svg?raw';
import iconFiles from '@tabler/icons/outline/files.svg?raw';
export const prerender = true;
// Tabler icons ship as raw SVG; mark them decorative for assistive technology.
const icon = (svg: string) => svg.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const logo = '<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M26.2636 20.4752L29.7034 6.2832H22.8238L26.2636 20.4752ZM12.2636 6.2832L17.0473 26.0199H23.9568L19.1731 6.2832H12.2636ZM8.61287 6.28336L1.70337 6.28373L6.48706 26.0203L13.3966 26.02L8.61287 6.28336Z" /></svg>';
const stages = [
  { number: '01', title: 'Observe', detail: 'Completed gold M15 candles. Feed health comes from the observer.', state: 'Feed below' },
  { number: '02', title: 'Research', detail: 'Separate Vibe learning workspace. Bounded gold dispatch still needs production isolation and backend spend enforcement.', state: 'Gold dispatch blocked' },
  { number: '03', title: 'Qualify', detail: 'Batch 2 development is closed. Qualifying observation and trade samples are deferred; evidence remains incomplete.', state: 'Unqualified' },
  { number: '04', title: 'Approve', detail: 'Human approval applies to the exact strategy and evidence before any promotion.', state: 'No candidate' },
  { number: '05', title: 'Run', detail: 'A future approved runner manages eligible trades within fixed limits.', state: 'Unavailable' },
];
---
<!doctype html>
<html lang="en" data-bs-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Browser theme-color metadata cannot resolve a CSS variable. -->
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex" />
    <title>Gold operations - Vault - KWG</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body class="desk">
    <TradingNavigation current="overview" />
    <main class="container-xl desk-main">
      <header class="desk-intro reveal" style="--i: 0" id="trading-content" tabindex="-1">
        <p class="desk-eyebrow"><span class="desk-logo desk-logo--sm" set:html={logo} />KWG / Demo operations</p>
        <h1>Gold operations</h1>
        <p class="desk-lede">Check the demo connection and practice comparing strategy changes.</p>
      </header>

      <section class="desk-hero desk-banner reveal" style="--i: 1" aria-labelledby="operating-title">
        <div>
          <p class="desk-kicker">XAUUSD-VIP · M15 · Automatic trading</p>
          <h2 class="desk-idle-title" id="operating-title">Not available yet</h2>
          <p class="desk-muted m-0">The system does not trade automatically. You can check the feed and review fictional test results here.</p>
        </div>
        <div class="btn-list desk-banner__actions">
          <button class="btn btn-primary" id="refresh" type="button">Refresh feed</button>
          <a class="btn desk-btn" id="sign-in" href="/api/trading/status" hidden><Fragment set:html={icon(iconLogin)} />Sign in to feed</a>
          <a class="btn desk-btn" id="hosted-feed" href="https://waiphyoaung.com/vault/trading" target="_blank" rel="noopener noreferrer" hidden><Fragment set:html={icon(iconExternal)} />Open hosted MT5 dashboard</a>
        </div>
      </section>

      <div class="desk-columns">
        <div class="desk-stack">
          <section class="desk-tile reveal" style="--i: 2" aria-labelledby="feed-title">
            <div class="desk-tile__head"><h2 id="feed-title">Live demo feed</h2><span class="desk-chip" id="feed-state">Checking</span></div>
            <dl class="desk-stats">
              <div><dt><Fragment set:html={icon(iconPlug)} />MT5 connection</dt><dd id="connection">Checking</dd></div>
              <div><dt><Fragment set:html={icon(iconCoin)} />Quote freshness</dt><dd id="freshness">Checking</dd></div>
              <div><dt><Fragment set:html={icon(iconPulse)} />Strategy signal</dt><dd id="signal">Checking</dd></div>
              <div><dt><Fragment set:html={icon(iconHistory)} />Completed history</dt><dd id="history">Checking</dd></div>
            </dl>
            <p class="desk-callout" id="guidance" role="status" aria-live="polite">Connecting to the protected status feed.</p>
            <details class="desk-disclosure">
              <summary>Observation details <Fragment set:html={icon(iconChevron)} /></summary>
              <dl class="desk-stats desk-stats--plain">
                <div><dt>Observer heartbeat</dt><dd id="heartbeat">Unknown</dd></div>
                <div><dt>Latest candle opened</dt><dd id="candle">—</dd></div>
                <div><dt>Quote checked</dt><dd id="tick">—</dd></div>
                <div><dt>Last report</dt><dd id="checked">—</dd></div>
              </dl>
              <p class="desk-muted" id="reason">Waiting for a current report.</p>
            </details>
            <p class="desk-muted small mt-3 mb-0">The MT5 desktop tunnel and this status feed are separate connections. An unavailable feed here does not establish that MT5 disconnected.</p>
          </section>

          <section class="desk-tile reveal" style="--i: 3" aria-labelledby="attempt-title">
            <div class="desk-tile__head"><h2 id="attempt-title">Last manually approved demo trade</h2><span class="desk-chip" id="attempt-state">Unknown</span></div>
            <p class="desk-muted" id="attempt-guidance">No execution report loaded.</p>
            <dl class="desk-stats">
              <div><dt>Direction / size</dt><dd class="desk-num" id="attempt-size">—</dd></div>
              <div><dt>Broker-reconciled net result</dt><dd class="desk-num" id="attempt-result">—</dd></div>
              <div><dt>Entry / stop / target</dt><dd class="desk-num" id="attempt-prices">—</dd></div>
              <div><dt>Closed</dt><dd class="desk-num" id="attempt-closed">—</dd></div>
            </dl>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
              <p class="desk-muted small m-0">One supervised attempt only. This is not an autonomous position inventory, trade history or strategy return.</p>
              <a class="btn desk-btn" href="/vault/trading">Open supervised demo</a>
            </div>
          </section>

          <section class="desk-tile reveal" style="--i: 4" aria-labelledby="workflow-title">
            <div class="desk-tile__head"><h2 id="workflow-title">What is ready?</h2></div>
            <p class="desk-muted">The comparison software works with fictional test data. Real gold AI requests, strategy approval and automatic trading remain unavailable.</p>
            <details class="desk-disclosure">
              <summary>Development stages <Fragment set:html={icon(iconChevron)} /></summary>
              <p class="desk-muted small mt-3">Development checkpoint, October 2, 2026. Not a live qualification report.</p>
              <ol class="desk-stages">
                {stages.map(stage => <li><span class="desk-stages__number">{stage.number}</span><div><h3>{stage.title}</h3><p>{stage.detail}</p></div><span class="desk-chip">{stage.state}</span></li>)}
              </ol>
            </details>
          </section>

          <section class="desk-tile reveal" style="--i: 5" aria-labelledby="review-title">
            <div class="desk-tile__head"><h2 id="review-title">Practice comparison</h2><span class="desk-chip">Fictional results</span></div>
            <p class="desk-muted">This tests the software using made-up market data. The amounts below are not profits or losses on your MT5 account.</p>
            <p class="desk-muted small">Select comparison.json, baseline.json and candidate.json together from one test folder. The original strategy is compared with one proposed filter.</p>
            <div class="btn-list">
              <button class="btn desk-btn" id="choose-reports" type="button"><Fragment set:html={icon(iconFiles)} />Choose three reports</button>
              <button class="btn desk-btn" id="clear-reports" type="button" hidden>Clear review</button>
              <input id="report-files" type="file" accept=".json,application/json" multiple hidden />
            </div>
            <p class="desk-muted small mt-3">Files stay in this browser tab. No upload, model request or order. Up to 8 MiB per file. Leaving this page, clearing or reloading removes the review.</p>
            <p class="desk-callout" id="review-message" role="status" aria-live="polite">Choose your three test reports to see the comparison.</p>
            <div id="review-result" hidden>
              <p id="review-explanation"></p>
              <details class="desk-disclosure">
                <summary>How to read the results <Fragment set:html={icon(iconChevron)} /></summary>
                <ul class="desk-gates">
                  <li>Original = the fixed EMA strategy. Proposed = the same strategy with one filter.</li>
                  <li>Development = the first test portion. Validation = a separate portion used to check the change.</li>
                  <li>Lower, middle and stress use increasingly demanding hypothetical trading costs.</li>
                  <li>A negative difference means the proposed change earned less than the original in that test.</li>
                </ul>
              </details>
              <div class="review-table" role="region" aria-label="Synthetic comparison results" tabindex="0">
                <table>
                  <caption>Fictional net profit in USD. Difference = proposed − original.</caption>
                  <thead><tr><th scope="col">Cost / test portion</th><th scope="col">Original</th><th scope="col">Proposed</th><th scope="col">Difference</th><th scope="col">Trades<br />original / proposed</th></tr></thead>
                  <tbody id="review-rows"></tbody>
                </table>
              </div>
              <h3 class="desk-subhead">What this test proves</h3>
              <p class="desk-muted">The selected report files match and their numbers reconcile. This checks the software, not whether a strategy is ready to trade. No AI request or order was sent.</p>
              <details class="desk-disclosure">
                <summary>What remains before trading <Fragment set:html={icon(iconChevron)} /></summary>
                <ul class="desk-gates" id="review-gates"></ul>
              </details>
              <details class="desk-disclosure">
                <summary>Technical file checks <Fragment set:html={icon(iconChevron)} /></summary>
                <p class="desk-muted small mt-3">Baseline and candidate hashes checked against selected file bytes. Other identities are declarations in the comparison; their source files are not loaded or verified.</p>
                <dl class="desk-stats desk-stats--plain" id="review-identities"></dl>
              </details>
            </div>
          </section>
        </div>

        <aside class="desk-stack desk-side" aria-label="Strategy and qualification">
          <section class="desk-tile reveal" style="--i: 2" aria-labelledby="strategy-title">
            <p class="desk-kicker">Original strategy</p>
            <h2 class="desk-intent" id="strategy-title">EMA20 / EMA50</h2>
            <p class="desk-muted">Uses the crossing of two moving averages on completed 15-minute candles. A proposed filter can change when it enters; the risk rules stay fixed.</p>
            <details class="desk-disclosure">
              <summary>Strategy and risk details <Fragment set:html={icon(iconChevron)} /></summary>
              <dl class="desk-stats">
                <div><dt>Entry risk</dt><dd>0.1% equity</dd></div>
                <div><dt>Stop / target</dt><dd>2 ATR / 3 ATR</dd></div>
                <div><dt>Daily entry pause</dt><dd>1% equity loss</dd></div>
                <div><dt>Position limit</dt><dd>One gold position</dd></div>
              </dl>
              <p class="desk-muted small">Approved strategy limits, not proof that an autonomous runner is enforcing them. No pyramiding, martingale or same-candle reversal.</p>
            </details>
          </section>
          <section class="desk-tile reveal" style="--i: 3" aria-labelledby="gates-title">
            <p class="desk-kicker">Qualification deferred · Oct 2</p>
            <h2 class="desk-intent" id="gates-title">Evidence still incomplete</h2>
            <p class="desk-muted">Batch 2's software preparation is finished. Real-market evidence is not sufficient to approve a strategy. You deferred the longer observation period; it was not marked as passed.</p>
            <details class="desk-disclosure">
              <summary>Qualification requirements <Fragment set:html={icon(iconChevron)} /></summary>
              <ul class="desk-gates">
                <li>Dated costs and broker clock coverage</li>
                <li>Frozen prospective protocol</li>
                <li>60 validation days; three flat folds of at least 20 days</li>
                <li>100 closed trades per strategy</li>
                <li>Verified report provenance and repeatable baseline</li>
                <li>Performance and stress criteria, then human approval</li>
              </ul>
              <p class="desk-muted small">Batch 2 is closed for development, unqualified. The reviewed smoke has a partial pipeline verdict; it does not earn qualifying-day credit. These requirements remain unchanged.</p>
            </details>
          </section>
          <section class="desk-tile reveal" style="--i: 4" aria-labelledby="research-title">
            <p class="desk-kicker">AI research workspace</p>
            <h2 class="desk-intent" id="research-title">Vibe-Trading</h2>
            <p class="desk-muted">OpenAI Codex through ChatGPT OAuth, gpt-6.1-sol with medium reasoning. Learning runs in the separate local app; this page does not verify its current login or availability.</p>
            {import.meta.env.DEV ? <>
              <a class="btn desk-btn" href="http://127.0.0.1:8899/" target="_blank" rel="noopener noreferrer" aria-describedby="local-workspace-note"><Fragment set:html={icon(iconExternal)} />Open local Vibe workspace</a>
              <p class="desk-muted small mt-2" id="local-workspace-note">Opens the separate app on this computer. It must be running locally; OAuth login and research permissions are not verified by this link.</p>
            </> : <p class="desk-muted small">Local workspace only. Vibe-Trading is not hosted on this website.</p>}
            <p class="desk-muted small mb-0">Use Vibe for the separate learning exercises. Real gold AI requests still need verified credential isolation and a guaranteed $0 additional-spend boundary.</p>
          </section>
        </aside>
      </div>
      <footer class="mt-4"><p class="desk-muted small" id="page-note">Live feed refreshes every 10 seconds. Practice results come only from the selected files.</p></footer>
      <noscript><p>Enable JavaScript to load the feed. No current observation or execution data is shown without it.</p></noscript>
    </main>
    <script>
      import { statusFields, executionFields } from '../../scripts/trading-status.mjs';
      import { reviewReports, comparisonExplanation } from '../../scripts/trading-review.mjs';
      const field = (id: string) => document.getElementById(id)!;
      const files = field('report-files') as HTMLInputElement;
      const choose = field('choose-reports') as HTMLButtonElement;
      const clear = field('clear-reports') as HTMLButtonElement;
      let reviewVersion = 0;
      function resetReview() {
        reviewVersion++;
        field('review-result').hidden = true;
        for (const id of ['review-rows', 'review-gates', 'review-identities', 'review-explanation']) field(id).replaceChildren();
        clear.hidden = true;
      }
      choose.addEventListener('click', () => files.click());
      clear.addEventListener('click', () => {
        resetReview(); files.value = ''; field('review-message').textContent = 'Choose your three test reports to see the comparison.';
      });
      files.addEventListener('change', async () => {
        resetReview();
        const version = reviewVersion;
        const selected = Array.from(files.files ?? []);
        files.value = '';
        if (!selected.length) { field('review-message').textContent = 'Choose your three test reports to see the comparison.'; return; }
        choose.disabled = true;
        field('review-message').textContent = 'Checking file hashes and report summaries…';
        try {
          const review = await reviewReports(selected);
          if (version !== reviewVersion) return;
          field('review-explanation').textContent = comparisonExplanation(review.rows);
          const money = new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          for (const row of review.rows) {
            const tr = document.createElement('tr');
            for (const [index, value] of [`${row.scenario} / ${row.window}`, money.format(row.baseline), money.format(row.candidate), money.format(row.difference), row.trades].entries()) {
              const cell = document.createElement(index === 0 ? 'th' : 'td');
              if (index === 0) cell.setAttribute('scope', 'row');
              cell.textContent = value; tr.append(cell);
            }
            field('review-rows').append(tr);
          }
          for (const gap of review.gates) { const li = document.createElement('li'); li.textContent = gap; field('review-gates').append(li); }
          for (const [name, hash] of review.identities) {
            const row = document.createElement('div');
            const dt = document.createElement('dt'); dt.textContent = name;
            const dd = document.createElement('dd'); dd.textContent = hash;
            row.append(dt, dd); field('review-identities').append(row);
          }
          field('review-result').hidden = false; clear.hidden = false;
          field('review-message').textContent = 'Test reports loaded. These results cannot approve a strategy for trading.';
        } catch (error) {
          if (version === reviewVersion) field('review-message').textContent = error instanceof Error ? error.message : 'Review failed. Select the original rehearsal reports.';
        } finally { choose.disabled = false; }
      });
      const refresh = field('refresh') as HTMLButtonElement;
      const signIn = field('sign-in');
      const localPreview = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
      choose.classList.toggle('btn-primary', localPreview);
      choose.classList.toggle('desk-btn', !localPreview);
      const offline = { status: 'offline', checked_at: null };
      let latest: any = offline;
      function render(data: any) {
        const status = statusFields(data);
        field('feed-state').textContent = status.state;
        for (const key of ['connection', 'freshness', 'signal', 'history', 'guidance', 'heartbeat', 'candle', 'tick', 'checked', 'reason'] as const) {
          field(key).textContent = status[key];
        }
        const execution = executionFields(data.execution);
        field('attempt-state').textContent = execution.state;
        field('attempt-guidance').textContent = execution.guidance;
        field('attempt-size').textContent = `${execution.side} / ${execution.volume}`;
        field('attempt-result').textContent = execution.result;
        field('attempt-prices').textContent = `${execution.entry} / ${execution.sl} / ${execution.tp}`;
        field('attempt-closed').textContent = execution.closed;
        if (localPreview) {
          field('feed-state').textContent = 'Not connected here';
          field('connection').textContent = 'Check hosted dashboard';
          for (const id of ['freshness', 'signal', 'history', 'heartbeat']) field(id).textContent = 'Not checked here';
          field('reason').textContent = 'The local preview does not request live broker status.';
          field('attempt-state').textContent = 'Not loaded here';
          field('page-note').textContent = 'Live status is available on the hosted dashboard. Practice reports stay in this tab.';
          field('guidance').textContent = 'This local preview is for practice reports. Open the hosted MT5 dashboard to check the protected live feed. Your desktop tunnel does not connect this page to that API.';
          field('attempt-guidance').textContent = 'The local preview has not loaded your broker trade report. Practice results below are separate.';
          refresh.hidden = true; signIn.hidden = true; field('hosted-feed').hidden = false;
        }
      }
      async function load() {
        if (localPreview) { render(offline); return; }
        if (refresh.disabled) return;
        refresh.disabled = true;
        refresh.textContent = 'Refreshing…';
        let responseNeedsAccess = false;
        try {
          const response = await fetch('/api/trading/status', { cache: 'no-store', redirect: 'manual', signal: AbortSignal.timeout(8000) });
          responseNeedsAccess = response.type === 'opaqueredirect' || [401, 403].includes(response.status);
          if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Unavailable');
          const data = await response.json();
          if (data.mode !== 'signal-only' || data.symbol !== 'XAUUSD-VIP') throw new Error('Invalid feed');
          latest = data;
          signIn.hidden = true;
          render(latest);
        } catch {
          latest = offline;
          render(latest);
          field('feed-state').textContent = 'Feed unavailable';
          field('guidance').textContent = responseNeedsAccess ? 'Sign in to the protected feed, then refresh. MT5 connection cannot be checked until access is restored.' : 'This page could not load the status feed. MT5 connection is unknown; check the hosted dashboard or try again.';
          signIn.hidden = !responseNeedsAccess;
        } finally {
          refresh.disabled = false;
          refresh.textContent = 'Refresh feed';
        }
      }
      refresh.addEventListener('click', load);
      load();
      setInterval(load, 10000);
      // Expire observations even while a network request is waiting.
      setInterval(() => { if (latest !== offline) render(latest); }, 1000);
    </script>
    <style>
      /* Overview-only parts; the shared desk theme lives in src/styles/desk.scss. */
      #review-result[hidden] { display: none; }
      .review-table { overflow-x: auto; margin-block: 1.25rem; border: 1px solid var(--desk-line); border-radius: 16px; }
      table { width: 100%; border-collapse: collapse; font-size: .875rem; font-variant-numeric: tabular-nums; }
      caption { caption-side: top; padding: .875rem 1rem 0; text-align: left; color: var(--desk-muted); }
      thead th { font-family: var(--tblr-font-monospace); font-size: .6875rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--desk-muted); }
      .review-table :global(th), .review-table :global(td) { padding: .75rem 1rem; border-bottom: 1px solid var(--desk-line); text-align: right; font-weight: 400; }
      .review-table :global(th:first-child) { text-align: left; }
      .review-table :global(td) { white-space: nowrap; font-family: var(--tblr-font-monospace); }
      .review-table :global(tbody tr:last-child > *) { border-bottom: 0; }
      button:disabled { cursor: wait; opacity: .6; }
    </style>
  </body>
</html>
