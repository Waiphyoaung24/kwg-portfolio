---
import '../../styles/index.scss';
export const prerender = false;
const workspace=Astro.url.searchParams.get('workspace');
if(workspace&&!['personal','parallel'].includes(workspace))return new Response('Unknown workspace',{status:400});
Astro.response.headers.set('Cache-Control','no-store');
Astro.response.headers.set('X-Content-Type-Options','nosniff');
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('Content-Security-Policy',"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'");
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Local dashboard - KWG</title><link rel="icon" href="/favicon.svg"/><link rel="stylesheet" href="/dashboard-assets/dashboard.css"/></head><body><div id="root"></div><noscript>This dashboard needs JavaScript and a desktop browser with local folder access. No notes have been read.</noscript><script is:inline type="module" src="/dashboard-assets/dashboard.js"></script></body></html>
