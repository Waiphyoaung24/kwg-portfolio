---
import '../../styles/index.scss';
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="noindex" />
    <title>Dashboard — Vault — KWG</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <main class="page">
      <a class="page__back" href="/vault">← Vault</a>
      <h1 class="page__title">Dashboard</h1>
      <p class="page__caption">Nothing here yet.</p>
    </main>

    <style lang="scss">
      .page {
        display: grid;
        align-content: start;
        gap: to-rem(16);
        min-height: 100svh;
        max-width: var(--grid-max-width);
        margin-inline: auto;
        padding: clamp-fluid(24, 56) var(--grid-margin);
        background: var(--c-canvas);
        color: var(--c-body);
        font-family: var(--ff-primary);
      }
      .page__back {
        justify-self: start;
        font-family: var(--ff-mono);
        font-size: var(--fs-micro);
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: var(--c-mute);
        text-decoration: none;
        transition: color 0.2s var(--ease-smooth);

        &:hover {
          color: var(--c-ink);
        }
        &:focus-visible {
          outline: 2px solid var(--c-ink);
          outline-offset: 2px;
        }
      }
      .page__title {
        margin: to-rem(8) 0 0;
        font-size: clamp-fluid(48, 88);
        font-weight: var(--fw-regular);
        line-height: 1;
        letter-spacing: var(--ls-1);
        color: var(--c-ink);
      }
      .page__caption {
        margin: 0;
        font-family: var(--ff-mono);
        font-size: var(--fs-micro);
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: var(--c-mute);
      }
    </style>
  </body>
</html>
