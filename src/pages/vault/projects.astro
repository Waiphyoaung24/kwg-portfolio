---
import '../../styles/index.scss';
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex" />
    <title>Projects — Vault — KWG</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" />
  </head>
  <body>
    <main class="page">
      <a class="page__back" href="/vault">← Vault</a>
      <div id="app"></div>
    </main>
    <script>
      import '../../scripts/projects/app';
    </script>
    <style lang="scss" is:global>
      // Reuses the .gate__* / .page__* patterns from vault.astro + bizz.astro.
      // Everything under #app is rendered by the projects island at runtime, so
      // these rules must stay global (Astro's build-time scoping can't reach them).
      .page {
        display: grid;
        align-content: start;
        gap: to-rem(16);
        min-height: 100svh;
        max-width: var(--grid-max-width);
        margin-inline: auto;
        padding: clamp-fluid(24, 56) var(--grid-margin);
      }
      .page__back {
        justify-self: start;
        font-size: var(--fs-label);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--c-on-surface-muted);
        text-decoration: none;
        transition: color 0.2s var(--ease-smooth);

        &:hover {
          color: var(--c-accent);
        }
        &:focus-visible {
          outline: 2px solid var(--c-accent);
          outline-offset: 2px;
        }
      }
      .page__title {
        margin: to-rem(8) 0 0;
        font-size: var(--fs-2);
        line-height: 0.95;
        text-transform: uppercase;
      }
      .page__caption {
        color: var(--c-on-surface-muted);
      }

      // .gate__label / .gate__error are shared by the new-project form (views/new.ts).
      .gate__label {
        font-size: var(--fs-label);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--c-on-surface-muted);
      }
      .gate__error {
        margin: 0;
        min-height: 1lh;
        font-size: var(--fs-label);
        letter-spacing: 0.04em;
        color: var(--c-accent);
      }
      // ── Project list ───────────────────────────────────────────
      .pv__head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: to-rem(16);
      }
      .pv__nav {
        display: flex;
        align-items: center;
        gap: to-rem(12);

        a {
          font-size: var(--fs-label);
          letter-spacing: 0.12em;
          text-transform: uppercase;
          color: var(--c-on-surface-muted);
          text-decoration: none;
          transition: color 0.2s var(--ease-smooth);

          &:hover {
            color: var(--c-accent);
          }
          &:focus-visible {
            outline: 2px solid var(--c-accent);
            outline-offset: 2px;
          }
        }

        button#new {
          background: var(--c-accent);
          color: var(--c-dark);
          border: none;
          padding: to-rem(10) to-rem(18);
          font: inherit;
          font-size: var(--fs-label);
          font-weight: var(--fw-medium);
          letter-spacing: 0.08em;
          text-transform: uppercase;
          cursor: pointer;
          transition: background 0.2s var(--ease-smooth);

          &:hover {
            background: var(--c-accent-hover);
          }
          &:focus-visible {
            outline: 2px solid var(--c-light);
            outline-offset: 2px;
          }
        }
      }
      .pv__list {
        list-style: none;
        margin: to-rem(8) 0 0;
        padding: 0;
        display: grid;
        gap: to-rem(8);
      }
      .pcard {
        background: var(--c-surface-1);
        border: 1px solid var(--c-surface-2);
        border-left: to-rem(3) solid var(--c-on-surface-muted);
      }
      .pcard--you {
        border-left-color: var(--c-accent);
      }
      .pcard--client {
        border-left-color: var(--c-on-surface-muted);
      }
      .pcard--nobody {
        border-left-color: var(--c-surface-2);
      }
      // Team rows use .pcard directly (no inner link) — the list's layout lives on
      // .pcard__link, so carry the same padding/grid on cards that have no link child.
      .pcard:not(:has(> .pcard__link)) {
        display: grid;
        gap: to-rem(6);
        padding: to-rem(12) to-rem(16);
      }
      .pcard__link {
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: to-rem(12);
        padding: to-rem(12) to-rem(16);
        color: inherit;
        text-decoration: none;

        &:focus-visible {
          outline: 2px solid var(--c-accent);
          outline-offset: -2px;
        }
        &:hover .pcard__name {
          color: var(--c-accent);
        }
      }
      .pcard__name {
        overflow-wrap: anywhere;
        transition: color 0.2s var(--ease-smooth);
      }
      .pcard__warn {
        color: var(--c-accent);
        margin-left: to-rem(4);
      }
      .pcard__stage {
        font-size: var(--fs-label);
        letter-spacing: 0.04em;
        color: var(--c-on-surface-muted);
        white-space: nowrap;
      }
      .pcard__chip {
        font-size: var(--fs-label);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: to-rem(4) to-rem(10);
        border: 1px solid var(--c-surface-2);
        white-space: nowrap;
      }

      // Stack the card row on narrow screens, matching the mobile fixes elsewhere.
      @media (max-width: 40rem) {
        .pcard__link {
          grid-template-columns: 1fr;
          justify-items: start;
          gap: to-rem(6);
        }
      }

      // ── Shared: back link, subheads, forms ──────────────────────
      .pv__back {
        justify-self: start;
        font-size: var(--fs-label);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--c-on-surface-muted);
        text-decoration: none;
        transition: color 0.2s var(--ease-smooth);

        &:hover {
          color: var(--c-accent);
        }
        &:focus-visible {
          outline: 2px solid var(--c-accent);
          outline-offset: 2px;
        }
      }
      .pv__subhead {
        margin: to-rem(24) 0 0;
        font-size: var(--fs-5);
        line-height: 1;
        text-transform: uppercase;
      }
      // .np: new-project + team "add member" forms.
      .np {
        display: grid;
        gap: to-rem(12);
        max-width: to-rem(420);
        margin-top: to-rem(8);

        input,
        select {
          width: 100%;
        }
      }

      // Inputs nested inside a .gate__label must not inherit its uppercase transform
      // (text-transform inherits; `font: inherit` on the control doesn't reset it).
      .gate__label input,
      .gate__label select {
        text-transform: none;
      }

      // ── Form controls (ported from bizz.astro / fitness.astro) ──
      .entry__amount,
      .entry__label {
        font: inherit;
        color: var(--c-light);
        background: var(--c-dark);
        border: 1px solid var(--c-on-surface-muted);
        padding: to-rem(8) to-rem(12);
        min-height: to-rem(44);
        border-radius: 0;

        &:focus-visible {
          outline: 2px solid var(--c-accent);
          outline-offset: 2px;
        }
      }
      .entry__amount {
        flex: 1 1 to-rem(120);
        min-width: 0;
        font-variant-numeric: tabular-nums;
      }
      .entry__label {
        flex: 3 1 to-rem(200);
        min-width: 0;
      }
      .entry__add {
        flex: 0 0 auto;
        min-height: to-rem(44);
        padding: 0 to-rem(24);
        background: var(--c-accent);
        color: var(--c-dark);
        border: none;
        font: inherit;
        font-weight: var(--fw-medium);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s var(--ease-smooth);

        &:hover {
          background: var(--c-accent-hover);
        }
        &:focus-visible {
          outline: 2px solid var(--c-light);
          outline-offset: 2px;
        }
      }
      .filters__select {
        font: inherit;
        color: var(--c-light);
        background: var(--c-dark);
        border: 1px solid var(--c-on-surface-muted);
        padding: to-rem(8) to-rem(12);
        min-height: to-rem(44);
        border-radius: 0;
        flex: 1 1 to-rem(150);

        &:focus-visible {
          outline: 2px solid var(--c-accent);
          outline-offset: 2px;
        }
      }
      .row__del {
        display: grid;
        place-content: center;
        width: to-rem(32);
        height: to-rem(32);
        background: transparent;
        border: 1px solid var(--c-surface-2);
        color: var(--c-on-surface-muted);
        font-size: var(--fs-6);
        line-height: 1;
        cursor: pointer;
        transition:
          border-color 0.2s var(--ease-smooth),
          color 0.2s var(--ease-smooth);

        &:hover {
          border-color: var(--c-accent);
          color: var(--c-accent);
        }
        &:focus-visible {
          outline: 2px solid var(--c-accent);
          outline-offset: 2px;
        }
      }

      // ── Project detail: stage checklist ──────────────────────────
      .stages {
        list-style: none;
        margin: to-rem(16) 0 0;
        padding: 0;
        display: grid;
        gap: to-rem(8);
      }
      .stage {
        display: grid;
        gap: to-rem(8);
        padding: to-rem(12) to-rem(16);
        background: var(--c-surface-1);
        border: 1px solid var(--c-surface-2);
        border-left: to-rem(3) solid var(--c-on-surface-muted);
      }
      // Owner-colored left bar: internal = accent, client = muted, shared = info blue.
      .stage--internal {
        border-left-color: var(--c-accent);
      }
      .stage--client {
        border-left-color: var(--c-on-surface-muted);
      }
      .stage--shared {
        border-left-color: var(--c-info);
      }
      .stage--done,
      .stage--skipped {
        opacity: 0.5;
      }
      .stage__head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: to-rem(12);
      }
      .stage__name {
        flex: 1 1 auto;
        overflow-wrap: anywhere;
      }
      .stage__owner {
        font-size: var(--fs-label);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--c-on-surface-muted);
      }
      .stage__status {
        font: inherit;
        font-size: var(--fs-label);
        color: var(--c-light);
        background: var(--c-dark);
        border: 1px solid var(--c-on-surface-muted);
        padding: to-rem(6) to-rem(10);
        min-height: to-rem(36);
        border-radius: 0;
        text-transform: capitalize;

        &:focus-visible {
          outline: 2px solid var(--c-accent);
          outline-offset: 2px;
        }
      }
      .stage__blocked {
        margin: 0;
        color: var(--c-accent);
        font-size: var(--fs-label);
        letter-spacing: 0.02em;
      }
      .stage__req {
        margin: 0;
        font-size: var(--fs-label);
        color: var(--c-on-surface-muted);
      }
      .stage__docs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: to-rem(4);
        font-size: var(--fs-label);

        em {
          font-style: normal;
          text-transform: uppercase;
          letter-spacing: 0.04em;
          color: var(--c-on-surface-muted);
        }
      }
      .docform {
        display: flex;
        flex-wrap: wrap;
        gap: to-rem(8);
        margin-top: to-rem(4);
      }

      // ── Project detail: activity log ─────────────────────────────
      .activity {
        list-style: none;
        margin: to-rem(8) 0 0;
        padding: 0;
        display: grid;
        gap: to-rem(4);

        li {
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
          gap: to-rem(12);
          padding: to-rem(8) 0;
          border-bottom: 1px solid var(--c-surface-2);
          font-size: var(--fs-label);
        }
        time {
          color: var(--c-on-surface-muted);
          white-space: nowrap;
        }
      }
    </style>
  </body>
</html>
