---
import ZeldaShowcase from '../../components/ZeldaShowcase.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0e14" />
    <meta name="robots" content="noindex" />
    <title>Zelda — Vault — KWG</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="zpage">
      <a class="zpage__back" href="/vault">← Vault</a>
      <header class="zpage__head">
        <p class="zpage__eyebrow">Hyrule UI</p>
        <h1 class="zpage__title">Zelda</h1>
        <p class="zpage__sub">
          <code>zelda-hyrule-ui</code> component showcase — unofficial, non-commercial
          Nintendo fan project.
        </p>
      </header>
      <!-- client:only → render only in the browser; skips SSR so nothing in the
           library can crash the static build by touching window at import time. -->
      <ZeldaShowcase client:only="react" />
    </main>

    <style>
      /* Minimal page chrome only — the component visuals come from the library's
         own CSS (imported inside the island), kept off every other vault page. */
      .zpage {
        min-height: 100svh;
        background: #0a0e14;
        color: #cfe9f0;
        padding: clamp(24px, 5vw, 56px);
        font-family: system-ui, -apple-system, sans-serif;
      }
      .zpage__back {
        display: inline-block;
        margin-bottom: 32px;
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #6ba3b0;
        text-decoration: none;
      }
      .zpage__back:hover {
        color: #3cd3fc;
      }
      .zpage__head {
        margin-bottom: 48px;
      }
      .zpage__eyebrow {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #3cd3fc;
      }
      .zpage__title {
        margin: 4px 0 8px;
        font-size: clamp(40px, 8vw, 72px);
        line-height: 0.95;
        text-transform: uppercase;
      }
      .zpage__sub {
        margin: 0;
        font-size: 14px;
        opacity: 0.6;
      }
      .zpage__sub code {
        color: #e2d146;
      }
    </style>
  </body>
</html>
