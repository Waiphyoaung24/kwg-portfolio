---
import '../../styles/index.scss';
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Browser theme-color metadata cannot resolve a CSS variable. -->
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="noindex" />
    <title>Trading — Vault — KWG</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400&family=JetBrains+Mono:wght@400&display=swap" />
  </head>
  <body>
    <main class="page">
      <a class="pill-btn" href="/vault">← Vault</a>
      <header class="page__intro">
        <h1>Gold demo</h1>
        <p>Check the feed, preview one protected trade, then watch its result.</p>
      </header>
      <section class="card status" aria-labelledby="control-title">
        <div class="status__head">
          <h2 id="control-title">One supervised trade</h2>
          <span class="status__state label" id="execution-state" aria-live="polite">Checking</span>
        </div>
        <p class="status__symbol">One minimum-lot XAUUSD-VIP demo trade at a time. The runner checks again before placing an order and attempts to close after 60 seconds.</p>
        <dl class="status__rows">
          <div><dt class="label">Latest attempt</dt><dd id="execution-summary">Checking</dd></div>
        </dl>
        <p class="status__guidance" id="execution-guidance">Connecting to the private status API.</p>
        <div class="trade__actions">
          <label class="label" for="trade-side">Direction</label>
          <select id="trade-side" aria-label="Demo trade direction"><option value="buy">Buy</option><option value="sell">Sell</option></select>
          <button class="pill-btn pill-btn--filled" id="prepare-trade" type="button" disabled>Preview demo trade</button>
          <a class="pill-btn" href="http://127.0.0.1:6081/vnc.html?autoconnect=1&amp;resize=scale" target="_blank" rel="noopener noreferrer">Open MT5 desktop ↗</a>
        </div>
        <p class="page__note">The MT5 link needs your SSH tunnel to port 6081. Keep Algo Trading off for the preview.</p>
        <div id="trade-preview" class="trade__preview" hidden>
          <h3>Review before starting</h3>
          <p id="preview-summary"></p>
          <p id="preview-protection"></p>
          <p>This preview expires after 10 minutes. Open MT5, enable Algo Trading, then start this one attempt. Prices and broker conditions are checked again before any order.</p>
          <button class="pill-btn pill-btn--filled" id="start-trade" type="button">Start one demo trade</button>
        </div>
        <p id="control-message" role="status" aria-live="polite"></p>
        <details class="status__details">
          <summary class="pill-btn">Trade details <span aria-hidden="true">⌄</span></summary>
          <dl class="status__rows">
            <div><dt class="label">Opened</dt><dd id="execution-opened">—</dd></div>
            <div><dt class="label">Closed</dt><dd id="execution-closed">—</dd></div>
            <div><dt class="label">Last report</dt><dd id="execution-updated">—</dd></div>
          </dl>
        </details>
      </section>
      <section class="card status" aria-labelledby="status-title">
        <div class="status__head">
          <h2 id="status-title">Price feed</h2>
          <span class="status__state label" id="state" aria-live="polite">Checking</span>
        </div>
        <p class="status__symbol micro">XAUUSD-VIP · VT Markets demo</p>
        <dl class="status__rows">
          <div><dt class="label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M8 12h8M9 5H6a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h3m6-14h3a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-3" /></svg>MT5 connection</dt><dd id="connection">Checking</dd></div>
          <div><dt class="label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>Gold price</dt><dd id="freshness">Checking</dd></div>
          <div><dt class="label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="m3 17 6-6 4 3 8-9m-6 0h6v6" /></svg>Strategy signal</dt><dd id="signal">Checking</dd></div>
        </dl>
        <p class="status__guidance" id="guidance" role="status">Connecting to the private status API.</p>
        <details class="status__details">
          <summary class="pill-btn">Technical details <span aria-hidden="true">⌄</span></summary>
          <dl class="status__rows">
            <div><dt class="label">Status delivery</dt><dd id="delivery">Checking</dd></div>
            <div><dt class="label">Observer heartbeat</dt><dd id="heartbeat">Checking</dd></div>
            <div><dt class="label">Last quote</dt><dd id="tick">—</dd></div>
            <div><dt class="label">Quote age at check</dt><dd id="age">—</dd></div>
            <div><dt class="label">15-minute history</dt><dd id="history">Checking</dd></div>
            <div><dt class="label">Latest fetched candle · opened</dt><dd id="candle">—</dd></div>
            <div><dt class="label">Strategy readiness</dt><dd id="strategy">Checking</dd></div>
            <div><dt class="label">Last checked</dt><dd id="checked">—</dd></div>
          </dl>
          <p class="status__reason" id="reason">Checking</p>
        </details>
        <div class="status__actions">
          <button class="pill-btn" id="refresh" type="button">Refresh status</button>
          <a class="pill-btn" id="sign-in" href="/api/trading/status" hidden>Sign in to status</a>
        </div>
      </section>
      <p class="page__note">Status updates every 10 seconds. This control starts only a reviewed, single demo attempt; it does not run the strategy continuously.</p>
    </main>

    <script>
      import { executionFields, statusFields } from '../../scripts/trading-status.mjs';
      const field = (id: string) => document.getElementById(id)!;
      const refresh = field('refresh') as HTMLButtonElement;
      const signIn = field('sign-in') as HTMLAnchorElement;
      const prepare = field('prepare-trade') as HTMLButtonElement;
      const start = field('start-trade') as HTMLButtonElement;
      const side = field('trade-side') as HTMLSelectElement;
      const previewBox = field('trade-preview');
      let latest: Parameters<typeof statusFields>[0] | null = null;
      let receivedAt = 0;
      let previewToken: string | null = null;
      let startedAt = 0;
      function render() {
        if (!latest) return;
        const fields = statusFields(latest);
        if (Date.now() - receivedAt > 30000) fields.delivery = 'No recent API response';
        for (const [id, value] of Object.entries(fields)) field(id).textContent = value;
        const execution = executionFields(latest.execution);
        for (const id of ['state', 'opened', 'closed', 'updated', 'guidance'] as const) field(`execution-${id}`).textContent = execution[id];
        field('execution-summary').textContent = execution.state === 'Unknown' ? 'No current report'
          : [execution.side, execution.volume, execution.result].filter(value => value !== '—').join(' · ') || execution.state;
        const state = latest.execution?.status;
        const resolved = state === 'closed' || state === 'disarmed';
        if (startedAt && latest.execution && latest.execution.updated_at > startedAt && resolved) {
          startedAt = 0;
          side.disabled = false;
          field('control-message').textContent = 'Attempt finished. Review the result and turn Algo Trading off in MT5.';
        }
        prepare.disabled = !!previewToken || !!startedAt || !resolved || fields.state !== 'Observing';
        start.disabled = !previewToken || !resolved || Date.now() - receivedAt > 30000;
      }

      async function control(action: 'preview' | 'arm', body: object) {
        const response = await fetch(`/api/trading/${action}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
          cache: 'no-store', credentials: 'same-origin', redirect: 'manual', signal: AbortSignal.timeout(60000),
        });
        if (response.type === 'opaqueredirect' || [401, 403].includes(response.status)) throw new Error('Sign in through Cloudflare Access first.');
        const result = await response.json();
        if (!response.ok) throw new Error(typeof result.error === 'string' ? result.error : 'Demo control is unavailable.');
        return result;
      }

      prepare.addEventListener('click', async () => {
        prepare.disabled = true;
        field('control-message').textContent = 'Checking the demo account and preparing a no-order preview…';
        try {
          const result = await control('preview', { side: side.value });
          const p = result.preview;
          previewToken = result.token;
          field('preview-summary').textContent = `${p.side.toUpperCase()} ${p.volume} lot near ${p.quote_reference.toFixed(2)}. Stop ${p.sl.toFixed(2)}; target ${p.tp.toFixed(2)}.`;
          field('preview-protection').textContent = `Modeled loss at stop: $${p.modeled_stop_usd.toFixed(2)} (${p.modeled_stop_pct_of_equity.toFixed(5)}% of equity), before fees, slippage or gaps.`;
          start.textContent = `Start one demo ${p.side.toUpperCase()}`;
          previewBox.hidden = false;
          prepare.hidden = true;
          side.disabled = true;
          field('control-message').textContent = 'No order was placed by this preview. Review it, then enable Algo Trading in MT5.';
          render();
        } catch (error) {
          field('control-message').textContent = error instanceof Error ? error.message : 'Preview failed.';
          render();
        }
      });

      start.addEventListener('click', async () => {
        if (!previewToken) return;
        start.disabled = true;
        field('control-message').textContent = 'Starting one demo attempt. Watch MT5 and the status below.';
        try {
          await control('arm', { token: previewToken });
          previewToken = null;
          startedAt = Date.now() / 1000;
          previewBox.hidden = true;
          prepare.hidden = false;
          field('control-message').textContent = 'Start accepted. Watch MT5 until the position closes. Do not click again if status is uncertain.';
          load();
        } catch (error) {
          previewToken = null;
          startedAt = Date.now() / 1000;
          previewBox.hidden = true;
          prepare.hidden = false;
          side.disabled = true;
          field('control-message').textContent = `${error instanceof Error ? error.message : 'Start failed.'} Check MT5 for a position or order before reloading this page.`;
          render();
        }
      });

      async function load() {
        if (refresh.disabled) return;
        refresh.disabled = true;
        try {
          const response = await fetch('/api/trading/status', { cache: 'no-store', credentials: 'same-origin', redirect: 'manual', signal: AbortSignal.timeout(8000) });
          if (response.type === 'opaqueredirect' || [401, 403].includes(response.status)) throw new Error('access');
          if (!response.ok) throw new Error('unavailable');
          if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('unavailable');
          const data = await response.json();
          if (data.mode !== 'signal-only' || data.symbol !== 'XAUUSD-VIP') throw new Error('unavailable');
          signIn.hidden = true;
          latest = data;
          receivedAt = Date.now();
          render();
        } catch (error) {
          latest = null;
          prepare.disabled = true;
          start.disabled = true;
          const needsAccess = error instanceof Error && error.message === 'access';
          field('state').textContent = needsAccess ? 'Sign-in required' : 'Unavailable';
          field('delivery').textContent = needsAccess ? 'Sign-in required' : 'Status path unavailable';
          field('heartbeat').textContent = 'Unknown';
          field('connection').textContent = 'Unknown — status unavailable';
          field('freshness').textContent = 'Unknown';
          for (const id of ['tick', 'age', 'history', 'strategy']) field(id).textContent = '—';
          field('candle').textContent = '—';
          field('signal').textContent = '—';
          field('checked').textContent = '—';
          field('reason').textContent = needsAccess ? 'Sign in through Cloudflare Access to view this status.' : 'The private status API is unavailable. Try again shortly.';
          field('guidance').textContent = field('reason').textContent;
          const execution = executionFields(null);
          for (const id of ['state', 'opened', 'closed', 'updated', 'guidance'] as const) field(`execution-${id}`).textContent = execution[id];
          field('execution-summary').textContent = 'No current report';
          signIn.hidden = !needsAccess;
        } finally {
          refresh.disabled = false;
        }
      }

      refresh.addEventListener('click', load);
      window.setInterval(() => { if (!document.hidden) load(); }, 10000);
      window.setInterval(() => { if (!document.hidden) render(); }, 1000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) { render(); load(); } });
      load();
    </script>

    <style lang="scss">
      .page { display: grid; align-content: start; justify-items: start; gap: var(--sp-2xl); min-height: 100svh; max-width: var(--grid-max-width); margin-inline: auto; padding: var(--sp-3xl) var(--grid-margin); }
      .page__intro { max-width: 65ch; }
      .page__intro h1 { margin: 0 0 var(--sp-lg); font-size: var(--fs-2); line-height: 1; letter-spacing: var(--ls-2); }
      .page__intro p { margin: 0; color: var(--c-body); line-height: 1.5; }
      .page__note { margin: 0; color: var(--c-body); font-size: var(--fs-body-sm); }
      .status { width: min(100%, var(--container-max-width)); box-shadow: none; }
      .status__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-md); }
      .status__head h2 { margin: 0; font-size: var(--fs-4); font-weight: var(--fw-regular); letter-spacing: var(--ls-4); }
      .status__state { color: var(--c-body); }
      .status__rows { margin: var(--sp-xl) 0; }
      .status__rows div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--sp-md); padding: var(--sp-md) 0; border-top: 1px solid var(--c-hairline); }
      .status__rows dt { display: flex; align-items: center; gap: var(--sp-sm); color: var(--c-body); }
      .status__rows svg { width: var(--sp-xl); height: var(--sp-xl); flex-shrink: 0; }
      .status__symbol { margin: var(--sp-md) 0 0; color: var(--c-body); }
      .status__guidance { max-width: 65ch; line-height: 1.6; color: var(--c-body); margin: 0 0 var(--sp-xl); }
      .status__details { margin-bottom: var(--sp-xl); }
      .status__details summary { width: fit-content; list-style: none; }
      .status__details summary::-webkit-details-marker { display: none; }
      .status__details[open] summary span { transform: rotate(180deg); }
      .status__rows dd { margin: 0; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
      .status__reason { min-height: 1.5em; margin: 0 0 var(--sp-xl); color: var(--c-body); }
      .status__actions { display: flex; flex-wrap: wrap; gap: var(--sp-md); }
      .status__actions [hidden] { display: none; }
      .trade__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-md); margin-bottom: var(--sp-lg); }
      .trade__actions select { min-height: var(--sp-3xl); padding: var(--sp-sm) var(--sp-xl); border: 1px solid var(--c-hairline-bright); border-radius: var(--r-pill); background: var(--c-canvas); color: var(--c-ink); font: inherit; }
      .trade__preview { max-width: 65ch; margin-top: var(--sp-xl); padding-top: var(--sp-xl); border-top: 1px solid var(--c-hairline); }
      .trade__preview h3 { margin: 0 0 var(--sp-md); font-size: var(--fs-5); font-weight: var(--fw-regular); }
      .trade__preview p { color: var(--c-body); line-height: 1.5; }
      .trade__preview[hidden], .trade__actions [hidden] { display: none; }
      #control-message { min-height: 1.5em; color: var(--c-body); }
      button:disabled { opacity: .5; cursor: not-allowed; }
      @media (max-width: 40rem) { .status__rows div { grid-template-columns: 1fr; gap: var(--sp-xs); } }
    </style>
  </body>
</html>
