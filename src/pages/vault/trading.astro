---
import '@tabler/core/dist/css/tabler.min.css';
import '@tabler/core/dist/css/tabler-vendors.min.css';
import '../../styles/desk.scss';
import TradingNavigation from '../../components/TradingNavigation.astro';
import TradingReplay from '../../components/TradingReplay.astro';
import iconDown from '@tabler/icons/outline/arrow-down-right.svg?raw';
import iconUp from '@tabler/icons/outline/arrow-up-right.svg?raw';
import iconRefresh from '@tabler/icons/outline/refresh.svg?raw';
import iconPlug from '@tabler/icons/outline/plug-connected.svg?raw';
import iconCoin from '@tabler/icons/outline/coin.svg?raw';
import iconPulse from '@tabler/icons/outline/activity.svg?raw';
import iconChevron from '@tabler/icons/outline/chevron-down.svg?raw';
import iconPause from '@tabler/icons/outline/player-pause.svg?raw';
import iconExternal from '@tabler/icons/outline/external-link.svg?raw';
import iconLogin from '@tabler/icons/outline/login.svg?raw';
import iconShield from '@tabler/icons/outline/shield.svg?raw';
import iconClock from '@tabler/icons/outline/clock.svg?raw';
import iconTarget from '@tabler/icons/outline/target-arrow.svg?raw';
import iconTrendUp from '@tabler/icons/outline/trending-up.svg?raw';
import iconTrendDown from '@tabler/icons/outline/trending-down.svg?raw';
export const prerender = true;
// Tabler icons ship as raw SVG; mark them decorative for assistive technology.
const icon = (svg: string) => svg.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const logo = '<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M26.2636 20.4752L29.7034 6.2832H22.8238L26.2636 20.4752ZM12.2636 6.2832L17.0473 26.0199H23.9568L19.1731 6.2832H12.2636ZM8.61287 6.28336L1.70337 6.28373L6.48706 26.0203L13.3966 26.02L8.61287 6.28336Z" /></svg>';
---

<!doctype html>
<html lang="en" data-bs-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Browser theme-color metadata cannot resolve a CSS variable. -->
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex" />
    <title>Demo account monitor - Gold operations - KWG</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body class="desk">
    <TradingNavigation current="demo" />
    <main class="container-xl desk-main">
      <header class="desk-intro reveal" style="--i: 0" id="trading-content" tabindex="-1">
        <p class="desk-eyebrow"><span class="desk-logo desk-logo--sm" set:html={logo} />KWG / Demo operations</p>
        <h1 id="instrument-title">Gold, under observation.</h1>
        <p class="desk-lede">Your demo pilot, its next move, and the evidence behind each trade.</p>
        {import.meta.env.DEV && import.meta.env.PUBLIC_TRADING_PILOT_FIXTURE === '1' && <p class="desk-note" role="note">Local design preview. Simulated quotes update every 2 seconds. All prices and trades are sample data. Trading controls are disabled.</p>}
      </header>

      <div class="desk-switch reveal" style="--i: 1">
        <nav class="desk-segment" aria-label="Demo instrument">
          <a id="instrument-gold" href="/vault/trading">Gold · M1</a>
          <a id="instrument-btc" href="/vault/trading?symbol=BTCUSD">Bitcoin · M15</a>
        </nav>
        <p class="desk-muted small m-0">Each view shows one symbol. Switching views does not start, pause, or switch execution. Account loss limits cover both symbols.</p>
      </div>
      <section class="desk-hero reveal" style="--i: 1" aria-labelledby="hero-price-label">
        <div class="desk-hero__price">
          <p class="desk-kicker" id="hero-price-label"><span class="desk-live" aria-hidden="true"></span>XAUUSD-VIP · Bid / ask, USD</p>
          <p class="desk-price" id="price">—</p>
          <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <span class="desk-chip" id="state" aria-live="polite">Checking</span>
            <span class="desk-muted small">VT Markets demo</span>
          </div>
        </div>
        <div class="desk-hero__idle" id="position-idle">
          <p class="desk-kicker">Position</p>
          <p class="desk-idle-title">No open position</p>
          <p class="desk-muted mb-0">The trade appears here, with its stop, entry and target, the moment the pilot opens one.</p>
        </div>
        <section class="desk-trade" id="position-strip" aria-labelledby="position-title" hidden>
          <div class="desk-trade__head">
            <div>
              <h2 class="desk-kicker" id="position-title"><span class="desk-live" aria-hidden="true"></span>Open demo position</h2>
              <p class="desk-trade__side"><span class="desk-trade__arrow" id="position-side-icon-sell" set:html={icon(iconDown)} hidden /><span class="desk-trade__arrow" id="position-side-icon-buy" set:html={icon(iconUp)} hidden /><span id="position-side">-</span><span class="desk-trade__volume" id="position-volume"></span></p>
              <p class="desk-muted small m-0"><span id="position-symbol">XAUUSD-VIP</span> <span id="position-opened"></span></p>
            </div>
            <div class="desk-trade__pl">
              <p class="desk-kicker">Floating P/L</p>
              <p class="desk-pl" id="position-pl-wrap"><span id="position-pl-up" set:html={icon(iconTrendUp)} hidden /><span id="position-pl-down" set:html={icon(iconTrendDown)} hidden /><span id="position-pl">-</span></p>
              <p class="desk-muted small m-0">Before unbooked costs</p>
            </div>
          </div>
          <div class="position-rail" id="position-rail" role="meter" aria-label="Price between stop and target" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
            <div class="position-rail__track">
              <div class="position-rail__fill" id="position-fill"></div>
              <div class="position-rail__entry" id="position-entry-tick"></div>
              <div class="position-rail__pos" id="position-marker"><span class="position-rail__price" id="position-price"></span><span class="position-rail__dot"></span></div>
            </div>
            <div class="position-rail__labels">
              <span><span class="text-loss">Stop</span> <span class="desk-num" id="position-sl"></span></span>
              <span class="position-rail__entry-label" id="position-entry-label">Entry <span class="desk-num" id="position-entry"></span></span>
              <span><span class="desk-green">Target</span> <span class="desk-num" id="position-tp"></span></span>
            </div>
          </div>
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
            <p class="desk-muted small m-0" id="position-progress">Waiting for a fresh price</p>
            <a class="btn btn-sm desk-btn" href="#pilot-panel">Pilot details</a>
          </div>
        </section>
      </section>
      <p class="visually-hidden" role="status" id="position-announce"></p>

      <div class="desk-grid">
        <section class="desk-tile desk-tile--chart reveal" style="--i: 2" aria-labelledby="status-title">
          <div class="desk-tile__head">
            <div>
              <h2 id="status-title">Live demo feed</h2>
              <p class="desk-muted small m-0" id="trade-sound-note" role="status">Quiet entry alert. Enable to preview. Only while this page is visible.</p>
            </div>
            <div class="btn-list">
              <button class="btn btn-sm desk-btn" id="trade-sound" type="button" aria-pressed="false" aria-describedby="trade-sound-note">Trade sound: Off</button>
              <button class="btn btn-sm desk-btn" id="refresh" type="button" aria-label="Refresh status"><Fragment set:html={icon(iconRefresh)} />Refresh</button>
            </div>
          </div>
          <div id="trading-charts"><p class="desk-muted">Loading chart views…</p></div>
          <a class="btn btn-primary mt-3" id="sign-in" href="/api/trading/status" hidden><Fragment set:html={icon(iconLogin)} />Sign in to status</a>
        </section>

        <div class="desk-health reveal" style="--i: 3">
          <div class="desk-tile desk-stat"><p class="desk-kicker"><Fragment set:html={icon(iconPlug)} />MT5 connection</p><p class="desk-stat__value" id="connection">Checking</p></div>
          <div class="desk-tile desk-stat"><p class="desk-kicker"><Fragment set:html={icon(iconCoin)} /><span id="instrument-price-label">Gold price</span></p><p class="desk-stat__value" id="freshness">Checking</p></div>
          <div class="desk-tile desk-stat"><p class="desk-kicker"><Fragment set:html={icon(iconPulse)} />Strategy signal</p><p class="desk-stat__value" id="signal">Checking</p></div>
          <div class="desk-tile desk-guidance">
            <p class="m-0" id="guidance" role="status">Connecting to the private status API.</p>
            <p class="desk-muted small mt-2 mb-0" id="mode-note">Live observation only. Signals do not place orders. Keep Algo Trading off for observation.</p>
          </div>
        </div>

        <section class="desk-tile desk-pilot reveal" style="--i: 4" id="pilot-panel" aria-labelledby="pilot-title" tabindex="-1" hidden>
          <div class="desk-tile__head">
            <div>
              <h2 id="pilot-title">Autonomous demo pilot</h2>
              <p class="desk-muted small m-0">Unqualified demo</p>
            </div>
            <span class="desk-chip desk-chip--solid text-uppercase" id="pilot-state" aria-live="polite">Checking</span>
          </div>
          <p class="desk-intent" id="pilot-intent">Waiting for status</p>
          <p class="desk-muted" id="pilot-reason" role="status">Checking</p>
          <dl class="desk-stats">
            <div><dt>Realized net</dt><dd class="desk-num" id="pilot-realized">—</dd></div>
            <div><dt>Floating profit</dt><dd class="desk-num" id="pilot-floating">—</dd></div>
            <div><dt>Completed trades</dt><dd class="desk-num" id="pilot-count">—</dd></div>
            <div><dt><Fragment set:html={icon(iconClock)} />Time remaining</dt><dd class="desk-num" id="pilot-remaining">—</dd></div>
            <div class="desk-stats__wide"><dt>Position / latest attempt</dt><dd id="pilot-position">—</dd></div>
            <div class="desk-stats__wide"><dt><Fragment set:html={icon(iconTarget)} />Entry / stop / target</dt><dd class="desk-num" id="pilot-levels">—</dd></div>
          </dl>
          <div class="desk-strategy">
            <h3>One fixed strategy</h3>
            <p class="desk-muted small"><span id="pilot-strategy">Waiting for strategy</span><br /><span id="pilot-timeframe">Waiting for strategy timeframe</span></p>
            <ul class="desk-rules">
              <li><Fragment set:html={icon(iconShield)} />0.01 lot, one position per symbol</li>
              <li><Fragment set:html={icon(iconTarget)} />Stop 2× ATR, target 3× ATR</li>
              <li><Fragment set:html={icon(iconCoin)} />Entry risk at most 0.1% of equity</li>
            </ul>
          </div>
          <button class="btn btn-primary w-100" id="pilot-pause" type="button" disabled><Fragment set:html={icon(iconPause)} />Pause new entries</button>
          <p class="desk-muted small mt-3">Pausing keeps existing positions protected and monitored. At expiry, the pilot requests closure. Unresolved positions need owner attention. Floating profit excludes costs not yet booked.</p>
          <p class="small" id="pilot-message" role="status"></p>
          <details class="desk-disclosure"><summary>Recent completed trades <Fragment set:html={icon(iconChevron)} /></summary><ol class="desk-list" id="pilot-trades"></ol></details>
        </section>

        <section class="desk-tile desk-timeline reveal" style="--i: 5" aria-labelledby="checks-title">
          <h2 id="checks-title">Recent checks</h2>
          <p class="desk-muted small">Up to six checks from this page session.</p>
          <ol class="desk-steps" id="monitor-activity"><li>Waiting for the first status report.</li></ol>
          <details class="desk-disclosure">
            <summary>Technical details <Fragment set:html={icon(iconChevron)} /></summary>
            <dl class="desk-stats desk-stats--plain">
              <div><dt>Status delivery</dt><dd id="delivery">Checking</dd></div>
              <div><dt>Observer heartbeat</dt><dd id="heartbeat">Checking</dd></div>
              <div><dt>Last quote</dt><dd id="tick">—</dd></div>
              <div><dt>Quote age at check</dt><dd id="age">—</dd></div>
              <div><dt>Completed-candle history</dt><dd id="history">Checking</dd></div>
              <div><dt>Latest fetched candle, opened</dt><dd id="candle">—</dd></div>
              <div><dt>Strategy readiness</dt><dd id="strategy">Checking</dd></div>
              <div><dt>Last checked</dt><dd id="checked">—</dd></div>
            </dl>
            <p class="desk-muted" id="reason">Checking</p>
          </details>
        </section>
      </div>

      <div id="trading-replay-source" hidden><TradingReplay /></div>
      <details class="manual-controls desk-disclosure reveal" style="--i: 6" id="manual-controls">
        <summary>Manual demo order controls <Fragment set:html={icon(iconChevron)} /></summary>
        <section class="desk-tile mt-3" aria-labelledby="control-title">
          <div class="desk-tile__head">
            <div>
              <h2 id="control-title">Prepare one trade</h2>
              <p class="desk-muted small m-0">XAUUSD-VIP, 0.01 lot, broker-held stop loss and take profit</p>
            </div>
            <span class="desk-chip">Manual demo</span>
          </div>
          <ol class="steps steps-counter steps-green mb-4" aria-label="Demo order steps">
            <li class="step-item">Set prices</li>
            <li class="step-item">Preview, no order</li>
            <li class="step-item">Place once</li>
          </ol>
          <div class="row g-4">
            <div class="col-md-6">
              <form id="trade-form">
                <div class="row g-3">
                  <label class="col-6"><span class="form-label">Direction</span><select class="form-select" id="trade-side" aria-label="Demo trade direction"><option value="buy">Buy</option><option value="sell">Sell</option></select></label>
                  <label class="col-6"><span class="form-label">Entry price</span><input class="form-control desk-num" id="trade-entry" type="number" inputmode="decimal" min="0.01" max="1000000" step="0.01" placeholder="Price" required /></label>
                  <label class="col-6"><span class="form-label">Stop loss</span><input class="form-control desk-num" id="trade-sl" type="number" inputmode="decimal" min="0.01" max="1000000" step="0.01" placeholder="Price" required /></label>
                  <label class="col-6"><span class="form-label">Take profit</span><input class="form-control desk-num" id="trade-tp" type="number" inputmode="decimal" min="0.01" max="1000000" step="0.01" placeholder="Price" required /></label>
                </div>
                <p class="form-hint mt-2">Choose prices from MT5. Buy: stop below entry, target above. Sell: target below entry, stop above.</p>
                <div class="btn-list">
                  <button class="btn btn-primary" id="prepare-trade" type="submit" disabled>Preview pending order</button>
                  <a class="btn desk-btn" href="http://127.0.0.1:6081/vnc.html?autoconnect=1&amp;resize=scale" target="_blank" rel="noopener noreferrer"><Fragment set:html={icon(iconExternal)} />Open MT5 desktop</a>
                </div>
              </form>
              <p class="desk-muted small mt-3">Keep Algo Trading off for the preview. The MT5 desktop link needs your SSH tunnel to port 6081.</p>
              <div id="trade-preview" class="desk-preview mt-3" hidden>
                <h3>Review before starting</h3>
                <p id="preview-summary"></p>
                <p id="preview-protection"></p>
                <p>This preview expires after 10 minutes. Enable Algo Trading in MT5, then place this one pending order. Prices, account and broker conditions are checked again first.</p>
                <p>The pending order stays until you cancel it in MT5.</p>
                <button class="btn btn-primary" id="start-trade" type="button">Place one pending order</button>
              </div>
              <p class="mt-3" id="control-message" role="status" aria-live="polite"></p>
            </div>
            <figure class="col-md-6 m-0 trade__chart" aria-labelledby="levels-title levels-caption">
              <h3 id="levels-title">Entry / stop / target</h3>
              <p class="desk-muted small" id="levels-source">Waiting for a report</p>
              <!-- Fixed SVG coordinates are diagram geometry, not layout spacing. -->
              <div id="levels-plot" hidden>
              <svg id="levels-chart" viewBox="0 0 400 260" role="img" aria-labelledby="levels-description">
                <title id="levels-description">Trade price levels</title>
                <line class="trade__axis" x1="136" x2="136" y1="20" y2="240" />
                <g id="level-stop"><line x1="136" x2="290" /><circle cx="136" r="4" /><text x="0" class="trade__level-label">Stop loss</text><text x="400" text-anchor="end" class="trade__level-price"></text></g>
                <g id="level-entry"><line x1="136" x2="290" /><circle cx="136" r="4" /><text x="0" class="trade__level-label">Entry</text><text x="400" text-anchor="end" class="trade__level-price"></text></g>
                <g id="level-target"><line x1="136" x2="290" /><circle cx="136" r="4" /><text x="0" class="trade__level-label">Take profit</text><text x="400" text-anchor="end" class="trade__level-price"></text></g>
              </svg>
              </div>
              <p class="desk-muted" id="levels-empty">Enter entry, stop loss and take profit to see their price levels.</p>
              <figcaption id="levels-caption" class="desk-muted small">Price levels only. This is not a market chart or a forecast.</figcaption>
            </figure>
          </div>
          <div class="desk-attempt">
            <div class="d-flex justify-content-between align-items-baseline gap-2"><h3 class="m-0">Latest attempt</h3><span class="desk-chip text-uppercase" id="execution-state" aria-live="polite">Checking</span></div>
            <p class="desk-num fs-3 mt-2" id="execution-summary">Checking</p>
            <p class="desk-muted" id="execution-guidance">Connecting to the private status API.</p>
            <details class="desk-disclosure">
              <summary>Trade details <Fragment set:html={icon(iconChevron)} /></summary>
              <dl class="desk-stats desk-stats--plain">
                <div><dt>Entry price</dt><dd id="execution-entry">—</dd></div>
                <div><dt>Stop loss</dt><dd id="execution-sl">—</dd></div>
                <div><dt>Take profit</dt><dd id="execution-tp">—</dd></div>
                <div><dt>Opened</dt><dd id="execution-opened">—</dd></div>
                <div><dt>Closed</dt><dd id="execution-closed">—</dd></div>
                <div><dt>Last report</dt><dd id="execution-updated">—</dd></div>
              </dl>
            </details>
          </div>
        </section>
        <p class="desk-muted small mt-2">Status updates every 10 seconds. This control starts only a reviewed, single demo attempt. It does not run the strategy continuously.</p>
      </details>
    </main>
    <script is:inline type="module" src="/dashboard-assets/trading.js"></script>

    <script>
      import { executionFields, statusFields } from '../../scripts/trading-status.mjs';
      import { pilotFields } from '../../scripts/trading-pilot.mjs';
      import { tradeLevels } from '../../scripts/trading-levels.mjs';
      import { chartSnapshot } from '../../scripts/trading-chart.mjs';
      import { entryNotifications } from '../../scripts/trading-sound.mjs';
      import { positionRail } from '../../scripts/trading-position.mjs';
      import { selectedInstrument } from '../../scripts/trading-instruments.mjs';
      const field = (id: string) => document.getElementById(id)!;
      const selected = selectedInstrument(location.search);
      document.title = `Demo account monitor - ${selected.name} operations - KWG`;
      field('instrument-title').textContent = `${selected.name}, under observation.`;
      field('hero-price-label').textContent = `${selected.symbol} · Bid / ask, USD`;
      field('position-symbol').textContent = selected.symbol;
      field('instrument-price-label').textContent = `${selected.name} price`;
      field(selected.symbol === 'BTCUSD' ? 'instrument-btc' : 'instrument-gold').setAttribute('aria-current', 'page');
      field('manual-controls').hidden = selected.symbol === 'BTCUSD';
      (field('sign-in') as HTMLAnchorElement).href = '/api/trading/status' + selected.query;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const numbers = /-?\d+(?:\.\d+)?/g;
      const rolling = new WeakMap<Element, number>();
      // Roll every number in `text` from the value currently shown; same sign and shape only.
      function roll(el: HTMLElement, text: string) {
        const from = (el.textContent ?? '').match(numbers)?.map(Number);
        const to = text.match(numbers)?.map(Number);
        cancelAnimationFrame(rolling.get(el) ?? 0);
        if (reduceMotion.matches || !from || !to || from.length !== to.length || from.some((v, i) => Math.sign(v) !== Math.sign(to[i]))) { el.textContent = text; return; }
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / 450), eased = 1 - (1 - t) ** 3;
          let i = 0;
          el.textContent = t === 1 ? text : text.replace(numbers, match => { const v = from[i] + (to[i] - from[i]) * eased; i++; return v.toFixed((match.split('.')[1] ?? '').length); });
          if (t < 1) rolling.set(el, requestAnimationFrame(step));
        };
        rolling.set(el, requestAnimationFrame(step));
      }
      // Restart a one-shot flash class so repeated ticks in one direction still show.
      function flash(el: HTMLElement, up: boolean) {
        el.classList.remove('tick-up', 'tick-down');
        void el.offsetWidth;
        el.classList.add(up ? 'tick-up' : 'tick-down');
      }
      let lastBid: number | null = null;
      const refresh = field('refresh') as HTMLButtonElement;
      const soundToggle = field('trade-sound') as HTMLButtonElement;
      const sound = new Audio('/audio/trade-entry.mp3');
      sound.preload = 'none';
      sound.volume = 0.35;
      const entryNotification = entryNotifications(selected.symbol);
      let soundEnabled = false;
      function muteSound() {
        soundEnabled = false;
        sound.pause();
        soundToggle.setAttribute('aria-pressed', 'false');
        soundToggle.textContent = 'Trade sound: Off';
      }
      async function playEntrySound() {
        sound.currentTime = 0;
        try { await sound.play(); }
        catch {
          if (!soundEnabled) return;
          muteSound();
          field('trade-sound-note').textContent = 'Sound unavailable. Click On to try again; check your browser volume.';
        }
      }
      soundToggle.addEventListener('click', () => {
        if (soundEnabled) {
          muteSound();
          field('trade-sound-note').textContent = 'Trade sounds muted.';
        } else {
          soundEnabled = true;
          soundToggle.setAttribute('aria-pressed', 'true');
          soundToggle.textContent = 'Trade sound: On';
          field('trade-sound-note').textContent = 'Quiet preview · new entry alerts on, while this page is visible.';
          void playEntrySound();
        }
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { sound.pause(); entryNotification(null, Date.now() / 1000, false); }
      });
      window.addEventListener('pagehide', muteSound);
      const signIn = field('sign-in') as HTMLAnchorElement;
      const prepare = field('prepare-trade') as HTMLButtonElement;
      const start = field('start-trade') as HTMLButtonElement;
      const side = field('trade-side') as HTMLSelectElement;
      const form = field('trade-form') as HTMLFormElement;
      const entry = field('trade-entry') as HTMLInputElement;
      const sl = field('trade-sl') as HTMLInputElement;
      const tp = field('trade-tp') as HTMLInputElement;
      const previewBox = field('trade-preview');
      const fixturePreview = import.meta.env.DEV && import.meta.env.PUBLIC_TRADING_FIXTURE === '1';
      const designPreview = fixturePreview && import.meta.env.PUBLIC_TRADING_PILOT_FIXTURE === '1';
      const localPreview = !fixturePreview && (['localhost', '127.0.0.1', '[::1]'].includes(location.hostname) || location.protocol === 'file:');
      let latest: Parameters<typeof statusFields>[0] | null = null;
      let receivedAt = 0;
      let previewToken: string | null = null;
      let startedAt = 0;
      let lastCheck: number | null = null;
      const checks: string[] = [];
      function renderLevels() {
        const draft = [entry, sl, tp].some(input => input.value !== '' || input.validity.badInput);
        const execution = latest ? executionFields(latest.execution) : null;
        const levels = draft ? [entry, sl, tp].every(input => input.validity.valid) && tradeLevels(side.value, entry.valueAsNumber, sl.valueAsNumber, tp.valueAsNumber)
          : execution && tradeLevels(latest!.execution?.side, Number(execution.entry), Number(execution.sl), Number(execution.tp));
        field('levels-plot').hidden = !levels;
        field('levels-empty').hidden = !!levels;
        field('levels-source').textContent = draft ? startedAt ? 'Submitted levels · confirm in MT5'
          : previewToken ? 'Previewed levels · no order placed' : 'Draft levels · not broker checked'
          : execution && execution.state !== 'Unknown' ? `${execution.state === 'Closed' ? 'Historical' : 'Reported'} ${execution.side} · ${execution.volume}` : 'No reported levels';
        field('levels-empty').textContent = draft
          ? 'Complete all three prices. Buy: stop < entry < target. Sell: target < entry < stop.'
          : 'Enter entry, stop loss and take profit to see their price levels.';
        if (!levels) return;
        for (const [index, id] of ['level-stop', 'level-entry', 'level-target'].entries()) {
          const level = levels[index];
          const group = field(id);
          group.querySelector('line')!.setAttribute('y1', String(level.y));
          group.querySelector('line')!.setAttribute('y2', String(level.labelY));
          group.querySelector('circle')!.setAttribute('cy', String(level.y));
          for (const text of group.querySelectorAll('text')) text.setAttribute('y', String(level.labelY - 10));
          group.querySelector('.trade__level-price')!.textContent = level.price.toFixed(2);
        }
        field('levels-description').textContent = `${draft ? 'Form' : 'Reported'} ${draft ? side.value : execution!.side} levels: ${levels.map(level => `${level.name} ${level.price.toFixed(2)}`).join(', ')}. Higher prices are above lower prices.`;
      }
      let positionOpen: boolean | null = null;
      function renderPosition(execution: ReturnType<typeof executionFields>, freshPrice: boolean) {
        const raw = latest?.execution;
        const open = !!raw && ['Open', 'Closing'].includes(execution.state);
        const strip = field('position-strip');
        // Announce and highlight only real transitions, not the first report after page load.
        if (positionOpen !== null && open !== positionOpen) {
          field('position-announce').textContent = open ? `Demo position opened: ${execution.side} ${execution.volume} at ${execution.entry}.` : 'Demo position closed.';
          strip.classList.remove('is-new');
          if (open) { void strip.offsetWidth; strip.classList.add('is-new'); }
        }
        positionOpen = open;
        strip.hidden = !open;
        field('position-idle').hidden = open;
        if (!open || !raw) return;
        const sell = raw.side === 'sell';
        field('position-side').textContent = execution.side;
        field('position-side-icon-sell').hidden = !sell;
        field('position-side-icon-buy').hidden = sell;
        field('position-volume').textContent = execution.volume;
        field('position-opened').textContent = execution.opened === '—' ? '' : `opened ${execution.opened}`;
        field('position-entry').textContent = execution.entry;
        field('position-sl').textContent = execution.sl;
        field('position-tp').textContent = execution.tp;
        const floating = latest?.pilot?.floating_usd;
        const pl = typeof floating === 'number' && Number.isFinite(floating) ? floating : null;
        roll(field('position-pl'), pl === null ? 'Not reported' : `${pl > 0 ? '+' : ''}${pl.toFixed(2)} USD`);
        field('position-pl-wrap').classList.toggle('text-green', pl !== null && pl > 0);
        field('position-pl-wrap').classList.toggle('text-loss', pl !== null && pl < 0);
        field('position-pl-up').hidden = !(pl !== null && pl > 0);
        field('position-pl-down').hidden = !(pl !== null && pl < 0);
        const entryAt = Math.min(100, Math.max(0, (raw.sl - raw.entry_price) / (raw.sl - raw.tp) * 100));
        if (Number.isFinite(entryAt)) {
          field('position-entry-tick').style.transform = `translateX(${entryAt}%)`;
          field('position-entry-label').style.left = `${entryAt}%`;
        }
        const rail = freshPrice ? positionRail(raw.side, raw.entry_price, raw.sl, raw.tp, latest!.health?.bid, latest!.health?.ask) : null;
        const meter = field('position-rail');
        meter.classList.toggle('is-stale', !rail);
        if (!rail) {
          field('position-progress').textContent = 'Waiting for a fresh price';
          meter.setAttribute('aria-valuetext', 'Waiting for a fresh price');
          return;
        }
        // Full-width layers moved by transform keep the motion on the compositor.
        field('position-marker').style.transform = `translateX(${rail.at}%)`;
        const fill = field('position-fill');
        fill.style.clipPath = `inset(0 ${100 - Math.max(rail.at, rail.entryAt)}% 0 ${Math.min(rail.at, rail.entryAt)}%)`;
        fill.classList.toggle('is-gain', rail.progress >= 0);
        field('position-price').textContent = rail.price.toFixed(2);
        const summary = `Exit price ${rail.price.toFixed(2)}, ${Math.round(Math.abs(rail.progress) * 100)}% of the way from entry to ${rail.progress >= 0 ? 'target' : 'stop'}.`;
        field('position-progress').textContent = summary;
        meter.setAttribute('aria-valuenow', String(Math.round(rail.at)));
        meter.setAttribute('aria-valuetext', summary);
      }
      function render() {
        renderLevels();
        window.dispatchEvent(new CustomEvent('trading-snapshot', { detail: chartSnapshot(latest) }));
        if (!latest) return;
        const fields = statusFields(latest);
        const isPilot = latest.mode === 'autonomous-demo';
        field('pilot-panel').hidden = !isPilot;
        field('manual-controls').hidden = isPilot || selected.symbol === 'BTCUSD';
        field('mode-note').textContent = isPilot ? 'Demo execution mode. Review pilot state and positions below.'
          : 'Live observation only. Signals do not place orders. Keep Algo Trading off for observation.';
        const pilot = pilotFields(latest.pilot, Date.now() / 1000, selected.symbol);
        field('pilot-strategy').textContent = pilot.state === 'Unknown' ? 'Strategy unavailable' : ['gold-ema-v1-m1-trend-3', 'btc-ema-v1-m15-trend-3'].includes(latest.pilot?.strategy) ? 'EMA trend · 3-bar slope · 5-minute cooldown after close' : 'EMA crossover · 3-bar slope filter';
        field('pilot-timeframe').textContent = pilot.state === 'Unknown' ? 'Strategy timeframe unavailable' : ['gold-ema-v1-m1-slope-3', 'gold-ema-v1-m1-trend-3'].includes(latest.pilot?.strategy) ? 'Completed 1-minute candles only - M1 demo' : 'Completed 15-minute candles only - M15 demo';
        if (pilot.state === 'Paused' && field('pilot-message').textContent?.startsWith('Pause requested.')) field('pilot-message').textContent = 'New entries are paused.';
        for (const key of ['state', 'reason', 'realized', 'floating', 'count', 'remaining'] as const) field(`pilot-${key}`).textContent = pilot[key];
        // render() runs every second, so the countdown ticks between status reports.
        const left = typeof latest.pilot?.ends_at === 'number' ? Math.floor(latest.pilot.ends_at - Date.now() / 1000) : 0;
        if (pilot.state !== 'Unknown' && left > 0) field('pilot-remaining').textContent = `${left >= 86400 ? `${Math.floor(left / 86400)}d ` : ''}${String(Math.floor(left % 86400 / 3600)).padStart(2, '0')}h ${String(Math.floor(left % 3600 / 60)).padStart(2, '0')}m ${String(left % 60).padStart(2, '0')}s`;
        (field('pilot-pause') as HTMLButtonElement).disabled = designPreview || !isPilot || !pilot.canPause || Date.now() - receivedAt > 30000;
        field('pilot-trades').replaceChildren(...(pilot.trades.length ? pilot.trades : ['No completed trades reported.']).map((text: string) => {
          const item = document.createElement('li'); item.textContent = text; return item;
        }));
        if (Date.now() - receivedAt > 30000) fields.delivery = 'No recent API response';
        for (const [id, value] of Object.entries(fields)) if (id !== 'price') field(id).textContent = value;
        const bid = latest.health?.bid;
        if (fields.price !== '—' && typeof bid === 'number' && lastBid !== null && bid !== lastBid) flash(field('price'), bid > lastBid);
        lastBid = fields.price === '—' ? null : bid ?? null;
        roll(field('price'), fields.price);
        const execution = executionFields(latest.execution);
        renderPosition(execution, fields.price !== '—');
        field('pilot-position').textContent = pilot.state === 'Unknown' ? 'Unknown'
          : execution.state === 'Disarmed' ? 'No open position'
          : `${execution.state} · ${execution.side} · ${execution.volume}`;
        field('pilot-intent').textContent = pilot.state !== 'Active' ? pilot.state
          : fields.price === '—' ? 'Waiting for healthy data'
          : execution.state === 'Unknown' ? 'Checking execution state'
          : execution.state === 'Open' ? 'Managing a demo trade'
          : ['Pending', 'Armed', 'Submitting', 'Closing', 'Needs attention'].includes(execution.state) ? execution.state
          : 'Waiting for a setup';
        field('pilot-levels').textContent = pilot.state === 'Unknown' ? '—' : `${execution.entry} / ${execution.sl} / ${execution.tp}`;
        for (const id of ['state', 'entry', 'sl', 'tp', 'opened', 'closed', 'updated', 'guidance'] as const) field(`execution-${id}`).textContent = execution[id];
        field('execution-summary').textContent = execution.state === 'Unknown' ? 'No current report'
          : [execution.side, execution.volume, execution.result].filter(value => value !== '—').join(' · ') || execution.state;
        const state = latest.execution?.status;
        const resolved = state === 'closed' || state === 'disarmed';
        if (startedAt && latest.execution && latest.execution.updated_at > startedAt && resolved) {
          startedAt = 0;
          side.disabled = false;
          for (const input of [entry, sl, tp]) input.disabled = false;
          field('control-message').textContent = 'Attempt finished. Review the result and turn Algo Trading off in MT5.';
        }
        prepare.disabled = selected.symbol === 'BTCUSD' || isPilot || !!previewToken || !!startedAt || !resolved || fields.state !== 'Observing';
        start.disabled = selected.symbol === 'BTCUSD' || isPilot || !previewToken || !resolved || Date.now() - receivedAt > 30000;
      }

      async function control(action: 'preview' | 'arm' | 'pilot-pause', body: object) {
        const response = await fetch(`/api/trading/${action}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
          cache: 'no-store', credentials: 'same-origin', redirect: 'manual', signal: AbortSignal.timeout(60000),
        });
        if (response.type === 'opaqueredirect' || [401, 403].includes(response.status)) throw new Error('Sign in through Cloudflare Access first.');
        const result = await response.json();
        if (!response.ok) throw new Error(typeof result.error === 'string' ? result.error : 'Demo control is unavailable.');
        return result;
      }

      field('pilot-pause').addEventListener('click', async () => {
        (field('pilot-pause') as HTMLButtonElement).disabled = true;
        try {
          await control('pilot-pause', { symbol: selected.symbol });
          field('pilot-message').textContent = 'Pause requested. Waiting for the runner to confirm.';
          await load();
        } catch (error) {
          field('pilot-message').textContent = error instanceof Error ? error.message : 'Pause failed. Check the runner.';
        }
      });

      form.addEventListener('input', () => {
        if (!previewToken) { renderLevels(); return; }
        previewToken = null;
        previewBox.hidden = true;
        prepare.hidden = false;
        field('control-message').textContent = 'Prices changed. Preview the order again before placing it.';
        render();
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        prepare.disabled = true;
        side.disabled = true;
        for (const input of [entry, sl, tp]) input.disabled = true;
        field('control-message').textContent = 'Checking the demo account and preparing a no-order preview…';
        try {
          const result = await control('preview', { side: side.value, entry: entry.valueAsNumber,
            sl: sl.valueAsNumber, tp: tp.valueAsNumber });
          const p = result.preview;
          previewToken = result.token;
          field('preview-summary').textContent = `${p.order_kind} · ${p.volume} lot · entry ${p.quote_reference.toFixed(2)} · stop ${p.sl.toFixed(2)} · target ${p.tp.toFixed(2)}.`;
          field('preview-protection').textContent = `Modeled loss at stop: $${p.modeled_stop_usd.toFixed(2)} (${p.modeled_stop_pct_of_equity.toFixed(5)}% of equity), before fees, slippage or gaps.`;
          start.textContent = `Place one ${p.order_kind.toLowerCase()} order`;
          previewBox.hidden = false;
          prepare.hidden = true;
          side.disabled = false;
          for (const input of [entry, sl, tp]) input.disabled = false;
          field('control-message').textContent = 'No order was placed by this preview. Review it, then enable Algo Trading in MT5.';
          render();
        } catch (error) {
          side.disabled = false;
          for (const input of [entry, sl, tp]) input.disabled = false;
          field('control-message').textContent = error instanceof Error ? error.message : 'Preview failed.';
          render();
        }
      });

      start.addEventListener('click', async () => {
        if (!previewToken) return;
        start.disabled = true;
        field('control-message').textContent = 'Starting one demo attempt. Watch MT5 and the status below.';
        try {
          await control('arm', { token: previewToken });
          previewToken = null;
          startedAt = Date.now() / 1000;
          previewBox.hidden = true;
          prepare.hidden = false;
          side.disabled = true;
          for (const input of [entry, sl, tp]) input.disabled = true;
          field('control-message').textContent = 'Order request accepted. Watch MT5 for a pending order or position. Cancel a pending order in MT5 if needed.';
          load();
        } catch (error) {
          previewToken = null;
          startedAt = Date.now() / 1000;
          previewBox.hidden = true;
          prepare.hidden = false;
          side.disabled = true;
          for (const input of [entry, sl, tp]) input.disabled = true;
          field('control-message').textContent = `${error instanceof Error ? error.message : 'Start failed.'} Check MT5 for a position or order before reloading this page.`;
          render();
        }
      });

      async function load() {
        if (refresh.disabled) return;
        refresh.disabled = true;
        try {
          if (localPreview) throw new Error('local-preview');
          const response = await fetch('/api/trading/status' + selected.query, { cache: 'no-store', credentials: 'same-origin', redirect: 'manual', signal: AbortSignal.timeout(8000) });
          if (response.type === 'opaqueredirect' || [401, 403].includes(response.status)) throw new Error('access');
          if (!response.ok) throw new Error('unavailable');
          if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('unavailable');
          const data = await response.json();
          if (!['signal-only', 'autonomous-demo'].includes(data.mode) || data.symbol !== selected.symbol) throw new Error('unavailable');
          signIn.hidden = true;
          latest = data;
          receivedAt = Date.now();
          if (entryNotification(data, receivedAt / 1000, !document.hidden) && soundEnabled) void playEntrySound();
          if (data.checked_at !== lastCheck) {
            lastCheck = data.checked_at;
            const fields = statusFields(data);
            checks.unshift(`${fields.checked} · ${fields.signal} · ${fields.reason}`);
            checks.length = Math.min(checks.length, 6);
            field('monitor-activity').replaceChildren(...checks.map(text => {
              const item = document.createElement('li'); item.textContent = text; return item;
            }));
          }
          render();
        } catch (error) {
          entryNotification(null, Date.now() / 1000);
          latest = null;
          field('position-strip').hidden = true;
          field('position-idle').hidden = false;
          lastBid = null;
          window.dispatchEvent(new CustomEvent('trading-snapshot', { detail: chartSnapshot(null) }));
          field('pilot-intent').textContent = 'Status unavailable';
          field('pilot-strategy').textContent = 'Strategy unavailable';
          field('pilot-timeframe').textContent = 'Strategy timeframe unavailable';
          (field('pilot-pause') as HTMLButtonElement).disabled = true;
          const pilot = pilotFields(null);
          for (const key of ['state', 'reason', 'realized', 'floating', 'count', 'remaining'] as const) field(`pilot-${key}`).textContent = pilot[key];
          field('pilot-position').textContent = 'Unknown';
          field('pilot-levels').textContent = '—';
          field('pilot-trades').replaceChildren();
          field('pilot-message').textContent = '';
          prepare.disabled = true;
          start.disabled = true;
          const needsAccess = error instanceof Error && error.message === 'access';
          field('state').textContent = needsAccess ? 'Sign-in required' : 'Unavailable';
          field('delivery').textContent = needsAccess ? 'Sign-in required' : 'Status path unavailable';
          field('heartbeat').textContent = 'Unknown';
          field('connection').textContent = 'Unknown — status unavailable';
          field('freshness').textContent = 'Unknown';
          roll(field('price'), '—');
          for (const id of ['tick', 'age', 'history', 'strategy']) field(id).textContent = '—';
          field('candle').textContent = '—';
          field('signal').textContent = '—';
          field('checked').textContent = '—';
          field('reason').textContent = localPreview ? 'Live MT5 status is available on the hosted page. You can play the synthetic replay here.'
            : needsAccess ? 'Sign in through Cloudflare Access to view this status.' : 'The private status API is unavailable. Try again shortly.';
          if (localPreview) {
            field('state').textContent = 'Local preview';
            field('connection').textContent = 'Not connected here';
            refresh.hidden = true;
          }
          field('guidance').textContent = field('reason').textContent;
          const execution = executionFields(null);
          for (const id of ['state', 'entry', 'sl', 'tp', 'opened', 'closed', 'updated', 'guidance'] as const) field(`execution-${id}`).textContent = execution[id];
          field('execution-summary').textContent = 'No current report';
          renderLevels();
          signIn.hidden = !needsAccess;
        } finally {
          refresh.disabled = false;
        }
      }

      refresh.addEventListener('click', load);
      window.addEventListener('trading-chart-ready', render);
      window.setInterval(() => { if (!document.hidden) load(); }, designPreview ? 2000 : 10000);
      window.setInterval(() => { if (!document.hidden) render(); }, 1000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) { render(); load(); } });
      load();
    </script>

    <style lang="scss">
      // Demo-page parts only; the shared desk theme lives in src/styles/desk.scss.
      // Stop -> entry -> target rail
      .position-rail { margin-top: 1.5rem; padding-top: 2.5rem; }
      .position-rail__track { position: relative; height: .625rem; border-radius: 999px; background: linear-gradient(90deg, rgba(var(--desk-red-rgb), .22), var(--desk-mint-2) 35%, var(--desk-mint-2) 65%, rgba(var(--desk-green-rgb), .28)); }
      .position-rail__fill { position: absolute; inset: 0; border-radius: inherit; background: var(--desk-red); transition: clip-path 600ms var(--ease-in-out); }
      .position-rail__fill.is-gain { background: linear-gradient(90deg, var(--desk-green), var(--desk-green-bright)); }
      .position-rail__entry, .position-rail__pos { position: absolute; inset: 0; pointer-events: none; transition: transform 600ms var(--ease-in-out); }
      .position-rail__entry::before { content: ''; position: absolute; left: 0; top: -.5rem; width: 2px; height: 1.625rem; margin-left: -1px; border-radius: 2px; background: var(--desk-ink); }
      .position-rail__dot { position: absolute; left: 0; top: 50%; width: 1.375rem; height: 1.375rem; margin: -.6875rem 0 0 -.6875rem; border-radius: 50%; background: var(--desk-green); border: 4px solid #fff; box-shadow: 0 0 0 1px var(--desk-line), 0 6px 16px -4px rgba(var(--desk-green-rgb), .6); }
      .position-rail__dot::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--desk-green-bright); animation: desk-ripple 2s var(--ease-out) infinite; }
      .position-rail__price { position: absolute; left: 0; bottom: 1.25rem; transform: translateX(-50%); padding: .125rem .5rem; border-radius: 8px; background: var(--desk-green-deep); color: #fff; font-family: var(--tblr-font-monospace); font-size: .8125rem; white-space: nowrap; }
      .position-rail__labels { position: relative; display: flex; justify-content: space-between; gap: .5rem; margin-top: .875rem; min-height: 1.25rem; font-size: .875rem; }
      .position-rail__entry-label { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; color: var(--desk-muted); }
      .position-rail.is-stale .position-rail__pos, .position-rail.is-stale .position-rail__fill { opacity: 0; }


      // Chart island (React renders outside Astro's scoped styles, so these are global).
      :global(.desk-muted) { color: var(--desk-muted); }
      :global(.trading-charts__tabs) { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 4px; margin-bottom: 1.25rem; border-radius: 999px; background: var(--desk-mint-2); }
      :global(.trading-charts__tab) { position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center; gap: .375rem; min-height: 40px; padding: 0 .5rem; border: 0; border-radius: 999px; background: none; color: var(--desk-muted); font: inherit; font-size: .875rem; font-weight: 500; cursor: pointer; transition: color 200ms ease; }
      :global(.trading-charts__tab[data-state='active']) { color: var(--desk-green-deep); }
      :global(.trading-charts__tab:focus-visible) { outline: 2px solid var(--desk-green); outline-offset: 2px; }
      :global(.trading-charts__tab .icon) { width: 1rem; height: 1rem; }
      :global(.trading-charts__indicator) { position: absolute; top: 4px; bottom: 4px; left: 0; border-radius: 999px; background: #fff; box-shadow: 0 1px 2px rgba(var(--desk-green-rgb), .18); transition: transform 350ms var(--ease-in-out), width 350ms var(--ease-in-out); }
      :global(.trading-charts__title) { margin: 0; font-size: 1rem; font-weight: 600; color: var(--desk-ink); }
      :global(.trading-charts .empty-icon) { color: var(--desk-green); }
      :global(.trading-charts .list-group-item) { background: transparent; border-color: var(--desk-line); }
      @media (max-width: 575.98px) { :global(.trading-charts__tab .icon) { display: none; } }
      @media (prefers-reduced-motion: reduce) { :global(.trading-charts__indicator) { transition: none; } }

      // Manual-order levels diagram (SVG geometry, not layout spacing).
      .trade__chart svg { display: block; width: 100%; margin: 1rem 0; overflow: visible; }
      .trade__chart line { stroke: var(--desk-muted); stroke-width: 1; }
      .trade__chart .trade__axis { stroke: var(--desk-line); }
      .trade__chart circle { fill: var(--desk-ink); }
      .trade__chart g:not(#level-entry) line { stroke-dasharray: 4 4; }
      #level-stop circle { fill: var(--desk-red); }
      #level-target circle { fill: var(--desk-green); }
      .trade__chart text { fill: var(--desk-muted); font-size: 1rem; }
      .trade__chart .trade__level-price { fill: var(--desk-ink); font-family: var(--tblr-font-monospace); }
      @media (max-width: 575.98px) { .position-rail__entry-label { display: none; } }
      @media (prefers-reduced-motion: reduce) {
        .position-rail__dot::after { animation: none; opacity: 0; }
        .position-rail__pos, .position-rail__entry, .position-rail__fill { transition: none; }
      }
    </style>
  </body>
</html>
