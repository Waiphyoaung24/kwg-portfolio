---
import '../../styles/index.scss';
import '../../styles/trading-console.scss';
import TradingNavigation from '../../components/TradingNavigation.astro';
import TradingReplay from '../../components/TradingReplay.astro';
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Browser theme-color metadata cannot resolve a CSS variable. -->
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="noindex" />
    <title>Demo account monitor — Gold operations — KWG</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400&family=JetBrains+Mono:wght@400&display=swap" />
  </head>
  <body class="trading-console">
    <main class="page">
      <TradingNavigation current="demo" />
      {import.meta.env.DEV && import.meta.env.PUBLIC_TRADING_PILOT_FIXTURE === '1' && <p class="page__note" role="note">Local design preview · simulated quotes update every 2 seconds. All prices and trades are sample data. Trading controls are disabled.</p>}
      <header class="page__intro" id="trading-content" tabindex="-1">
        <div class="console-brand"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M26.2636 20.4752L29.7034 6.2832H22.8238L26.2636 20.4752ZM12.2636 6.2832L17.0473 26.0199H23.9568L19.1731 6.2832H12.2636ZM8.61287 6.28336L1.70337 6.28373L6.48706 26.0203L13.3966 26.02L8.61287 6.28336Z" /></svg><span class="micro">KWG / Gold operations</span></div>
        <h1>Gold, under observation.</h1>
        <p>Your demo pilot, its next move, and the evidence behind each trade.</p>
      </header>
      <div class="console-workspace">
      <section class="card status console-market" aria-labelledby="status-title">
        <div class="status__head">
          <h2 id="status-title">Live demo feed</h2>
          <button class="pill-btn console-refresh" id="refresh" type="button" aria-label="Refresh status"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M5.5 8a7 7 0 0 1 11.8-2L20 9M4 15l2.7 3A7 7 0 0 0 18.5 16" /></svg>Refresh</button>
        </div>
        <div class="console-market__meta"><p class="status__symbol micro">XAUUSD-VIP · VT Markets demo</p><span class="status__state label" id="state" aria-live="polite">Checking</span></div>
        <p class="status__price"><span class="label">Bid / ask · USD</span><span id="price">—</span></p>
        <div id="trading-charts"><p class="page__note">Loading chart views…</p></div>
        <dl class="status__rows status__checks">
          <div><dt class="label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M8 12h8M9 5H6a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h3m6-14h3a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-3" /></svg>MT5 connection</dt><dd id="connection">Checking</dd></div>
          <div><dt class="label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>Gold price</dt><dd id="freshness">Checking</dd></div>
          <div><dt class="label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="m3 17 6-6 4 3 8-9m-6 0h6v6" /></svg>Strategy signal</dt><dd id="signal">Checking</dd></div>
        </dl>
        <p class="status__guidance" id="guidance" role="status">Connecting to the private status API.</p>
        <p class="page__note" id="mode-note">Live observation only. Signals do not place orders. Keep Algo Trading off for observation.</p>
        <div class="console-tools">
        <details class="status__activity">
          <summary class="pill-btn">Recent checks <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
          <p class="page__note">Up to six checks from this page session.</p>
          <ol id="monitor-activity"><li>Waiting for the first status report.</li></ol>
        </details>
        <details class="status__details">
          <summary class="pill-btn">Technical details <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
          <dl class="status__rows">
            <div><dt class="label">Status delivery</dt><dd id="delivery">Checking</dd></div>
            <div><dt class="label">Observer heartbeat</dt><dd id="heartbeat">Checking</dd></div>
            <div><dt class="label">Last quote</dt><dd id="tick">—</dd></div>
            <div><dt class="label">Quote age at check</dt><dd id="age">—</dd></div>
            <div><dt class="label">Completed-candle history</dt><dd id="history">Checking</dd></div>
            <div><dt class="label">Latest fetched candle · opened</dt><dd id="candle">—</dd></div>
            <div><dt class="label">Strategy readiness</dt><dd id="strategy">Checking</dd></div>
            <div><dt class="label">Last checked</dt><dd id="checked">—</dd></div>
          </dl>
          <p class="status__reason" id="reason">Checking</p>
        </details>
        </div>
        <div class="status__actions">
          <a class="pill-btn" id="sign-in" href="/api/trading/status" hidden>Sign in to status</a>
        </div>
      </section>
      <section class="card status console-pilot" id="pilot-panel" aria-labelledby="pilot-title" hidden>
        <div class="status__head"><h2 id="pilot-title">Autonomous demo pilot</h2><span class="label" id="pilot-state" aria-live="polite">Checking</span></div>
        <p class="status__symbol micro">Unqualified demo</p>
        <h3 class="console-pilot__intent" id="pilot-intent">Waiting for status</h3>
        <p class="status__guidance" id="pilot-reason" role="status">Checking</p>
        <dl class="status__rows">
          <div><dt class="label">Realized net</dt><dd id="pilot-realized">—</dd></div>
          <div><dt class="label">Floating profit</dt><dd id="pilot-floating">—</dd></div>
          <div><dt class="label">Completed trades</dt><dd id="pilot-count">—</dd></div>
          <div><dt class="label">Time remaining</dt><dd id="pilot-remaining">—</dd></div>
          <div><dt class="label">Position / latest attempt</dt><dd id="pilot-position">—</dd></div>
          <div><dt class="label">Entry / stop / target</dt><dd id="pilot-levels">—</dd></div>
        </dl>
        <div class="console-strategy"><h3>One fixed strategy</h3><svg viewBox="0 0 280 60" role="img" aria-label="Illustration of two moving averages crossing. Not market data."><path d="M4 45C50 45 65 38 110 30S180 14 276 12" /><path d="M4 14C75 14 100 25 150 31S220 38 276 43" stroke-dasharray="5 5" /></svg><p><span id="pilot-strategy">Waiting for strategy</span><br /><span id="pilot-timeframe">Waiting for strategy timeframe</span></p><dl><div><dt>Position size</dt><dd>0.01 lot · one position</dd></div><div><dt>Stop / target</dt><dd>2× / 3× ATR</dd></div><div><dt>Entry risk ceiling</dt><dd>0.1% of equity</dd></div></dl></div>
        <button class="pill-btn" id="pilot-pause" type="button" disabled>Pause new entries</button>
        <p class="page__note">Pausing keeps existing positions protected and monitored. At expiry, the pilot requests closure; unresolved positions need owner attention. Floating profit excludes costs not yet booked.</p>
        <p id="pilot-message" role="status"></p>
        <details class="status__activity console-trade-history"><summary class="pill-btn">Recent completed trades <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary><ol id="pilot-trades"></ol></details>
      </section>
      </div>
      <div id="trading-replay-source" hidden><TradingReplay /></div>
      <details class="manual-controls" id="manual-controls">
      <summary class="pill-btn">Manual demo order controls</summary>
      <section class="card status" aria-labelledby="control-title">
        <div class="status__head">
          <h2 id="control-title">Prepare one trade</h2>
          <span class="status__state label">Manual · demo</span>
        </div>
        <p class="status__symbol">XAUUSD-VIP · 0.01 lot · broker-held stop loss and take profit</p>
        <ol class="trade__steps" aria-label="Demo order steps">
          <li><span class="micro">1</span>Set prices</li>
          <li><span class="micro">2</span>Preview · no order</li>
          <li><span class="micro">3</span>Place once</li>
        </ol>
        <div class="trade__workspace">
        <div class="trade__setup">
        <form id="trade-form" class="trade__form">
          <div class="trade__fields">
            <label class="trade__field"><span class="label">Direction</span><select id="trade-side" aria-label="Demo trade direction"><option value="buy">Buy</option><option value="sell">Sell</option></select></label>
            <label class="trade__field"><span class="label">Entry price</span><input id="trade-entry" type="number" inputmode="decimal" min="0.01" max="1000000" step="0.01" placeholder="Price" required /></label>
            <label class="trade__field"><span class="label">Stop loss</span><input id="trade-sl" type="number" inputmode="decimal" min="0.01" max="1000000" step="0.01" placeholder="Price" required /></label>
            <label class="trade__field"><span class="label">Take profit</span><input id="trade-tp" type="number" inputmode="decimal" min="0.01" max="1000000" step="0.01" placeholder="Price" required /></label>
          </div>
          <p class="page__note">Choose prices from MT5. Buy: stop below entry, target above. Sell: target below entry, stop above.</p>
          <div class="trade__actions">
            <button class="pill-btn" id="prepare-trade" type="submit" disabled>Preview pending order</button>
            <a class="pill-btn" href="http://127.0.0.1:6081/vnc.html?autoconnect=1&amp;resize=scale" target="_blank" rel="noopener noreferrer">Open MT5 desktop ↗</a>
          </div>
        </form>
        <p class="page__note">Keep Algo Trading off for the preview. The MT5 desktop link needs your SSH tunnel to port 6081.</p>
        <div id="trade-preview" class="trade__preview" hidden>
          <h3>Review before starting</h3>
          <p id="preview-summary"></p>
          <p id="preview-protection"></p>
          <p>This preview expires after 10 minutes. Enable Algo Trading in MT5, then place this one pending order. Prices, account and broker conditions are checked again first.</p>
          <p>The pending order stays until you cancel it in MT5.</p>
          <button class="pill-btn" id="start-trade" type="button">Place one pending order</button>
        </div>
        <p id="control-message" role="status" aria-live="polite"></p>
        </div>
        <figure class="trade__chart" aria-labelledby="levels-title levels-caption">
          <h3 id="levels-title">Entry / stop / target</h3>
          <p class="micro" id="levels-source">Waiting for a report</p>
          <!-- Fixed SVG coordinates are diagram geometry, not design-system spacing. -->
          <div id="levels-plot" hidden>
          <svg id="levels-chart" viewBox="0 0 400 260" role="img" aria-labelledby="levels-description">
            <title id="levels-description">Trade price levels</title>
            <line class="trade__axis" x1="136" x2="136" y1="20" y2="240" />
            <g id="level-stop"><line x1="136" x2="290" /><circle cx="136" r="4" /><text x="0" class="trade__level-label">Stop loss</text><text x="400" text-anchor="end" class="trade__level-price"></text></g>
            <g id="level-entry"><line x1="136" x2="290" /><circle cx="136" r="4" /><text x="0" class="trade__level-label">Entry</text><text x="400" text-anchor="end" class="trade__level-price"></text></g>
            <g id="level-target"><line x1="136" x2="290" /><circle cx="136" r="4" /><text x="0" class="trade__level-label">Take profit</text><text x="400" text-anchor="end" class="trade__level-price"></text></g>
          </svg>
          </div>
          <p class="trade__empty" id="levels-empty">Enter entry, stop loss and take profit to see their price levels.</p>
          <figcaption id="levels-caption" class="page__note">Price levels only. This is not a market chart or a forecast.</figcaption>
        </figure>
        </div>
        <div class="trade__result">
          <div class="status__head"><h3>Latest attempt</h3><span class="status__state label" id="execution-state" aria-live="polite">Checking</span></div>
          <p id="execution-summary">Checking</p>
          <p class="status__guidance" id="execution-guidance">Connecting to the private status API.</p>
        <details class="status__details">
          <summary class="pill-btn">Trade details <span aria-hidden="true">⌄</span></summary>
          <dl class="status__rows">
            <div><dt class="label">Entry price</dt><dd id="execution-entry">—</dd></div>
            <div><dt class="label">Stop loss</dt><dd id="execution-sl">—</dd></div>
            <div><dt class="label">Take profit</dt><dd id="execution-tp">—</dd></div>
            <div><dt class="label">Opened</dt><dd id="execution-opened">—</dd></div>
            <div><dt class="label">Closed</dt><dd id="execution-closed">—</dd></div>
            <div><dt class="label">Last report</dt><dd id="execution-updated">—</dd></div>
          </dl>
        </details>
        </div>
      </section>
      <p class="page__note">Status updates every 10 seconds. This control starts only a reviewed, single demo attempt; it does not run the strategy continuously.</p>
      </details>
    </main>
    <script is:inline type="module" src="/dashboard-assets/trading.js"></script>

    <script>
      import { executionFields, statusFields } from '../../scripts/trading-status.mjs';
      import { pilotFields } from '../../scripts/trading-pilot.mjs';
      import { tradeLevels } from '../../scripts/trading-levels.mjs';
      import { chartSnapshot } from '../../scripts/trading-chart.mjs';
      const field = (id: string) => document.getElementById(id)!;
      const refresh = field('refresh') as HTMLButtonElement;
      const signIn = field('sign-in') as HTMLAnchorElement;
      const prepare = field('prepare-trade') as HTMLButtonElement;
      const start = field('start-trade') as HTMLButtonElement;
      const side = field('trade-side') as HTMLSelectElement;
      const form = field('trade-form') as HTMLFormElement;
      const entry = field('trade-entry') as HTMLInputElement;
      const sl = field('trade-sl') as HTMLInputElement;
      const tp = field('trade-tp') as HTMLInputElement;
      const previewBox = field('trade-preview');
      const fixturePreview = import.meta.env.DEV && import.meta.env.PUBLIC_TRADING_FIXTURE === '1';
      const designPreview = fixturePreview && import.meta.env.PUBLIC_TRADING_PILOT_FIXTURE === '1';
      const localPreview = !fixturePreview && (['localhost', '127.0.0.1', '[::1]'].includes(location.hostname) || location.protocol === 'file:');
      let latest: Parameters<typeof statusFields>[0] | null = null;
      let receivedAt = 0;
      let previewToken: string | null = null;
      let startedAt = 0;
      let lastCheck: number | null = null;
      const checks: string[] = [];
      function renderLevels() {
        const draft = [entry, sl, tp].some(input => input.value !== '' || input.validity.badInput);
        const execution = latest ? executionFields(latest.execution) : null;
        const levels = draft ? [entry, sl, tp].every(input => input.validity.valid) && tradeLevels(side.value, entry.valueAsNumber, sl.valueAsNumber, tp.valueAsNumber)
          : execution && tradeLevels(latest!.execution?.side, Number(execution.entry), Number(execution.sl), Number(execution.tp));
        field('levels-plot').hidden = !levels;
        field('levels-empty').hidden = !!levels;
        field('levels-source').textContent = draft ? startedAt ? 'Submitted levels · confirm in MT5'
          : previewToken ? 'Previewed levels · no order placed' : 'Draft levels · not broker checked'
          : execution && execution.state !== 'Unknown' ? `${execution.state === 'Closed' ? 'Historical' : 'Reported'} ${execution.side} · ${execution.volume}` : 'No reported levels';
        field('levels-empty').textContent = draft
          ? 'Complete all three prices. Buy: stop < entry < target. Sell: target < entry < stop.'
          : 'Enter entry, stop loss and take profit to see their price levels.';
        if (!levels) return;
        for (const [index, id] of ['level-stop', 'level-entry', 'level-target'].entries()) {
          const level = levels[index];
          const group = field(id);
          group.querySelector('line')!.setAttribute('y1', String(level.y));
          group.querySelector('line')!.setAttribute('y2', String(level.labelY));
          group.querySelector('circle')!.setAttribute('cy', String(level.y));
          for (const text of group.querySelectorAll('text')) text.setAttribute('y', String(level.labelY - 10));
          group.querySelector('.trade__level-price')!.textContent = level.price.toFixed(2);
        }
        field('levels-description').textContent = `${draft ? 'Form' : 'Reported'} ${draft ? side.value : execution!.side} levels: ${levels.map(level => `${level.name} ${level.price.toFixed(2)}`).join(', ')}. Higher prices are above lower prices.`;
      }
      function render() {
        renderLevels();
        window.dispatchEvent(new CustomEvent('trading-snapshot', { detail: chartSnapshot(latest) }));
        if (!latest) return;
        const fields = statusFields(latest);
        const isPilot = latest.mode === 'autonomous-demo';
        field('pilot-panel').hidden = !isPilot;
        field('manual-controls').hidden = isPilot;
        field('mode-note').textContent = isPilot ? 'Demo execution mode. Review pilot state and positions below.'
          : 'Live observation only. Signals do not place orders. Keep Algo Trading off for observation.';
        const pilot = pilotFields(latest.pilot);
        field('pilot-strategy').textContent = pilot.state === 'Unknown' ? 'Strategy unavailable' : latest.pilot?.strategy === 'gold-ema-v1-m1-trend-3' ? 'EMA trend · 3-bar slope · 5-minute cooldown after close' : 'EMA crossover · 3-bar slope filter';
        field('pilot-timeframe').textContent = pilot.state === 'Unknown' ? 'Strategy timeframe unavailable' : ['gold-ema-v1-m1-slope-3', 'gold-ema-v1-m1-trend-3'].includes(latest.pilot?.strategy) ? 'Completed 1-minute candles only - M1 demo' : 'Completed 15-minute candles only - M15 demo';
        if (pilot.state === 'Paused' && field('pilot-message').textContent?.startsWith('Pause requested.')) field('pilot-message').textContent = 'New entries are paused.';
        for (const key of ['state', 'reason', 'realized', 'floating', 'count', 'remaining'] as const) field(`pilot-${key}`).textContent = pilot[key];
        (field('pilot-pause') as HTMLButtonElement).disabled = designPreview || !isPilot || !pilot.canPause || Date.now() - receivedAt > 30000;
        field('pilot-trades').replaceChildren(...(pilot.trades.length ? pilot.trades : ['No completed trades reported.']).map((text: string) => {
          const item = document.createElement('li'); item.textContent = text; return item;
        }));
        if (Date.now() - receivedAt > 30000) fields.delivery = 'No recent API response';
        for (const [id, value] of Object.entries(fields)) field(id).textContent = value;
        const execution = executionFields(latest.execution);
        field('pilot-position').textContent = pilot.state === 'Unknown' ? 'Unknown'
          : execution.state === 'Disarmed' ? 'No open position'
          : `${execution.state} · ${execution.side} · ${execution.volume}`;
        field('pilot-intent').textContent = pilot.state !== 'Active' ? pilot.state
          : fields.price === '—' ? 'Waiting for healthy data'
          : execution.state === 'Unknown' ? 'Checking execution state'
          : execution.state === 'Open' ? 'Managing a demo trade'
          : ['Pending', 'Armed', 'Submitting', 'Closing', 'Needs attention'].includes(execution.state) ? execution.state
          : 'Waiting for a setup';
        field('pilot-levels').textContent = pilot.state === 'Unknown' ? '—' : `${execution.entry} / ${execution.sl} / ${execution.tp}`;
        for (const id of ['state', 'entry', 'sl', 'tp', 'opened', 'closed', 'updated', 'guidance'] as const) field(`execution-${id}`).textContent = execution[id];
        field('execution-summary').textContent = execution.state === 'Unknown' ? 'No current report'
          : [execution.side, execution.volume, execution.result].filter(value => value !== '—').join(' · ') || execution.state;
        const state = latest.execution?.status;
        const resolved = state === 'closed' || state === 'disarmed';
        if (startedAt && latest.execution && latest.execution.updated_at > startedAt && resolved) {
          startedAt = 0;
          side.disabled = false;
          for (const input of [entry, sl, tp]) input.disabled = false;
          field('control-message').textContent = 'Attempt finished. Review the result and turn Algo Trading off in MT5.';
        }
        prepare.disabled = isPilot || !!previewToken || !!startedAt || !resolved || fields.state !== 'Observing';
        start.disabled = isPilot || !previewToken || !resolved || Date.now() - receivedAt > 30000;
      }

      async function control(action: 'preview' | 'arm' | 'pilot-pause', body: object) {
        const response = await fetch(`/api/trading/${action}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
          cache: 'no-store', credentials: 'same-origin', redirect: 'manual', signal: AbortSignal.timeout(60000),
        });
        if (response.type === 'opaqueredirect' || [401, 403].includes(response.status)) throw new Error('Sign in through Cloudflare Access first.');
        const result = await response.json();
        if (!response.ok) throw new Error(typeof result.error === 'string' ? result.error : 'Demo control is unavailable.');
        return result;
      }

      field('pilot-pause').addEventListener('click', async () => {
        (field('pilot-pause') as HTMLButtonElement).disabled = true;
        try {
          await control('pilot-pause', {});
          field('pilot-message').textContent = 'Pause requested. Waiting for the runner to confirm.';
          await load();
        } catch (error) {
          field('pilot-message').textContent = error instanceof Error ? error.message : 'Pause failed. Check the runner.';
        }
      });

      form.addEventListener('input', () => {
        if (!previewToken) { renderLevels(); return; }
        previewToken = null;
        previewBox.hidden = true;
        prepare.hidden = false;
        field('control-message').textContent = 'Prices changed. Preview the order again before placing it.';
        render();
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        prepare.disabled = true;
        side.disabled = true;
        for (const input of [entry, sl, tp]) input.disabled = true;
        field('control-message').textContent = 'Checking the demo account and preparing a no-order preview…';
        try {
          const result = await control('preview', { side: side.value, entry: entry.valueAsNumber,
            sl: sl.valueAsNumber, tp: tp.valueAsNumber });
          const p = result.preview;
          previewToken = result.token;
          field('preview-summary').textContent = `${p.order_kind} · ${p.volume} lot · entry ${p.quote_reference.toFixed(2)} · stop ${p.sl.toFixed(2)} · target ${p.tp.toFixed(2)}.`;
          field('preview-protection').textContent = `Modeled loss at stop: $${p.modeled_stop_usd.toFixed(2)} (${p.modeled_stop_pct_of_equity.toFixed(5)}% of equity), before fees, slippage or gaps.`;
          start.textContent = `Place one ${p.order_kind.toLowerCase()} order`;
          previewBox.hidden = false;
          prepare.hidden = true;
          side.disabled = false;
          for (const input of [entry, sl, tp]) input.disabled = false;
          field('control-message').textContent = 'No order was placed by this preview. Review it, then enable Algo Trading in MT5.';
          render();
        } catch (error) {
          side.disabled = false;
          for (const input of [entry, sl, tp]) input.disabled = false;
          field('control-message').textContent = error instanceof Error ? error.message : 'Preview failed.';
          render();
        }
      });

      start.addEventListener('click', async () => {
        if (!previewToken) return;
        start.disabled = true;
        field('control-message').textContent = 'Starting one demo attempt. Watch MT5 and the status below.';
        try {
          await control('arm', { token: previewToken });
          previewToken = null;
          startedAt = Date.now() / 1000;
          previewBox.hidden = true;
          prepare.hidden = false;
          side.disabled = true;
          for (const input of [entry, sl, tp]) input.disabled = true;
          field('control-message').textContent = 'Order request accepted. Watch MT5 for a pending order or position. Cancel a pending order in MT5 if needed.';
          load();
        } catch (error) {
          previewToken = null;
          startedAt = Date.now() / 1000;
          previewBox.hidden = true;
          prepare.hidden = false;
          side.disabled = true;
          for (const input of [entry, sl, tp]) input.disabled = true;
          field('control-message').textContent = `${error instanceof Error ? error.message : 'Start failed.'} Check MT5 for a position or order before reloading this page.`;
          render();
        }
      });

      async function load() {
        if (refresh.disabled) return;
        refresh.disabled = true;
        try {
          if (localPreview) throw new Error('local-preview');
          const response = await fetch('/api/trading/status', { cache: 'no-store', credentials: 'same-origin', redirect: 'manual', signal: AbortSignal.timeout(8000) });
          if (response.type === 'opaqueredirect' || [401, 403].includes(response.status)) throw new Error('access');
          if (!response.ok) throw new Error('unavailable');
          if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('unavailable');
          const data = await response.json();
          if (!['signal-only', 'autonomous-demo'].includes(data.mode) || data.symbol !== 'XAUUSD-VIP') throw new Error('unavailable');
          signIn.hidden = true;
          latest = data;
          receivedAt = Date.now();
          if (data.checked_at !== lastCheck) {
            lastCheck = data.checked_at;
            const fields = statusFields(data);
            checks.unshift(`${fields.checked} · ${fields.signal} · ${fields.reason}`);
            checks.length = Math.min(checks.length, 6);
            field('monitor-activity').replaceChildren(...checks.map(text => {
              const item = document.createElement('li'); item.textContent = text; return item;
            }));
          }
          render();
        } catch (error) {
          latest = null;
          window.dispatchEvent(new CustomEvent('trading-snapshot', { detail: chartSnapshot(null) }));
          field('pilot-intent').textContent = 'Status unavailable';
          field('pilot-strategy').textContent = 'Strategy unavailable';
          field('pilot-timeframe').textContent = 'Strategy timeframe unavailable';
          (field('pilot-pause') as HTMLButtonElement).disabled = true;
          const pilot = pilotFields(null);
          for (const key of ['state', 'reason', 'realized', 'floating', 'count', 'remaining'] as const) field(`pilot-${key}`).textContent = pilot[key];
          field('pilot-position').textContent = 'Unknown';
          field('pilot-levels').textContent = '—';
          field('pilot-trades').replaceChildren();
          field('pilot-message').textContent = '';
          prepare.disabled = true;
          start.disabled = true;
          const needsAccess = error instanceof Error && error.message === 'access';
          field('state').textContent = needsAccess ? 'Sign-in required' : 'Unavailable';
          field('delivery').textContent = needsAccess ? 'Sign-in required' : 'Status path unavailable';
          field('heartbeat').textContent = 'Unknown';
          field('connection').textContent = 'Unknown — status unavailable';
          field('freshness').textContent = 'Unknown';
          field('price').textContent = '—';
          for (const id of ['tick', 'age', 'history', 'strategy']) field(id).textContent = '—';
          field('candle').textContent = '—';
          field('signal').textContent = '—';
          field('checked').textContent = '—';
          field('reason').textContent = localPreview ? 'Live MT5 status is available on the hosted page. You can play the synthetic replay here.'
            : needsAccess ? 'Sign in through Cloudflare Access to view this status.' : 'The private status API is unavailable. Try again shortly.';
          if (localPreview) {
            field('state').textContent = 'Local preview';
            field('connection').textContent = 'Not connected here';
            refresh.hidden = true;
          }
          field('guidance').textContent = field('reason').textContent;
          const execution = executionFields(null);
          for (const id of ['state', 'entry', 'sl', 'tp', 'opened', 'closed', 'updated', 'guidance'] as const) field(`execution-${id}`).textContent = execution[id];
          field('execution-summary').textContent = 'No current report';
          renderLevels();
          signIn.hidden = !needsAccess;
        } finally {
          refresh.disabled = false;
        }
      }

      refresh.addEventListener('click', load);
      window.addEventListener('trading-chart-ready', render);
      window.setInterval(() => { if (!document.hidden) load(); }, designPreview ? 2000 : 10000);
      window.setInterval(() => { if (!document.hidden) render(); }, 1000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) { render(); load(); } });
      load();
    </script>

    <style lang="scss">
      .page { display: grid; align-content: start; justify-items: start; gap: var(--sp-2xl); min-height: 100svh; width: min(100%, var(--container-max-width)); margin-inline: auto; padding: var(--sp-3xl) var(--grid-margin); }
      .page__intro { max-width: 65ch; }
      .page__intro h1 { margin: 0 0 var(--sp-lg); font-size: var(--fs-3); line-height: 1; letter-spacing: var(--ls-3); }
      .page__intro p { margin: 0; color: var(--c-body); line-height: 1.5; }
      .page__replay-link { margin-top: var(--sp-lg); }
      .page__note { margin: 0; color: var(--c-body); font-size: var(--fs-body-sm); }
      .status { width: min(100%, var(--container-max-width)); box-shadow: none; }
      .status__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-md); }
      .status__head h2 { margin: 0; font-size: var(--fs-4); font-weight: var(--fw-regular); letter-spacing: var(--ls-4); }
      .status__state { color: var(--c-body); }
      .status__rows { margin: var(--sp-xl) 0; }
      .status__rows div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--sp-md); padding: var(--sp-md) 0; border-top: 1px solid var(--c-hairline); }
      .status__rows dt { display: flex; align-items: center; gap: var(--sp-sm); color: var(--c-body); }
      .status__rows svg { width: var(--sp-xl); height: var(--sp-xl); flex-shrink: 0; }
      .status__symbol { margin: var(--sp-md) 0 0; color: var(--c-body); }
      .status__price { display: grid; gap: var(--sp-sm); margin: var(--sp-xl) 0; }
      #price { font-size: var(--fs-4); font-variant-numeric: tabular-nums; }
      .status__activity { margin: var(--sp-xl) 0; }
      .status__activity summary, .manual-controls > summary { width: fit-content; }
      .status__activity ol { padding-left: var(--sp-xl); color: var(--c-body); line-height: 1.6; }
      .status__activity li + li { margin-top: var(--sp-sm); }
      .status__activity .page__note { margin-top: var(--sp-lg); }
      .manual-controls { width: 100%; }
      .manual-controls .status { margin-block: var(--sp-xl); }
      .status__guidance { max-width: 65ch; line-height: 1.6; color: var(--c-body); margin: 0 0 var(--sp-xl); }
      .status__details { margin-bottom: var(--sp-xl); }
      .status__details summary { width: fit-content; list-style: none; }
      .status__details summary::-webkit-details-marker { display: none; }
      .status__details[open] summary span { transform: rotate(180deg); }
      .status__rows dd { margin: 0; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
      .status__checks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-xl); }
      .status__checks div { grid-template-columns: 1fr; gap: var(--sp-sm); }
      .status__checks dd { font-size: var(--fs-6); }
      .status__reason { min-height: 1.5em; margin: 0 0 var(--sp-xl); color: var(--c-body); }
      .status__actions { display: flex; flex-wrap: wrap; gap: var(--sp-md); }
      .status__actions [hidden] { display: none; }
      .trade__form { display: grid; gap: var(--sp-lg); margin-bottom: var(--sp-lg); }
      .trade__steps { display: flex; flex-wrap: wrap; gap: var(--sp-xl); padding: 0; margin: var(--sp-xl) 0 var(--sp-2xl); list-style: none; }
      .trade__steps li { display: flex; align-items: center; gap: var(--sp-sm); color: var(--c-body); font-size: var(--fs-body-sm); }
      .trade__steps span { display: grid; place-items: center; width: var(--sp-2xl); height: var(--sp-2xl); border: 1px solid var(--c-hairline-bright); border-radius: var(--r-pill); color: var(--c-ink); }
      .trade__workspace { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--sp-3xl); }
      .trade__setup { min-width: 0; }
      .trade__fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-lg); }
      .trade__field { display: grid; gap: var(--sp-sm); min-width: 0; }
      .trade__field input, .trade__field select { width: 100%; min-height: var(--sp-3xl); padding: var(--sp-sm) var(--sp-lg); border: 1px solid var(--c-hairline-bright); border-radius: var(--r-pill); background: var(--c-canvas); color: var(--c-ink); font: inherit; font-variant-numeric: tabular-nums; }
      .trade__field input::placeholder { color: var(--c-body); }
      .trade__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-md); }
      .trade__preview { max-width: 65ch; margin-top: var(--sp-xl); padding-top: var(--sp-xl); border-top: 1px solid var(--c-hairline); }
      .trade__preview h3 { margin: 0 0 var(--sp-md); font-size: var(--fs-5); font-weight: var(--fw-regular); }
      .trade__preview p { color: var(--c-body); line-height: 1.5; }
      .trade__preview[hidden], .trade__actions [hidden] { display: none; }
      #control-message { min-height: 1.5em; color: var(--c-body); }
      #control-message:empty { display: none; }
      .trade__chart { margin: 0; min-width: 0; padding-left: var(--sp-2xl); border-left: 1px solid var(--c-hairline); }
      .trade__chart h3, .trade__result h3 { margin: 0 0 var(--sp-md); font-size: var(--fs-5); font-weight: var(--fw-regular); }
      .trade__chart .micro { color: var(--c-body); }
      .trade__chart svg { display: block; width: 100%; margin: var(--sp-lg) 0; overflow: visible; }
      #levels-plot[hidden], .trade__empty[hidden] { display: none; }
      .trade__chart line { stroke: var(--c-body); stroke-width: 1; }
      .trade__chart .trade__axis { stroke: var(--c-hairline-bright); }
      .trade__chart circle { fill: var(--c-ink); }
      .trade__chart g:not(#level-entry) line { stroke-dasharray: 4 4; }
      .trade__chart text { fill: var(--c-body); font-size: var(--fs-5); }
      .trade__chart .trade__level-price { fill: var(--c-ink); font-family: var(--ff-mono); }
      .trade__empty { display: grid; align-content: center; min-height: calc(var(--sp-4xl) * 3); color: var(--c-body); line-height: 1.6; }
      .trade__result { margin-top: var(--sp-2xl); padding-top: var(--sp-xl); border-top: 1px solid var(--c-hairline); }
      #execution-summary { font-size: var(--fs-5); font-variant-numeric: tabular-nums; }
      .trade__result .status__details { margin-bottom: 0; }
      button:disabled { opacity: .5; cursor: not-allowed; }
      @media (max-width: 48rem) {
        .trade__workspace { grid-template-columns: 1fr; gap: var(--sp-xl); }
        .trade__chart { padding: var(--sp-xl) 0 0; border-left: 0; border-top: 1px solid var(--c-hairline); }
      }
      @media (max-width: 40rem) {
        .status__checks { grid-template-columns: 1fr; gap: 0; }
        .status__rows div { grid-template-columns: 1fr; gap: var(--sp-xs); }
        .trade__steps { gap: var(--sp-md); }
      }
    </style>
  </body>
</html>
