---
import '../styles/index.scss';

// ── Vault password (obscurity gate, client-side only) ──────────────────
// SHA-256 hex of the password. Default password is "changeme" — REPLACE IT:
//   node -e "crypto.subtle.digest('SHA-256',new TextEncoder().encode('YOUR_PW')).then(b=>console.log([...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')))"
const VAULT_HASH =
  '057ba03d6c44104863dc7361fe4578965d1887360f90a0895882e58a6248fc86';

// External tools live in their own containers (see compose.yml); the Vault just
// links out. URLs are per-environment — localhost for dev, your domains in prod.
// Rendered per-request (not prerendered) so prod URLs come from the container's
// runtime env (Dokploy → compose.yml `app.environment`) — no image rebuild needed.
export const prerender = false;
const MEMOS_URL =
  process.env.PUBLIC_MEMOS_URL ||
  import.meta.env.PUBLIC_MEMOS_URL ||
  'http://localhost:5230';
const FIREFLY_URL =
  process.env.PUBLIC_FIREFLY_URL ||
  import.meta.env.PUBLIC_FIREFLY_URL ||
  'http://localhost:8080';

// Monoline 24x24 icons, one path each, drawn at 1.5px stroke with no fill —
// the Nothing iconography rule. Kept as path data so the tile markup stays one
// loop instead of four near-identical blocks.
const tools = [
  {
    name: 'Fitness',
    href: '/vault/fitness',
    external: false,
    icon: 'M22 12h-4l-3 9L9 3l-3 9H2',
  },
  {
    name: 'Projects',
    href: '/vault/projects',
    external: false,
    icon: 'M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z',
  },
  {
    name: 'Notes',
    href: MEMOS_URL,
    external: true,
    icon: 'M4 6h16M4 12h16M4 18h10',
  },
  {
    name: 'Finance',
    href: FIREFLY_URL,
    external: true,
    icon: 'M16 7h6v6M22 7l-8.5 8.5-5-5L2 17',
  },
];
---

<!doctype html>
<html lang="en" data-vault="locked">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="noindex" />
    <title>Vault — KWG</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <!-- Decide state before paint → no flash of the wrong section. -->
    <script is:inline>
      document.documentElement.dataset.vault =
        localStorage.getItem('kwg_vault') === '1' ? 'open' : 'locked';
    </script>
  </head>

  <body data-vault-hash={VAULT_HASH}>
    <main class="vault">
      <!-- ── Login ─────────────────────────────────────────────── -->
      <section class="gate" id="gate" aria-labelledby="gate-title">
        <form class="gate__form" id="gate-form" novalidate>
          <p class="gate__eyebrow">KWG</p>
          <h1 class="gate__title" id="gate-title">Vault</h1>
          <label class="gate__label" for="gate-pw">Password</label>
          <input
            class="gate__input"
            id="gate-pw"
            name="password"
            type="password"
            autocomplete="current-password"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            aria-describedby="gate-error"
            required
          />
          <p class="gate__error" id="gate-error" role="alert"></p>
          <button class="gate__submit" type="submit">Enter</button>
        </form>
      </section>

      <!-- ── Vault ─────────────────────────────────────────────── -->
      <section class="grid-wrap" id="vault" aria-labelledby="vault-title">
        <header class="grid-wrap__head">
          <h1 class="grid-wrap__title" id="vault-title" tabindex="-1">Vault</h1>
          <button class="grid-wrap__lock" type="button" id="logout">Lock</button
          >
        </header>
        <p class="grid-wrap__caption">Your handy tools live here.</p>
        <!-- The <ul> is itself the scroll container; each tile's magnification
             rides its own view() timeline against it. See docs/vault-dock-design.md. -->
        <ul class="dock" role="list">
          {
            tools.map((t) => (
              <li class="tool">
                <a
                  class="tool__link"
                  href={t.href}
                  target={t.external ? '_blank' : undefined}
                  rel={t.external ? 'noopener noreferrer' : undefined}
                >
                  <svg
                    class="tool__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={t.icon} />
                  </svg>
                  <span class="tool__name">{t.name}</span>
                  <span class="tool__hint">
                    {t.external ? 'Open \u2197\uFE0E' : 'Open'}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <script>
      import { sha256Hex } from '../scripts/vault-hash';

      const form = document.querySelector<HTMLFormElement>('#gate-form')!;
      const pw = document.querySelector<HTMLInputElement>('#gate-pw')!;
      const err = document.querySelector<HTMLParagraphElement>('#gate-error')!;
      const title = document.querySelector<HTMLHeadingElement>('#vault-title')!;
      const logout = document.querySelector<HTMLButtonElement>('#logout')!;
      const expected = document.body.dataset.vaultHash!;

      const setState = (s: 'open' | 'locked') => {
        document.documentElement.dataset.vault = s;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if ((await sha256Hex(pw.value)) === expected) {
          localStorage.setItem('kwg_vault', '1');
          err.textContent = '';
          pw.removeAttribute('aria-invalid');
          setState('open');
          title.focus();
        } else {
          err.textContent = 'Incorrect password.';
          pw.setAttribute('aria-invalid', 'true');
          pw.value = '';
          pw.focus();
        }
      });

      logout.addEventListener('click', () => {
        localStorage.removeItem('kwg_vault');
        setState('locked');
        pw.value = '';
        pw.focus();
      });

      // Focus the field when arriving locked.
      if (document.documentElement.dataset.vault !== 'open') pw.focus();
    </script>

    <style lang="scss">
      // The Vault runs on the site's global tokens (src/styles/_vars.scss);
      // it renders its own <html> and so carries no header or footer.
      .vault {
        min-height: 100svh;
        background: var(--c-canvas);
        color: var(--c-body);
        font-family: var(--ff-primary);
      }

      // Every label on the page is the same mono instrument-panel treatment.
      @mixin label {
        font-family: var(--ff-mono);
        font-size: var(--fs-micro);
        font-weight: var(--fw-regular);
        line-height: 1.33;
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
      }

      // The wordmark is the display face at weight 400 with the brand's
      // negative tracking. The type carries it; nothing is added.
      @mixin wordmark {
        font-weight: var(--fw-regular);
        line-height: 1;
        letter-spacing: var(--ls-1);
        color: var(--c-ink);
      }

      // States: head script sets html[data-vault]; CSS reveals one section.
      #gate,
      #vault {
        display: none;
      }
      :global(html[data-vault='locked']) #gate {
        display: grid;
      }
      :global(html[data-vault='open']) #vault {
        display: grid;
      }

      // ── Login ──────────────────────────────────────────────
      .gate {
        min-height: 100svh;
        place-items: center;
        padding: to-rem(24);
      }
      .gate__form {
        display: grid;
        gap: to-rem(8);
        width: min(100%, to-rem(360));
      }
      .gate__eyebrow {
        @include label;
        margin: 0;
        color: var(--c-mute);
      }
      .gate__title {
        @include wordmark;
        margin: 0 0 to-rem(48);
        font-size: to-rem(56);
      }
      .gate__label {
        @include label;
        color: var(--c-mute);
      }
      // Underline over full border — the lighter container, per the skill's
      // "use the lightest tool that works".
      .gate__input {
        appearance: none;
        width: 100%;
        padding: to-rem(12) 0;
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--c-hairline-bright);
        color: var(--c-ink);
        font-family: var(--ff-mono);
        font-size: to-rem(16);
        transition: border-color 0.2s var(--ease-smooth);

        &:hover {
          border-bottom-color: var(--c-mute);
        }
        &:focus-visible {
          outline: none;
          border-bottom-color: var(--c-ink);
        }
        &[aria-invalid='true'] {
          border-bottom-color: var(--c-ink);
        }
      }
      .gate__error {
        @include label;
        margin: 0;
        min-height: 1lh;
        color: var(--c-ink);
      }
      // Primary button: inverted, pill.
      .gate__submit {
        @include label;
        margin-top: to-rem(24);
        min-height: to-rem(44);
        padding: to-rem(12) to-rem(24);
        background: var(--c-ink);
        color: var(--c-canvas);
        border: 1px solid var(--c-ink);
        border-radius: var(--r-pill);
        font-size: var(--fs-micro);
        cursor: pointer;
        transition:
          background-color 0.25s var(--ease-smooth),
          border-color 0.25s var(--ease-smooth);

        &:hover {
          background-color: var(--c-body);
          border-color: var(--c-body);
        }
        &:focus-visible {
          outline: 2px solid var(--c-ink);
          outline-offset: 2px;
        }
      }

      // ── Vault shell ────────────────────────────────────────
      .grid-wrap {
        max-width: var(--grid-max-width);
        min-height: 100svh;
        margin-inline: auto;
        padding: clamp-fluid(24, 56) var(--grid-margin);
        // Header and caption sit at the top; the dock takes the rest and
        // centres itself in it.
        grid-template-rows: auto auto 1fr;
      }
      .grid-wrap__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: to-rem(16);
      }
      .grid-wrap__title {
        @include wordmark;
        margin: 0;
        font-size: clamp-fluid(48, 88);

        &:focus-visible {
          outline: 2px solid var(--c-ink);
          outline-offset: 4px;
        }
      }
      // Secondary button: outlined, pill.
      .grid-wrap__lock {
        @include label;
        flex: none;
        min-height: to-rem(44);
        padding: to-rem(12) to-rem(24);
        background: transparent;
        border: 1px solid var(--c-hairline-bright);
        border-radius: var(--r-pill);
        color: var(--c-body);
        font-size: var(--fs-micro);
        cursor: pointer;
        transition:
          border-color 0.2s var(--ease-smooth),
          color 0.2s var(--ease-smooth);

        &:hover {
          border-color: var(--c-ink);
          color: var(--c-ink);
        }
        &:focus-visible {
          outline: 2px solid var(--c-ink);
          outline-offset: 2px;
        }
      }
      .grid-wrap__caption {
        @include label;
        margin: to-rem(16) 0 0;
        color: var(--c-mute);
      }

      // ── Dock ───────────────────────────────────────────────
      // Baseline: a plain vertical list, readable everywhere. The bounded
      // scroller and its magnification are layered on in @supports below.
      .dock {
        // Interpolated: Sass passes custom-property values through verbatim, so
        // a bare to-rem() here would reach the browser unevaluated and invalid.
        // Dock shows ~2 tiles at a time. Tiles must overflow the scroller by a
        // wide margin, or several sit at peak magnification at once and there
        // is no focal point.
        --dock-h: min(48svh, #{to-rem(340)});
        --tile-h: #{to-rem(152)};

        display: grid;
        align-self: center;
        gap: to-rem(12);
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .tool {
        width: min(100%, to-rem(460));
        margin-inline: auto;
      }
      // Asymmetric by intent: icon top-left, name bottom-left, action
      // bottom-right. Centred tiles read as generic.
      .tool__link {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-rows: auto 1fr auto;
        height: var(--tile-h);
        padding: to-rem(20);
        border: 1px solid var(--c-hairline);
        border-radius: to-rem(8);
        color: var(--c-mute);
        text-decoration: none;
        transition:
          border-color 0.2s var(--ease-smooth),
          color 0.2s var(--ease-smooth);

        &:hover {
          border-color: var(--c-hairline-bright);
          color: var(--c-body);
        }
        &:focus-visible {
          outline: 2px solid var(--c-ink);
          outline-offset: 2px;
        }
      }
      .tool__icon {
        grid-column: 1 / -1;
        grid-row: 1;
        width: to-rem(24);
        height: to-rem(24);
      }
      .tool__name {
        grid-column: 1;
        grid-row: 3;
        align-self: end;
        font-size: to-rem(24);
        font-weight: var(--fw-regular);
        line-height: 1.2;
        letter-spacing: -0.01em;
      }
      .tool__hint {
        @include label;
        grid-column: 2;
        grid-row: 3;
        align-self: end;
        opacity: 0.6;
      }

      // Tiles recede either side of the scroller's centre and come up full at
      // it. view()'s default `cover` range puts the tile dead centre at 50%,
      // so no explicit animation-range is needed.
      @keyframes magnify {
        0%,
        100% {
          scale: 0.82;
          opacity: 0.35;
          border-color: var(--c-hairline);
          background-color: transparent;
          color: var(--c-mute);
        }
        50% {
          scale: 1;
          opacity: 1;
          border-color: var(--c-ink);
          background-color: var(--c-canvas-card);
          color: var(--c-ink);
        }
      }

      @supports (animation-timeline: view()) {
        .dock {
          height: var(--dock-h);
          overflow-y: auto;
          overscroll-behavior: contain;
          scroll-snap-type: y mandatory;
          scrollbar-width: none;
          // Lets the first and last tile reach the focal point without spacers.
          padding-block: calc((var(--dock-h) - var(--tile-h)) / 2);
          // Without this the scroller's edges slice receding tiles mid-text.
          mask-image: linear-gradient(
            to bottom,
            transparent,
            #000 24%,
            #000 76%,
            transparent
          );
        }
        .dock::-webkit-scrollbar {
          display: none;
        }
        .tool {
          scroll-snap-align: center;
        }
        .tool__link {
          animation: magnify linear both;
          animation-timeline: view(block);
        }

        @media (prefers-reduced-motion: reduce) {
          .dock {
            height: auto;
            overflow: visible;
            scroll-snap-type: none;
            padding-block: 0;
            mask-image: none;
          }
          .tool__link {
            animation: none;
          }
        }
      }
    </style>
  </body>
</html>
