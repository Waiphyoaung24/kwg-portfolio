---
import Layout from '@layouts/Layout.astro';
import { entries } from '../../catalog/entries';

const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout>
  <main>
    <div class="container">
      <header class="hero">
        <p class="label">Index · {pad(entries.length)} entries</p>
        <h1>Catalog</h1>
        <p class="lede">
          Components, page sections and whole pages, running live, with their
          source ready to copy.
        </p>
      </header>

      <ol class="rows">
        {
          entries.map((entry, i) => (
            <li>
              <a href={`/catalog/${entry.slug}`}>
                <span class="idx label">{pad(i + 1)}</span>
                <span class="title">{entry.title}</span>
                <span class="kind label">{entry.kind}</span>
                <span class="stack label">{entry.stack}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</Layout>

<style lang="scss">
  main {
    padding-block: var(--sp-4xl) var(--sp-band);
  }

  .hero {
    display: grid;
    gap: var(--sp-lg);
    max-width: 60ch;
    margin-bottom: var(--sp-band);
  }

  .hero .label {
    color: var(--c-mute);
  }

  h1 {
    font-size: var(--fs-2);
  }

  .lede {
    max-width: 46ch;
    color: var(--c-body);
    font-size: var(--fs-body-lg);
    line-height: 1.56;
  }

  // Divider rows, not cards: the list is the structure.
  .rows {
    list-style: none;
    border-top: 1px solid var(--c-hairline);
  }

  li {
    border-bottom: 1px solid var(--c-hairline);
  }

  a {
    display: grid;
    grid-template-columns: 4ch 1fr;
    gap: var(--sp-sm) var(--sp-xl);
    align-items: baseline;
    padding-block: var(--sp-xl);
    text-decoration: none;

    @media (min-width: 768px) {
      grid-template-columns: 4ch 1fr 12ch 1fr;
    }

    @include has-hover {
      &:hover .title {
        color: var(--c-ink);
      }

      &:hover .label {
        color: var(--c-body);
      }
    }
  }

  .title {
    font-size: var(--fs-6);
    line-height: 1.44;
    color: var(--c-body);
    transition: color 0.25s var(--ease-smooth);
  }

  .label {
    color: var(--c-mute);
    transition: color 0.25s var(--ease-smooth);
  }

  .kind,
  .stack {
    grid-column: 2;

    @media (min-width: 768px) {
      grid-column: auto;
    }
  }
</style>
