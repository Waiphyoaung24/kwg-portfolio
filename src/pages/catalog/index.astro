---
import '../../catalog/nothing.scss';

import Layout from '@layouts/Layout.astro';
import { entries } from '../../catalog/entries';

const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout>
  <main class="nothing">
    <div class="container">
      <header class="hero">
        <p class="n-label">Index · {pad(entries.length)} entries</p>
        <h1>Catalog</h1>
        <p class="lede">
          Components, page sections and whole pages, running live, with their
          source ready to copy.
        </p>
      </header>

      <ol class="rows">
        {
          entries.map((entry, i) => (
            <li>
              <a href={`/catalog/${entry.slug}`}>
                <span class="idx n-label">{pad(i + 1)}</span>
                <span class="title">{entry.title}</span>
                <span class="kind n-label">{entry.kind}</span>
                <span class="stack n-label">{entry.stack}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</Layout>

<style lang="scss">
  main {
    padding-block: to-rem(64) to-rem(96);
  }

  // Primary layer: the one Doto moment.
  .hero {
    display: grid;
    gap: to-rem(16);
    max-width: 60ch;
    margin-bottom: to-rem(96);
  }

  h1 {
    font-family: var(--n-ff-dot);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--n-text-display);
  }

  .lede {
    color: var(--n-text-secondary);
    max-width: 44ch;
  }

  // Secondary layer: divider rows, no cards.
  .rows {
    list-style: none;
    border-top: 1px solid var(--n-border);
  }

  li {
    border-bottom: 1px solid var(--n-border);
  }

  a {
    display: grid;
    grid-template-columns: 4ch 1fr;
    gap: to-rem(8) to-rem(24);
    align-items: baseline;
    padding-block: to-rem(20);
    text-decoration: none;
    transition: color 150ms var(--n-ease);

    @media (min-width: 768px) {
      grid-template-columns: 4ch 1fr 12ch 1fr;
    }

    @include has-hover {
      &:hover .title {
        color: var(--n-text-display);
      }
      &:hover .n-label {
        color: var(--n-text-primary);
      }
    }
  }

  .title {
    font-size: var(--fs-6);
    line-height: 1.3;
    color: var(--n-text-primary);
    transition: color 150ms var(--n-ease);
  }

  .n-label {
    transition: color 150ms var(--n-ease);
  }

  .kind,
  .stack {
    grid-column: 2;

    @media (min-width: 768px) {
      grid-column: auto;
    }
  }
</style>
