DATABASE_URL=postgres://user:pass@localhost:5432/kwg

# Vault Finance sign-in (set in Dokploy → Environment for prod). Generate with:
#   node scripts/finance-password-hash.mjs
# FINANCE_PASSWORD_HASH=scrypt:32768:8:1:...
# FINANCE_TZ=Asia/Bangkok               # what "today" means for new entries

# Vault tool links — set to your prod domains in Dokploy (read at request time)
# PUBLIC_MEMOS_URL=http://localhost:5230
# PUBLIC_OPENGYM_URL=http://localhost:8091
# PUBLIC_FIGCRAFT_URL=http://localhost:8092
# OPENGYM_RP_ID=localhost              # hostname only; must match PUBLIC_OPENGYM_URL
# Production: PUBLIC_OPENGYM_URL=https://fitness.waiphyoaung.com
#             OPENGYM_RP_ID=fitness.waiphyoaung.com
#             PUBLIC_FIGCRAFT_URL=https://figcraft.waiphyoaung.com

# Optional (have defaults in compose.yml)
# POSTGRES_PASSWORD=kwg
# TZ=UTC
# BIND_HOST=127.0.0.1                   # set 172.17.0.1 in prod (tunnel-only access)
