DATABASE_URL=postgres://user:pass@localhost:5432/kwg

# Required by compose.yml (set these in Dokploy → Environment for prod)
APP_KEY=CHANGEME_32_CHARS               # Firefly III encryption key, exactly 32 chars
STATIC_CRON_TOKEN=CHANGEME_32_CHARS     # Firefly III cron token, exactly 32 chars
FIREFLY_DB_PASSWORD=CHANGEME            # Firefly III Postgres password

# Optional (have defaults in compose.yml)
# POSTGRES_PASSWORD=kwg
# FIREFLY_APP_URL=http://localhost:8080
# TZ=UTC
# BIND_HOST=127.0.0.1                   # set 172.17.0.1 in prod (tunnel-only access)
